local function spinner(parent, size, slot)
	local img = icon(parent, "loader-circle", size or 16, slot or "Text", { Name = "Spinner", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Visible = false, ZIndex = 9 })
	local job
	local s = {}
	function s.Set(on)
		img.Visible = on
		if on and not job then
			job = Ticker.Add(function(dt)
				if not img.Visible or not img.Parent then
					job = nil
					return true
				end
				img.Rotation = (img.Rotation + dt * 360) % 360
			end)
		end
	end
	s.Image = img
	return s
end

function Section:Button(opts, callback)
	if type(opts) == "string" then
		opts = { Name = opts, Callback = callback }
	end
	opts = opts or {}
	local e = newElement(self, "Button", opts)
	local style = opts.Style or (opts.Primary and "Primary") or (opts.Danger and "Danger") or "Default"
	e.Style = style
	local frame = e.Frame
	local iconName = opts.Icon or (style == "Default" and "chevron-right") or nil
	local iconHolder = create("Frame", { Name = "IconHolder", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0, e.TopHeight / 2), Size = UDim2.fromOffset(18, 18), ZIndex = 6, Parent = frame })
	local img = icon(iconHolder, iconName, 16, "SubText", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 6 })
	if not iconName then
		img.Visible = false
	end
	local spin = spinner(iconHolder, 16)
	local progress = create("Frame", { Name = "Progress", BackgroundColor3 = "AccentA", BackgroundTransparency = 0.75, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), ZIndex = 1, Parent = frame })
	gradient(progress)
	e.Title.Size = UDim2.new(1, -54, 0, 18)
	if e.Desc then
		e.Desc.Size = UDim2.new(1, -54, 0, 15)
	end
	local function applyStyle()
		if e.StyleGradient then
			e.StyleGradient.Enabled = style == "Primary"
		end
		if style ~= "Primary" then
			bind(frame, "BackgroundColor3", style == "Danger" and "Error" or "Element")
			bind(e.Title, "TextColor3", "Text")
			bind(img, "ImageColor3", "SubText")
			bind(e.Stroke, "Color", "Stroke")
			e.Stroke.Transparency = 0.95
			frame.BackgroundTransparency = 0.45
			if e.Desc then
				bind(e.Desc, "TextColor3", "SubText")
				e.Desc.TextTransparency = 0
			end
		end
		if style == "Primary" then
			if not e.StyleGradient then
				e.StyleGradient = gradient(frame)
			else
				unbind(frame, "BackgroundColor3")
				frame.BackgroundColor3 = Color3.new(1, 1, 1)
				e.StyleGradient.Enabled = true
			end
			frame.BackgroundTransparency = 0
			bind(e.Title, "TextColor3", "OnAccent")
			bind(img, "ImageColor3", "OnAccent")
			if e.Desc then
				bind(e.Desc, "TextColor3", "OnAccent")
				e.Desc.TextTransparency = 0.2
			end
			e.Stroke.Transparency = 1
			progress.BackgroundColor3 = Color3.new(1, 1, 1)
		elseif style == "Danger" then
			bind(frame, "BackgroundColor3", "Error")
			frame.BackgroundTransparency = 0.82
			bind(e.Title, "TextColor3", "Error")
			bind(img, "ImageColor3", "Error")
			bind(e.Stroke, "Color", "Error")
			e.Stroke.Transparency = 0.7
		elseif style == "Outline" then
			frame.BackgroundTransparency = 1
			bind(e.Stroke, "Color", "AccentA")
			e.Stroke.Transparency = 0.45
			bind(img, "ImageColor3", "AccentA")
		elseif style == "Ghost" then
			frame.BackgroundTransparency = 1
			e.Stroke.Transparency = 1
		end
	end
	applyStyle()
	function e:SetHover(on)
		if self.Locked then
			return
		end
		if style == "Primary" then
			tween(frame, { BackgroundTransparency = on and 0.1 or 0 }, 0.15)
		elseif style == "Danger" then
			tween(frame, { BackgroundTransparency = on and 0.7 or 0.82 }, 0.15)
		elseif style == "Outline" or style == "Ghost" then
			tween(frame, { BackgroundTransparency = on and 0.6 or 1, BackgroundColor3 = Theme.ElementHover }, 0.15)
		else
			Element.SetHover(self, on)
		end
		if style == "Default" and iconName == "chevron-right" then
			tween(img, { Position = UDim2.new(0.5, on and 3 or 0, 0.5, 0), ImageColor3 = on and Theme.Text or Theme.SubText }, 0.2)
		end
	end
	local scaler = create("UIScale", { Parent = frame })
	local hit = hitbox(frame, 5)
	attachContext(hit, function()
		return e:ContextItems()
	end)
	e.Hit = hit
	e.NoReset, e.NoCopy = true, true

	local busy, armed, cooldownUntil = false, false, 0
	function e:SetLoading(on, label)
		busy = on == true
		spin.Set(busy)
		img.Visible = not busy and iconName ~= nil
		if label then
			self.Title.Text = busy and tostring(label) or self.Name
		elseif not busy then
			self.Title.Text = self.Name
		end
	end
	local function run()
		if busy or e.Locked then
			return
		end
		if opts.Cooldown and os.clock() < cooldownUntil then
			shake(iconHolder)
			return
		end
		if opts.Confirm and not armed then
			armed = true
			sfx("Warning", 1.2, 0.6)
			e.Title.Text = type(opts.Confirm) == "string" and opts.Confirm or "Click again to confirm"
			bind(e.Title, "TextColor3", "Warning")
			progress.BackgroundTransparency = 0.8
			progress.Size = UDim2.fromScale(1, 1)
			tween(progress, { Size = UDim2.fromScale(0, 1) }, 3, Enum.EasingStyle.Linear)
			task.delay(3, function()
				if armed then
					armed = false
					e.Title.Text = e.Name
					applyStyle()
					if style ~= "Primary" and style ~= "Danger" then
						bind(e.Title, "TextColor3", "Text")
					end
				end
			end)
			return
		end
		if armed then
			armed = false
			e.Title.Text = e.Name
			if style ~= "Primary" and style ~= "Danger" then
				bind(e.Title, "TextColor3", "Text")
			end
			applyStyle()
			progress.Size = UDim2.fromScale(0, 1)
		end
		sfx(style == "Danger" and "Delete" or "Click")
		if iconName == "chevron-right" then
			tween(img, { Position = UDim2.new(0.5, 6, 0.5, 0) }, 0.1)
			task.delay(0.1, function()
				tween(img, { Position = UDim2.new(0.5, 0, 0.5, 0) }, 0.3, Enum.EasingStyle.Back)
			end)
		end
		if opts.Cooldown then
			cooldownUntil = os.clock() + opts.Cooldown
			progress.BackgroundTransparency = 0.8
			progress.Size = UDim2.fromScale(1, 1)
			tween(progress, { Size = UDim2.fromScale(0, 1) }, opts.Cooldown, Enum.EasingStyle.Linear)
		end
		task.spawn(function()
			if opts.Loading or opts.Async then
				e:SetLoading(true)
			end
			safeCall(e.Callback)
			for _, fn in ipairs(e.Listeners) do
				safeCall(fn)
			end
			if opts.Loading or opts.Async then
				e:SetLoading(false)
			end
		end)
	end
	e.Press = run
	hit.InputBegan:Connect(function(input)
		if not isPress(input) or e.Locked then
			return
		end
		tween(scaler, { Scale = 0.975 }, 0.08)
		ripple(frame, input, style == "Primary" and Color3.new(1, 1, 1) or nil)
		if opts.Hold then
			-- Hold to run: the bar fills while you hold.
			local holdTime = tonumber(opts.Hold) or 1
			local start = os.clock()
			local done = false
			progress.BackgroundTransparency = style == "Primary" and 0.7 or 0.6
			progress.Size = UDim2.fromScale(0, 1)
			tween(progress, { Size = UDim2.fromScale(1, 1) }, holdTime, Enum.EasingStyle.Linear)
			local job
			job = Ticker.Add(function()
				if done then
					return true
				end
				if os.clock() - start >= holdTime then
					done = true
					progress.Size = UDim2.fromScale(0, 1)
					run()
					return true
				end
			end)
			local conn
			conn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					conn:Disconnect()
					if not done then
						done = true
						Ticker.Remove(job)
						tween(progress, { Size = UDim2.fromScale(0, 1) }, 0.25)
					end
				end
			end)
		end
	end)
	hit.InputEnded:Connect(function(input)
		if isPress(input) then
			tween(scaler, { Scale = 1 }, 0.35, Enum.EasingStyle.Back)
		end
	end)
	hit.Activated:Connect(function()
		if opts.Hold or recentLongPress() then
			return
		end
		run()
	end)
	function e:Fire()
		run()
	end
	function e:SetText(t)
		self:SetTitle(t)
	end
	function e:SetStyle(newStyle)
		style = newStyle
		self.Style = newStyle
		applyStyle()
	end
	register(e, opts)
	return e
end
Section.AddButton = function(self, a, b)
	if type(a) == "table" then
		return self:Button(a)
	end
	return self:Button({ Name = a, Callback = b })
end

-- Several small buttons side by side.
function Section:Buttons(list1)
	list1 = list1 or {}
	self.Count += 1
	local row = create("Frame", {
		Name = "ButtonRow",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, self.Window.Mobile and 40 or 34),
		LayoutOrder = self.Count,
		Parent = self.ElementParent or self.Frame,
	})
	local layout = list(row, 6, Enum.FillDirection.Horizontal)
	layout.HorizontalFlex = Enum.UIFlexAlignment.Fill
	local out = {}
	for i, b in ipairs(list1) do
		local style = b.Style or (i == 1 and #list1 > 1 and "Primary") or "Default"
		local button = create("TextButton", {
			Name = "Button",
			AutoButtonColor = false,
			Text = "",
			BackgroundColor3 = "Element",
			BackgroundTransparency = 0.35,
			Size = UDim2.new(1 / #list1, -6, 1, 0),
			LayoutOrder = i,
			ClipsDescendants = true,
			Parent = row,
		})
		corner(10, button)
		local s = stroke(button, 0.93)
		local inner = create("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(0, 18), AutomaticSize = Enum.AutomaticSize.X, Parent = button })
		list(inner, 6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		local textSlot = style == "Primary" and "OnAccent" or (style == "Danger" and "Error") or "Text"
		local img
		if b.Icon then
			img = icon(inner, b.Icon, 15, textSlot, { LayoutOrder = 1 })
		end
		local label = text({ Parent = inner, Text = tostring(b.Name or b.Title or "Button"), Font = "SemiBold", Size = 13, Color = textSlot, Auto = Enum.AutomaticSize.X, Sz = UDim2.fromOffset(0, 18), Order = 2 })
		if style == "Primary" then
			gradient(button)
			button.BackgroundTransparency = 0
			s.Transparency = 1
		elseif style == "Danger" then
			bind(button, "BackgroundColor3", "Error")
			button.BackgroundTransparency = 0.82
		end
		local scaler = create("UIScale", { Parent = button })
		local base = button.BackgroundTransparency
		button.MouseEnter:Connect(function()
			tween(button, { BackgroundTransparency = math.max(0, base - 0.15) }, 0.15)
			sfx("Hover")
		end)
		button.MouseLeave:Connect(function()
			tween(button, { BackgroundTransparency = base }, 0.15)
		end)
		button.InputBegan:Connect(function(input)
			if isPress(input) then
				tween(scaler, { Scale = 0.95 }, 0.08)
				ripple(button, input, style == "Primary" and Color3.new(1, 1, 1) or nil)
			end
		end)
		button.InputEnded:Connect(function(input)
			if isPress(input) then
				tween(scaler, { Scale = 1 }, 0.35, Enum.EasingStyle.Back)
			end
		end)
		button.Activated:Connect(function()
			sfx(style == "Danger" and "Delete" or "Click")
			task.spawn(safeCall, b.Callback)
		end)
		out[i] = { Button = button, Label = label, Icon = img }
	end
	return out
end
