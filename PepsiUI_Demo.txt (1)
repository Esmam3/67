-- Ripple from where you pressed.
local function ripple(holder, input, color)
	if not Settings.Animations then
		return
	end
	local size = math.max(holder.AbsoluteSize.X, holder.AbsoluteSize.Y) * 1.7
	local x, y = holder.AbsoluteSize.X / 2, holder.AbsoluteSize.Y / 2
	if input and input.Position then
		x = input.Position.X - holder.AbsolutePosition.X
		y = input.Position.Y - holder.AbsolutePosition.Y
	end
	local ratio = 1
	local scaled = holder.AbsoluteSize.X
	local base = holder.Size.X.Offset
	if holder.Size.X.Scale == 0 and base > 0 and scaled > 0 then
		ratio = scaled / base
	end
	local circle = create("Frame", {
		Name = "Ripple",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x / ratio, y / ratio),
		Size = UDim2.fromOffset(0, 0),
		BackgroundColor3 = color or Color3.new(1, 1, 1),
		BackgroundTransparency = 0.84,
		ZIndex = 9,
		Parent = holder,
	})
	corner(UDim.new(1, 0), circle)
	tween(circle, { Size = UDim2.fromOffset(size / ratio, size / ratio), BackgroundTransparency = 1 }, 0.6, Enum.EasingStyle.Quad)
	task.delay(0.65, function()
		circle:Destroy()
	end)
end

-- A soft round glow made of stacked circles (no image assets needed). `strength` is how
-- strong the centre gets once every ring is stacked; more rings means a smoother fade.
local function glowBlob(parent, size, slot, strength, rings)
	rings = math.max(4, rings or 10)
	local total = math.clamp((strength or 0.035) * rings * 0.6, 0.01, 0.6)
	local each = 1 - (1 - total) ^ (1 / rings)
	local holder = create("Frame", {
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size),
		Parent = parent,
	})
	for i = 1, rings do
		local s = (i / rings) ^ 0.85
		local ring = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(s, s),
			BackgroundColor3 = slot or "AccentA",
			BackgroundTransparency = 1 - each,
			BorderSizePixel = 0,
			Parent = holder,
		})
		corner(UDim.new(1, 0), ring)
	end
	return holder, 1 - each
end

-- Shake something sideways (wrong input, locked element).
local function shake(object)
	if not Settings.Animations then
		return
	end
	local base = object.Position
	task.spawn(function()
		for _, dx in ipairs({ 6, -5, 4, -3, 2, 0 }) do
			if not object.Parent then
				return
			end
			object.Position = UDim2.new(base.X.Scale, base.X.Offset + dx, base.Y.Scale, base.Y.Offset)
			task.wait(0.035)
		end
		object.Position = base
	end)
end

-- Text width (approximate is fine for layout decisions).
local measureFont
pcall(function()
	measureFont = Enum.Font.BuilderSansMedium
