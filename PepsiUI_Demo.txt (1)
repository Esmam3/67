		return
	end
	s.Color = Theme.AccentA
	s.Transparency = 0.1
	s.Thickness = 1.5
	tween(s, { Transparency = 0.93 }, 1.4, Enum.EasingStyle.Quad)
	task.delay(1.4, function()
		s.Thickness = 1
		s.Color = Theme.Stroke
	end)
end

-- A group inside a section: indent, own title, or show it only when something is on.
function Section:Group(opts)
	opts = type(opts) == "string" and { Name = opts } or (opts or {})
	self.Count += 1
	local frame = create("Frame", {
		Name = "Group",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = self.Count,
		ClipsDescendants = true,
		Parent = self.ElementParent or self.Frame,
	})
	local inner = create("Frame", { Name = "Inner", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = frame })
	local layout = list(inner, 6)
	if opts.Indent ~= false and (opts.DependsOn or opts.Indent) then
		padding(inner, 0, 0, 0, 12)
		local line = create("Frame", { Name = "Line", BackgroundColor3 = "AccentA", BackgroundTransparency = 0.6, BorderSizePixel = 0, Position = UDim2.fromOffset(3, 4), Size = UDim2.new(0, 2, 1, -8), Parent = frame })
		corner(UDim.new(1, 0), line)
		gradient(line, 90)
	end
	if opts.Name then
		text({ Parent = inner, Text = tostring(opts.Name), Font = "SemiBold", Size = 12, Color = "SubText", Height = 16, Order = 0 })
	end
	local group = newContainer(self.Window, self.Page, inner, self, self.Root)
	group.Kind = "Group"
	group.Shell = frame
	group.Body = frame
	group.BodyLayout = layout
	group.Name = opts.Name and tostring(opts.Name) or ""
	group.Collapsed = false
	group.Height = 0
	if opts.DependsOn then
		group.Dependent = true
		local target, want = opts.DependsOn, opts.Value
		if want == nil then
			want = true
		end
		local function check()
			local v = target.Value
			local ok
			if type(want) == "function" then
				ok = want(v)
			elseif type(v) == "table" then
				ok = table.find(v, want) ~= nil
			else
				ok = v == want
			end
			group:Expand(ok == true)
		end
		target:OnChanged(check)
		local v = target.Value
		local start
		if type(want) == "function" then
			start = want(v)
		elseif type(v) == "table" then
			start = table.find(v, want) ~= nil
		else
			start = v == want
		end
		group:Expand(start == true, true)
	end
	return group
end
Section.DependencyBox = Section.Group
