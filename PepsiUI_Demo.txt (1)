local function modeItems(kb, after)
	local items = {}
	for _, mode in ipairs({ "Toggle", "Hold", "Always" }) do
		table.insert(items, {
			Name = "Mode: " .. mode,
			Icon = kb.Mode == mode and "circle-check" or "circle",
			Callback = function()
				kb.Mode = mode
				if mode == "Always" then
					kb.Fire(true)
				end
				safeCall(after)
			end,
		})
	end
	table.insert(items, { Name = "Clear key", Icon = "x", Callback = function()
		kb.SetKey(nil)
	end })
	return items
end

-- Phone version: instead of a key, an on-screen button you can place anywhere.
local function mobileKeyButton(window, kb, label, name)
	label.Text = "Button"
	local handle
	local owner = kb.Owner
	local linked = owner and owner.Type == "Toggle"
	local function toggleButton()
		if handle then
			handle.Destroy()
			handle = nil
			label.Text = "Button"
			return
		end
		handle = window:AddMobileButton({
			Name = name,
			Key = "kb_" .. name,
			Icon = linked and "toggle-right" or "zap",
			Toggle = kb.Mode ~= "Hold",
			Default = linked and owner.Value or kb.State,
			Callback = function(state)
				if linked then
					owner:Set(state)
				else
					kb.Fire(state)
				end
			end,
			OnRemove = function()
				handle = nil
				label.Text = "Button"
			end,
		})
		label.Text = "On screen"
	end
	if linked then
		owner:OnChanged(function(value)
			if handle then
				handle.Set(value, true)
			end
		end)
	end
	return toggleButton
end

-- Inline keybind used by Toggle:AddKeybind.
function Library._inlineKeybind(owner, parent, opts)
	local pill, label = keyPill(parent, 5)
	local kb = keybindCore(owner, pill, label, opts)
	kb.Width = owner.Window.Mobile and 60 or 34
	kb.DisplayName = opts.Name or owner.Name
	if owner.Window.Mobile then
		local toggleButton = mobileKeyButton(owner.Window, kb, label, kb.DisplayName)
		pill.Activated:Connect(function()
			sfx("Click")
			toggleButton()
		end)
	else
		pill.Activated:Connect(kb.Listen)
		kb.Show()
	end
	pill.MouseButton2Click:Connect(function()
		Library:ContextMenu(modeItems(kb))
	end)
	table.insert(Library.Keybinds, kb)
	if opts.Flag then
		local proxy = {
			Type = "Keybind",
			Flag = opts.Flag,
			Value = kb.Value,
			Set = function(self, key)
				kb.SetKey(key)
				self.Value = kb.Value
			end,
			OnChanged = function(self, fn)
				table.insert(kb.Listeners, fn)
			end,
		}
		kb.Proxy = proxy
		Library.Options[opts.Flag] = proxy
		local oldSet = kb.SetKey
		kb.SetKey = function(key, silent)
			oldSet(key, silent)
			proxy.Value = kb.Value
			Library.Flags[opts.Flag] = kb.Value
		end
	end
	function kb:OnChanged(fn)
		table.insert(kb.Listeners, fn)
	end
	function kb:GetState()
		return kb.State
	end
	return kb
end

function Section:Keybind(opts)
	opts = opts or {}
	local e = newElement(self, "Keybind", opts)
	local right = rightGroup(e)
	local pill, label = keyPill(right, 10)
	reserve(e, 60)
	local kb = keybindCore(e, pill, label, opts)
	kb.DisplayName = e.Name
	kb.HideFromList = opts.NoUI
	e.Core = kb
	e.Value = kb.Value
	e.Mode = kb.Mode
	local modeChip = text({ Parent = right, Text = kb.Mode:sub(1, 1), Font = "Bold", Size = 10, Color = "Dim", XAlign = Enum.TextXAlignment.Center, Sz = UDim2.fromOffset(14, 14), Order = 5 })
	reserve(e, 14)
	local function syncMode()
		e.Mode = kb.Mode
		modeChip.Text = kb.Mode:sub(1, 1)
	end
	local origSet = kb.SetKey
	kb.SetKey = function(key, silent)
		origSet(key, silent)
		e.Value = kb.Value
		if e.Flag then
			Library.Flags[e.Flag] = kb.Value
		end
		Library.FlagChanged:Fire(e.Flag, kb.Value, e)
	end
	table.insert(kb.Listeners, function(state)
		e.State = state
		for _, fn in ipairs(e.Listeners) do
			safeCall(fn, state)
		end
	end)
	if self.Window.Mobile then
		local toggleButton = mobileKeyButton(self.Window, kb, label, e.Name)
		pill.Activated:Connect(function()
			sfx("Click")
			toggleButton()
		end)
	else
		pill.Activated:Connect(function()
			if e.Locked then
				return
			end
			kb.Listen()
		end)
		kb.Show()
	end
	e.ExtraContext = modeItems(kb, syncMode)
	function e:Set(key, silent)
		kb.SetKey(key, silent)
	end
	function e:SetMode(mode)
		kb.Mode = mode
		syncMode()
	end
	function e:GetState()
		return kb.State
	end
	function e:Press()
		kb.Fire(not kb.State)
	end
	e.State = false
	table.insert(Library.Keybinds, kb)
	register(e, opts)
	if kb.Mode == "Always" then
		task.defer(kb.Fire, true)
	end
	return e
end
