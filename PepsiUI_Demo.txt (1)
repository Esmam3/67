	-- Hex + RGB inputs and quick buttons.
	local inputs = create("Frame", { Name = "Inputs", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 26), ZIndex = 8, Parent = panel })
	list(inputs, 5, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local rgbRow = create("Frame", { Name = "RGB", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, y + 31), Size = UDim2.new(1, 0, 0, 26), ZIndex = 8, Parent = panel })
	list(rgbRow, 5, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local function inputBox(size, placeholder, order, parent)
		local b = create("TextBox", {
			Size = size,
			BackgroundColor3 = "Field",
			FontFace = "Mono",
			TextSize = 12,
