	end
	-- Row one: hex (fills the space) and three quick buttons. Row two: R, G and B.
	local hexBox = inputBox(UDim2.new(1, -(3 * 26 + 3 * 5), 1, 0), "#HEX", 1)
	local rBox = inputBox(UDim2.new(1 / 3, -4, 1, 0), "R", 1, rgbRow)
	local gBox = inputBox(UDim2.new(1 / 3, -4, 1, 0), "G", 2, rgbRow)
	local bBox = inputBox(UDim2.new(1 / 3, -4, 1, 0), "B", 3, rgbRow)
	local function smallButton(glyph, order, tip, fn)
		local b = create("ImageButton", { AutoButtonColor = false, BackgroundColor3 = "Field", Image = "", Size = UDim2.fromOffset(26, 26), LayoutOrder = order, ZIndex = 9, Parent = inputs })
		corner(7, b)
		stroke(b, 0.88)
		icon(b, glyph, 13, "SubText", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 10 })
		b.Activated:Connect(function()
			sfx("Click")
			fn(b)
		end)
		attachTooltip(b, tip)
		return b
	end
	local rainbowButton
	smallButton("copy", 5, "Copy colour", function()
		Library.ColorClipboard = { Color = state.Color(), Alpha = state.Alpha }
		copyText("#" .. toHex(state.Color()))
	end)
	smallButton("clipboard-paste", 6, "Paste colour", function()
		local clip = Library.ColorClipboard
		if clip then
			state.H, state.S, state.V = clip.Color:ToHSV()
			if hasAlpha and clip.Alpha then
				state.Alpha = clip.Alpha
			end
			onChange(true)
		end
	end)
	rainbowButton = smallButton("rainbow", 7, "Rainbow", function(b)
		state.Rainbow = not state.Rainbow
		tween(b, { BackgroundColor3 = state.Rainbow and Theme.AccentA or Theme.Field }, 0.2)
		onChange(true)
	end)
	y += 31 + 34
	-- Swatches: accent colours, recent picks and presets.
	local swatches = create("Frame", { Name = "Swatches", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 20), ZIndex = 8, Parent = panel })
	list(swatches, 5, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local function renderSwatches()
		for _, c in ipairs(swatches:GetChildren()) do
			if c:IsA("GuiButton") then
				c:Destroy()
			end
		end
		local colors = { Theme.AccentA, Theme.AccentB }
		for _, c in ipairs(Library.RecentColors) do
			table.insert(colors, c)
		end
		for _, c in ipairs(ColorPresets) do
			if #colors >= 10 then
				break
			end
			table.insert(colors, c)
		end
		for i, c in ipairs(colors) do
			if i > 10 then
				break
			end
			local b = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = c, Size = UDim2.fromOffset(17, 17), LayoutOrder = i, ZIndex = 9, Parent = swatches })
			corner(UDim.new(1, 0), b)
			stroke(b, 0.75)
			local sc = create("UIScale", { Parent = b })
			b.MouseEnter:Connect(function()
				tween(sc, { Scale = 1.2 }, 0.15, Enum.EasingStyle.Back)
			end)
			b.MouseLeave:Connect(function()
				tween(sc, { Scale = 1 }, 0.15)
			end)
			b.Activated:Connect(function()
				sfx("Pop", 1.2)
				state.H, state.S, state.V = c:ToHSV()
				state.Rainbow = false
				onChange(true)
			end)
		end
	end
	y += 28
	local height = y
	local function render()
		local c = state.Color()
		sv.BackgroundColor3 = Color3.fromHSV(state.H, 1, 1)
		svKnob.Position = UDim2.fromScale(state.S, 1 - state.V)
		svInner.BackgroundColor3 = c
		hueKnob.Position = UDim2.fromScale(0.5, state.H)
		if hasAlpha then
			alphaFill.BackgroundColor3 = c
			alphaKnob.Position = UDim2.fromScale(1 - state.Alpha, 0.5)
		end
		if not hexBox:IsFocused() then
			hexBox.Text = "#" .. toHex(c)
		end
		local r, g, b = math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)
		if not rBox:IsFocused() then
			rBox.Text = tostring(r)
		end
		if not gBox:IsFocused() then
			gBox.Text = tostring(g)
		end
		if not bBox:IsFocused() then
			bBox.Text = tostring(b)
		end
		rainbowButton.BackgroundColor3 = state.Rainbow and Theme.AccentA or Theme.Field
	end
	local function pressable(object, update)
		local hit = hitbox(object, 12)
		hit.InputBegan:Connect(function(input)
			if not isPress(input) then
				return
			end
			state.Rainbow = false
			local scroll = host.Page and host.Page.Scroll
			if scroll then
				scroll.ScrollingEnabled = false
			end
			update(input)
			startDrag(input, update, function()
				if scroll then
					scroll.ScrollingEnabled = true
				end
				onChange(false, true)
			end)
		end)
	end
	pressable(sv, function(input)
		state.S = math.clamp((input.Position.X - sv.AbsolutePosition.X) / math.max(1, sv.AbsoluteSize.X), 0, 1)
		state.V = 1 - math.clamp((input.Position.Y - sv.AbsolutePosition.Y) / math.max(1, sv.AbsoluteSize.Y), 0, 1)
		onChange(false)
	end)
	pressable(hue, function(input)
		state.H = math.clamp((input.Position.Y - hue.AbsolutePosition.Y) / math.max(1, hue.AbsoluteSize.Y), 0, 0.999)
		onChange(false)
	end)
	if hasAlpha then
		pressable(alphaBar, function(input)
			state.Alpha = 1 - math.clamp((input.Position.X - alphaBar.AbsolutePosition.X) / math.max(1, alphaBar.AbsoluteSize.X), 0, 1)
			onChange(false)
		end)
	end
	hexBox.FocusLost:Connect(function()
		local c = fromHex(hexBox.Text)
		if c then
			state.H, state.S, state.V = c:ToHSV()
			state.Rainbow = false
			onChange(true)
		else
			shake(hexBox)
			render()
		end
	end)
	local function rgbChanged()
		local r, g, b = tonumber(rBox.Text), tonumber(gBox.Text), tonumber(bBox.Text)
		if r and g and b then
			local c = rgb(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255))
			state.H, state.S, state.V = c:ToHSV()
			state.Rainbow = false
			onChange(true)
		else
			render()
		end
	end
	rBox.FocusLost:Connect(rgbChanged)
	gBox.FocusLost:Connect(rgbChanged)
	bBox.FocusLost:Connect(rgbChanged)
	local api = { Panel = panel, Height = height, Render = render }
	function api.SetOpen(open)
		if open then
			renderSwatches()
			panel.Visible = true
			render()
		else
			task.delay(0.3, function()
				if not api.IsOpen then
					panel.Visible = false
				end
			end)
		end
		api.IsOpen = open
	end
	return api
end

-- A picker's state: hue, saturation, value and optional alpha.
local function colorState(color, alpha)
	local h, s, v = color:ToHSV()
	local state = { H = h, S = s, V = v, Alpha = alpha, Rainbow = false }
	function state.Color()
		return Color3.fromHSV(state.H, state.S, state.V)
	end
	return state
end

local RainbowPickers = setmetatable({}, { __mode = "k" })
Ticker.Add(function(dt)
	for picker in pairs(RainbowPickers) do
		if picker.State.Rainbow and not picker.Destroyed then
			picker.State.H = (picker.State.H + dt * 0.12) % 1
			picker.State.S = math.max(picker.State.S, 0.6)
			picker.State.V = math.max(picker.State.V, 0.8)
			picker.Changed(false, false, true)
		end
	end
end)

local function swatchFrame(parent, order, slot)
