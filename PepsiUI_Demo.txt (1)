local function pushRecent(c)
	local list2 = Library.RecentColors
	for i = #list2, 1, -1 do
		if toHex(list2[i]) == toHex(c) then
			table.remove(list2, i)
		end
	end
	table.insert(list2, 1, c)
	while #list2 > 6 do
		table.remove(list2)
	end
end

-- Builds the picker panel inside a host element (the picker row itself, or a toggle).
