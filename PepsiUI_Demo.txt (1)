-- ======================================================================
-- Layout and size
-- ======================================================================
function Window:_screen()
	local size = self.Gui and self.Gui.AbsoluteSize
	if not size or size.X < 10 then
		return viewportSize()
	end
	return size
end

-- How many screen pixels one layout pixel takes right now.
function Window:Ratio()
	local abs = self.Holder.AbsoluteSize.X
	if abs > 1 and self.W > 0 then
		return abs / self.W
	end
	return math.max(0.05, self.Scale.Scale)
end

function Window:FitToScreen(instant)
	local screen = self:_screen()
	local mx = self.Maximized and 0.985 or (self.Mobile and 0.95 or 0.92)
	local my = self.Maximized and 0.97 or (self.Mobile and 0.92 or 0.88)
	local fit = math.min(screen.X * mx / self.W, screen.Y * my / self.H)
	local base = self.Mobile and fit or math.clamp(screen.Y / 1080, 1, 2)
	local target = math.clamp(math.min(base * (self.UserScale or 1), fit), 0.3, 2.5)
	self.TargetScale = target
	if self.Open then
		if instant then
			self.Scale.Scale = target
		else
			tween(self.Scale, { Scale = target }, 0.3)
		end
	end
	self:_setPos(self.PosX, self.PosY, true)
	self:_updateWatermark()
end

function Window:SetScale(multiplier)
	self.UserScale = math.clamp(tonumber(multiplier) or 1, 0.5, 1.6)
	self:FitToScreen()
end

function Window:SetSize(w, h, keepScale)
	self.W = math.clamp(math.floor(w), MIN_W, MAX_W)
	self.H = math.clamp(math.floor(h), MIN_H, MAX_H)
	self.Holder.Size = UDim2.fromOffset(self.W, self.H)
	if not keepScale then
		self:FitToScreen()
	end
	self:RelayoutColumns()
end

function Window:_clamp(x, y)
	local screen = self:_screen()
	local s = self.TargetScale or 1
	local vw, vh = self.W * s, self.H * s
	local minX, maxX = -screen.X / 2 - vw / 2 + 120, screen.X / 2 + vw / 2 - 120
	local minY, maxY = vh / 2 - screen.Y / 2, screen.Y / 2 - 50 + vh / 2
	if minY > maxY then
		minY, maxY = maxY, minY
	end
	return math.clamp(x, minX, math.max(minX, maxX)), math.clamp(y, minY, maxY)
end

function Window:_setPos(x, y, instant)
	x, y = self:_clamp(x, y)
	self.PosX, self.PosY = x, y
	if instant or not Settings.SmoothDrag or not Settings.Animations then
		self.CurX, self.CurY = x, y
		if not self.Animating then
			self.Holder.Position = UDim2.new(0.5, x, 0.5, y)
		end
		return
	end
	if not self.PosJob then
		self.PosJob = Ticker.Add(function(dt)
			self.CurX = approach(self.CurX, self.PosX, dt, 26)
			self.CurY = approach(self.CurY, self.PosY, dt, 26)
			if math.abs(self.CurX - self.PosX) < 0.3 and math.abs(self.CurY - self.PosY) < 0.3 then
				self.CurX, self.CurY = self.PosX, self.PosY
			end
			if not self.Animating then
				self.Holder.Position = UDim2.new(0.5, self.CurX, 0.5, self.CurY)
			end
			if self.CurX == self.PosX and self.CurY == self.PosY then
				self.PosJob = nil
				return true
			end
		end)
	end
end

function Window:_lift(on)
	tween(self.Scale, { Scale = self.TargetScale * (on and 1.012 or 1) }, on and 0.18 or 0.3, on and Enum.EasingStyle.Quint or Enum.EasingStyle.Back)
	for i, shadow in ipairs(self.Shadows) do
		local spec = self.ShadowSpec[i]
		tween(shadow, { BackgroundTransparency = spec[2] - (on and 0.02 or 0), Size = UDim2.new(1, spec[1] + (on and 10 or 0), 1, spec[1] + (on and 10 or 0)), Position = UDim2.new(0.5, 0, 0.5, on and 18 or 10) }, 0.22)
	end
	tween(self.MainStroke, { Transparency = on and 0.75 or 0.86 }, 0.2)
end

function Window:_bindDrag(handle)
	handle.InputBegan:Connect(function(input)
		if not isPress(input) or self.Maximized or Drag.Active then
			return
		end
		local start = input.Position
		local startX, startY = self.PosX, self.PosY
		local moved = false
		startDrag(input, function(move)
			local delta = move.Position - start
			if not moved then
				if delta.Magnitude < 4 then
					return
				end
				moved = true
				self:_lift(true)
			end
			self:_setPos(startX + delta.X, startY + delta.Y)
		end, function()
			if moved then
				self:_lift(false)
				self:SaveState()
				self:_updateWatermark()
			end
		end)
	end)
end

function Window:_bindResize(grip)
	grip.InputBegan:Connect(function(input)
		if not isPress(input) or Drag.Active then
			return
		end
		if self.Maximized then
			self.Maximized = false
			self:_updateMaxIcon()
		end
		local start = input.Position
		local w0, h0 = self.W, self.H
		local x0, y0 = self.PosX, self.PosY
		local s = self.TargetScale
		local screen = self:_screen()
		local maxW = math.min(MAX_W, screen.X * 0.98 / s)
		local maxH = math.min(MAX_H, screen.Y * 0.96 / s)
		startDrag(input, function(move)
			local d = (move.Position - start) / s
			local w = math.clamp(w0 + d.X, MIN_W, math.max(MIN_W, maxW))
			local h = math.clamp(h0 + d.Y, MIN_H, math.max(MIN_H, maxH))
			self.W, self.H = math.floor(w), math.floor(h)
			self.Holder.Size = UDim2.fromOffset(self.W, self.H)
			self:_setPos(x0 + (self.W - w0) * s / 2, y0 + (self.H - h0) * s / 2, true)
			self:RelayoutColumns()
		end, function()
			self:FitToScreen()
			self:SaveState()
		end)
	end)
end

function Window:_updateMaxIcon()
	if self.MaxIcon then
		setIcon(self.MaxIcon, self.Maximized and "minimize-2" or "maximize-2")
	end
end

function Window:SetMaximized(on)
	if on == (self.Maximized == true) then
		return
	end
	if on then
		self.Restore = { W = self.W, H = self.H, X = self.PosX, Y = self.PosY }
		local screen = self:_screen()
		local s = self.TargetScale
		self.Maximized = true
		self:SetSize(screen.X * 0.97 / s, screen.Y * 0.95 / s, true)
		self:_setPos(0, 0)
	else
		self.Maximized = false
		local r = self.Restore or { W = self.BaseW, H = self.BaseH, X = 0, Y = 0 }
		self:SetSize(r.W, r.H, true)
		self:_setPos(r.X, r.Y)
	end
	self:FitToScreen()
	self:_updateMaxIcon()
	self:SaveState()
end

function Window:SaveState()
	local state = self.State
	state.W, state.H = self.Maximized and (self.Restore and self.Restore.W) or self.W, self.Maximized and (self.Restore and self.Restore.H) or self.H
	state.X, state.Y = math.floor(self.PosX), math.floor(self.PosY)
	state.ToggleKey = self.ToggleKey and self.ToggleKey.Name or nil
	state.Tab = self.CurrentTab and self.CurrentTab.Name or state.Tab
	queueSave()
end

-- Two columns when there's room, one on narrow windows.
function Window:RelayoutColumns()
	local width = self.W - (self.Collapsed and SIDEBAR_MIN or SIDEBAR_W)
	local two = width >= 540
	if two == self.TwoColumns then
		return
	end
	self.TwoColumns = two
	for _, tab in ipairs(self.Tabs) do
		for _, page in ipairs(tab.Pages) do
			page.Left.Size = two and UDim2.new(0.5, -6, 0, 0) or UDim2.new(1, 0, 0, 0)
			page.Right.Visible = two
			for _, section in ipairs(page.Sections) do
				if section.Side ~= "Full" then
					section.Frame.Parent = (two and section.Side == "Right") and page.Right or page.Left
				end
			end
		end
	end
end

function Window:SetSidebar(collapsed, instant)
	self.Collapsed = collapsed
	local width = collapsed and SIDEBAR_MIN or SIDEBAR_W
	local t = instant and 0 or 0.4
	tween(self.Sidebar, { Size = UDim2.new(0, width, 1, 0) }, t)
	tween(self.Content, { Position = UDim2.fromOffset(width, 0), Size = UDim2.new(1, -width, 1, 0) }, t)
	for _, label in ipairs(self.CollapseLabels) do
		if collapsed then
			label.Visible = false
		else
			task.delay(instant and 0 or 0.18, function()
				if not self.Collapsed then
					label.Visible = true
				end
			end)
		end
	end
	tween(self.SearchButton, { Size = collapsed and UDim2.fromOffset(40, 34) or UDim2.new(1, -24, 0, 34) }, t)
	tween(self.Avatar, { Position = collapsed and UDim2.new(0.5, -17, 0, 8) or UDim2.fromOffset(8, 8) }, t)
	for _, entry in ipairs(self.Entries) do
		if entry.SetCollapsed then
			entry:SetCollapsed(collapsed, instant)
		end
	end
	if self.CollapseIcon then
		setIcon(self.CollapseIcon, collapsed and "panel-left-open" or "panel-left-close")
	end
	self.TwoColumns = nil
	self:RelayoutColumns()
	task.delay(instant and 0 or 0.05, function()
		self:_moveTabHighlight(true)
	end)
end

-- ======================================================================
-- Open and close
-- ======================================================================
function Window:_buttonOffset()
	local button = self.ToggleButton and self.ToggleButton.Button
	if not button or not button.Visible then
		return nil
	end
	local center = button.AbsolutePosition + button.AbsoluteSize / 2
	local gui = self.Gui
	local rel = center - gui.AbsolutePosition
	local screen = self:_screen()
	return Vector2.new(rel.X - screen.X / 2, rel.Y - screen.Y / 2)
end

function Window:_blur(on)
	if on and Settings.Blur then
		if not self.BlurEffect or not self.BlurEffect.Parent then
			pcall(function()
				local blur = Instance.new("BlurEffect")
				blur.Name = "PepsiUI_Blur"
				blur.Size = 0
				blur.Parent = Lighting
				self.BlurEffect = blur
			end)
		end
		if self.BlurEffect then
			tween(self.BlurEffect, { Size = 14 }, 0.35)
		end
	elseif self.BlurEffect then
		tween(self.BlurEffect, { Size = 0 }, 0.25)
	end
end

function Window:SetOpen(state, instant)
	if self.Open == state then
		return
	end
	self.Open = state
	local style = Settings.OpenAnimation
	if not Settings.Animations then
		style = "None"
	end
	local from = self:_buttonOffset()
	if style == "Genie" and not from then
		style = "Pop"
	end
	self.AnimToken = (self.AnimToken or 0) + 1
	local token = self.AnimToken
	if state then
		self.Holder.Visible = true
		sfx("Open")
		self.Unread = 0
		self:_updateBadges()
		if style == "None" or instant then
			self.Animating = false
			self.Scale.Scale = self.TargetScale
			self.Holder.Position = UDim2.new(0.5, self.PosX, 0.5, self.PosY)
		elseif style == "Genie" then
			self.Animating = true
			self.Holder.Position = UDim2.new(0.5, from.X, 0.5, from.Y)
			self.Scale.Scale = self.TargetScale * 0.06
			tween(self.Holder, { Position = UDim2.new(0.5, self.PosX, 0.5, self.PosY) }, 0.42, Enum.EasingStyle.Quint)
			tween(self.Scale, { Scale = self.TargetScale }, 0.5, Enum.EasingStyle.Back)
		elseif style == "Slide" then
			self.Animating = true
			self.Scale.Scale = self.TargetScale
			self.Holder.Position = UDim2.new(0.5, self.PosX, 0.5, self.PosY + 70)
			tween(self.Holder, { Position = UDim2.new(0.5, self.PosX, 0.5, self.PosY) }, 0.45, Enum.EasingStyle.Quint)
		else
			self.Animating = true
			self.Holder.Position = UDim2.new(0.5, self.PosX, 0.5, self.PosY)
			self.Scale.Scale = self.TargetScale * 0.9
			tween(self.Scale, { Scale = self.TargetScale }, 0.42, Enum.EasingStyle.Back)
		end
		self.CurX, self.CurY = self.PosX, self.PosY
		task.delay(0.5, function()
			if self.AnimToken == token then
				self.Animating = false
				self.Holder.Position = UDim2.new(0.5, self.PosX, 0.5, self.PosY)
			end
		end)
		self:_blur(true)
	else
		sfx("Close")
		Library:CloseContextMenu()
		Library:HideTooltip()
		local hideAfter = 0.3
		if style == "None" or instant then
			hideAfter = 0
		elseif style == "Genie" then
			self.Animating = true
			tween(self.Holder, { Position = UDim2.new(0.5, from.X, 0.5, from.Y) }, 0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			tween(self.Scale, { Scale = self.TargetScale * 0.05 }, 0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			hideAfter = 0.33
		elseif style == "Slide" then
			self.Animating = true
			tween(self.Holder, { Position = UDim2.new(0.5, self.PosX, 0.5, self.PosY + 70) }, 0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			hideAfter = 0.26
		else
			tween(self.Scale, { Scale = self.TargetScale * 0.9 }, 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			hideAfter = 0.18
		end
		local function hide()
			if self.AnimToken == token and not self.Open then
				self.Holder.Visible = false
				self.Animating = false
				self.Holder.Position = UDim2.new(0.5, self.PosX, 0.5, self.PosY)
			end
		end
		if hideAfter > 0 then
			task.delay(hideAfter, hide)
		else
			hide()
		end
		self:_blur(false)
	end
	if self.ToggleButton then
		self.ToggleButton.SetState(state)
	end
	self:_updateWatermark()
end

-- The top bar steps aside while it would sit on top of the open menu.
function Window:_updateWatermark()
	local bar = self.WatermarkFrame
	if not bar or not Settings.Watermark then
		return
	end
	local covering = false
	if self.Open then
		local screen = self:_screen()
		local top = screen.Y / 2 + self.PosY - self.H * self.TargetScale / 2
		local barBottom = bar.Position.Y.Scale * screen.Y + bar.Position.Y.Offset + 36
		covering = top < barBottom + 4
	end
	bar.Visible = not covering
end

function Window:Toggle()
	self:SetOpen(not self.Open)
end

function Window:SetTitle(t)
	self.Title = tostring(t)
	self.TitleLabel.Text = self.Title
end

function Window:SetSubtitle(t)
	self.Subtitle = tostring(t)
	self.SubtitleLabel.Text = self.Subtitle
	if self.WatermarkGame then
		self.WatermarkGame.Text = self.Subtitle
	end
end

