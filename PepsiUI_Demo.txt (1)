local function luminance(c)
	return 0.2126 * c.R + 0.7152 * c.G + 0.0722 * c.B
end
-- Text colour that reads well on top of a colour (white on dark accents, near black on light ones).
local function onColor(c)
	return luminance(c) > 0.62 and rgb(16, 16, 22) or Color3.new(1, 1, 1)
end
local function derive()
	Theme.OnAccent = onColor(Theme.AccentA:Lerp(Theme.AccentB, 0.5))
	Theme.Shadow = Color3.new(0, 0, 0)
	Theme.Light = luminance(Theme.Background) > 0.5
end
derive()

local function fromHex(value)
	if typeof(value) == "Color3" then
		return value
	end
	local s = tostring(value or ""):gsub("#", ""):gsub("%s", "")
	if #s == 3 then
		s = s:sub(1, 1):rep(2) .. s:sub(2, 2):rep(2) .. s:sub(3, 3):rep(2)
	end
	if #s ~= 6 or s:find("[^%x]") then
		return nil
	end
	local ok, c = pcall(Color3.fromHex, s)
	return ok and c or nil
end
Library.FromHex = fromHex

local function toHex(c)
	local ok, hex = pcall(function()
		return c:ToHex()
	end)
	return ok and hex:upper() or "FFFFFF"
end

-- ======================================================================
-- Theme bindings
-- ======================================================================
local Bindings = {} -- slot -> { [instance] = { [property] = true } }
for slot in pairs(DefaultTheme) do
	Bindings[slot] = setmetatable({}, { __mode = "k" })
end
Bindings.OnAccent = setmetatable({}, { __mode = "k" })
Bindings.Shadow = setmetatable({}, { __mode = "k" })

local Gradients = setmetatable({}, { __mode = "k" }) -- UIGradient -> { a, b } slot names
local Glass = setmetatable({}, { __mode = "k" }) -- object -> base transparency
local Corners = setmetatable({}, { __mode = "k" }) -- UICorner -> base radius
local FontObjects = setmetatable({}, { __mode = "k" }) -- text object -> weight name
local Painters = {} -- functions that repaint stateful elements

local function bind(object, property, slot)
	local set = Bindings[slot]
	if not set then
		return object
	end
	for otherSlot, otherSet in pairs(Bindings) do
		if otherSlot ~= slot then
			local props = otherSet[object]
			if props then
				props[property] = nil
			end
		end
	end
	local props = set[object]
	if not props then
		props = {}
		set[object] = props
	end
	props[property] = true
	object[property] = Theme[slot]
	return object
end

local function unbind(object, property)
	for _, set in pairs(Bindings) do
		local props = set[object]
		if props then
			props[property] = nil
		end
	end
end

local function painter(fn)
	table.insert(Painters, fn)
	return fn
end

local function accentSequence(a, b)
	local ca = Theme[a or "AccentA"] or Theme.AccentA
	local cb = Theme[b or "AccentB"] or Theme.AccentB
	if not Settings.Gradient and (a or "AccentA") == "AccentA" and (b or "AccentB") == "AccentB" then
		cb = ca
	end
	return ColorSequence.new(ca, cb)
end

