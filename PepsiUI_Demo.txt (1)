-- ======================================================================
-- Unload
-- ======================================================================
function Library:OnUnload(fn)
	table.insert(self.UnloadHooks, fn)
end

function Library:Unload()
	if self.Unloaded then
		return
	end
	self.Unloading:Fire()
	-- Your cleanup runs first, while everything still exists.
	for _, fn in ipairs(self.UnloadHooks) do
		safeCall(fn)
	end
	for _, toggle in pairs(self.Toggles) do
		if toggle.Value and toggle.Opts and toggle.Opts.OffOnUnload ~= false and toggle.Opts.TurnOffOnUnload then
			pcall(toggle.Set, toggle, false)
		end
	end
	pcall(function()
		self:SaveSettings()
	end)
	self.Unloaded = true
	for _, c in ipairs(self.Connections) do
		pcall(function()
			c:Disconnect()
		end)
	end
	table.clear(self.Connections)
	for _, window in ipairs(self.Windows) do
		pcall(function()
			if window.BlurEffect then
				window.BlurEffect:Destroy()
			end
		end)
		pcall(function()
			window.Gui:Destroy()
		end)
		pcall(function()
			window.ButtonGui:Destroy()
		end)
	end
	pcall(function()
		if Overlay.Gui then
			Overlay.Gui:Destroy()
		end
	end)
	pcall(function()
		if soundFolder then
			soundFolder:Destroy()
		end
	end)
	pcall(function()
		local env = (type(getgenv) == "function" and getgenv()) or _G
		if rawget(env, "__PepsiUI") == self then
			env.__PepsiUI = nil
		end
	end)
end
Library.Destroy = Library.Unload

-- Shortcuts that act on the first window.
function Library:Toggle(state)
	local window = self.Windows[1]
	if window then
		if state == nil then
			window:Toggle()
		else
			window:SetOpen(state == true)
		end
	end
end

function Library:GetWindow()
	return self.Windows[1]
end

-- Window shortcuts so either style works.
function Window:Notify(...)
	return Library:Notify(...)
end
function Window:Unload()
	return Library:Unload()
end
Window.Destroy = Window.Unload

-- v1 had a filter for the open page; v2 searches everything instead.
function Window:Filter(query)
	if query and query ~= "" then
		self:OpenSearch()
		local layer = self.ModalLayer
		local card = layer and layer:FindFirstChild("Card")
		local box = card and card:FindFirstChild("Query")
		if box then
			box.Text = tostring(query)
		end
	end
end

return Library
end)()
