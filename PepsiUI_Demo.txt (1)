-- Graph: a live bar chart (fps, coins per minute...)
-- ======================================================================
function Section:Graph(opts)
	opts = opts or {}
	local e = newBlock(self, "Graph", opts)
	padding(e.Frame, 10, 12, 10, 12)
	local count = tonumber(opts.Bars or opts.Max) or 36
	local height = tonumber(opts.Height) or 64
	local head = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), Parent = e.Frame })
	text({ Parent = head, Text = tostring(opts.Name or opts.Title or "Graph"), Font = "SemiBold", Size = 14, Sz = UDim2.new(1, -90, 1, 0), Truncate = true })
	local current = text({ Parent = head, Text = "0", Font = "Mono", Size = 12, Color = "AccentA", XAlign = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0), Pos = UDim2.fromScale(1, 0), Sz = UDim2.new(0, 90, 1, 0) })
	local area = create("Frame", { BackgroundColor3 = "Field", BackgroundTransparency = 0.3, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, height), ClipsDescendants = true, Parent = e.Frame })
	corner(8, area)
	create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 24 + height), Size = UDim2.new(1, 0, 0, 0), Parent = e.Frame })
	local bars = {}
	for i = 1, count do
		local b = create("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new((i - 1) / count, 1, 1, -2),
			Size = UDim2.new(1 / count, -2, 0, 0),
			BackgroundColor3 = "AccentA",
			BackgroundTransparency = 0.25,
			BorderSizePixel = 0,
			Parent = area,
		})
		corner(2, b)
		bars[i] = b
	end
	local values = {}
	local suffix = tostring(opts.Suffix or "")
	local function render()
		local top = tonumber(opts.Ceiling) or 0
		for _, v in ipairs(values) do
			top = math.max(top, v)
		end
		top = math.max(top, 1e-6)
		for i = 1, count do
			local v = values[#values - count + i]
			local b = bars[i]
			if v then
				local h = math.max(2, (v / top) * (height - 6))
				paint(b, { Size = UDim2.new(1 / count, -2, 0, h) }, true, 0.2)
				b.BackgroundTransparency = i == count and 0 or 0.25 + (1 - i / count) * 0.45
			else
				b.Size = UDim2.new(1 / count, -2, 0, 0)
			end
		end
	end
	function e:Push(v)
		v = tonumber(v) or 0
		table.insert(values, v)
		while #values > count do
			table.remove(values, 1)
		end
		current.Text = abbreviate(v) .. suffix
		render()
	end
	e.Add = e.Push
	function e:Clear()
		table.clear(values)
		render()
	end
	return e
end

