function Library:Loader(opts)
	opts = opts or {}
	local o = overlay()
	local gui = create("Frame", { Name = "Loader", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 80, Parent = o.Root })
	local blur
	if opts.Blur ~= false then
		pcall(function()
			blur = Instance.new("BlurEffect")
			blur.Name = "PepsiUI_LoaderBlur"
			blur.Size = 0
			blur.Parent = Lighting
		end)
	end
	local card = create("Frame", {
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(Library.Mobile and 300 or 360, 176),
		BackgroundColor3 = "Background",
		ClipsDescendants = true,
		ZIndex = 81,
		Parent = gui,
	})
	corner(18, card)
	stroke(card, 0.85)
	local cardScale = create("UIScale", { Scale = 0.85, Parent = card })
	local glowA = glowBlob(card, 260, "AccentA", 0.05)
	glowA.Position = UDim2.new(1, -30, 0, 10)
	local glowB = glowBlob(card, 240, "AccentB", 0.045)
	glowB.Position = UDim2.new(0, 20, 1, 0)
	-- Rising bubbles.
	local bubbles = {}
	for i = 1, 10 do
		local size = math.random(3, 8)
		local b = create("Frame", {
			Name = "Bubble",
			BackgroundColor3 = i % 2 == 0 and "AccentA" or "AccentB",
			BackgroundTransparency = 0.6,
			Size = UDim2.fromOffset(size, size),
			Position = UDim2.new(math.random(), 0, 1, math.random(0, 160)),
			ZIndex = 82,
			Parent = card,
		})
		corner(UDim.new(1, 0), b)
		table.insert(bubbles, { Frame = b, Speed = math.random(25, 60), X = b.Position.X.Scale, Phase = math.random() * 6 })
	end
	local logoHolder = create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 24), Size = UDim2.fromOffset(46, 46), ZIndex = 83, Parent = card })
	if type(opts.Logo) == "function" then
		pcall(opts.Logo, logoHolder, 46)
	else
		local tile = create("Frame", { BackgroundColor3 = "AccentA", Size = UDim2.fromScale(1, 1), ZIndex = 83, Parent = logoHolder })
		corner(14, tile)
		gradient(tile, 45)
		local id = opts.Logo and iconId(opts.Logo)
		if id then
			create("ImageLabel", { BackgroundTransparency = 1, Image = id, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.62, 0.62), ZIndex = 84, Parent = tile })
		else
			text({ Parent = tile, Text = tostring(opts.Title or "P"):sub(1, 1):upper(), Font = "Heavy", Size = 26, Color = "OnAccent", XAlign = Enum.TextXAlignment.Center, Sz = UDim2.fromScale(1, 1), Z = 84 })
		end
	end
	local logoScale = create("UIScale", { Parent = logoHolder })
	text({ Parent = card, Text = tostring(opts.Title or Library.DefaultTitle or "Pepsi Hub"), Font = "Bold", Size = 21, Pos = UDim2.fromOffset(82, 26), Sz = UDim2.new(1, -100, 0, 24), Truncate = true, Z = 83 })
	text({ Parent = card, Text = tostring(opts.Subtitle or "Getting things ready"), Size = 13, Color = "SubText", Pos = UDim2.fromOffset(82, 50), Sz = UDim2.new(1, -100, 0, 16), Truncate = true, Z = 83 })
	local status = text({ Parent = card, Text = "Starting...", Size = 13, Color = "SubText", Pos = UDim2.new(0, 24, 1, -58), Sz = UDim2.new(1, -96, 0, 16), Truncate = true, Z = 83 })
	local percent = text({ Parent = card, Text = "0%", Font = "Mono", Size = 12, Color = "Text", XAlign = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0), Pos = UDim2.new(1, -24, 1, -58), Sz = UDim2.fromOffset(60, 16), Z = 83 })
	local track = create("Frame", { BackgroundColor3 = "Field", Position = UDim2.new(0, 24, 1, -34), Size = UDim2.new(1, -48, 0, 8), ZIndex = 83, Parent = card })
	corner(UDim.new(1, 0), track)
	stroke(track, 0.9)
	local fill = create("Frame", { BackgroundColor3 = "AccentA", Size = UDim2.fromScale(0, 1), ZIndex = 84, Parent = track })
	corner(UDim.new(1, 0), fill)
	gradient(fill)
	local shine = create("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.55, Size = UDim2.fromScale(1, 1), ZIndex = 85, Parent = fill })
	corner(UDim.new(1, 0), shine)
	local shineGradient = create("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.3), NumberSequenceKeypoint.new(1, 1) }),
		Offset = Vector2.new(-1, 0),
		Parent = shine,
	})
	tween(shineGradient, { Offset = Vector2.new(1, 0) }, 1.2, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1)

	tween(gui, { BackgroundTransparency = 0.45 }, 0.4)
	tween(cardScale, { Scale = 1 }, 0.5, Enum.EasingStyle.Back)
	if blur then
		tween(blur, { Size = 14 }, 0.4)
	end
	sfx("Whoosh")
	local loader = { Progress = 0, Finished = false }
	local job = Ticker.Add(function(dt)
		if loader.Finished then
			return true
		end
		local t = os.clock()
		logoScale.Scale = 1 + math.sin(t * 3) * 0.035
		for _, b in ipairs(bubbles) do
			local y = b.Frame.Position.Y.Offset - b.Speed * dt
			if y < -180 then
				y = math.random(0, 30)
				b.X = math.random()
			end
			b.Frame.Position = UDim2.new(b.X + math.sin(t * 1.6 + b.Phase) * 0.02, 0, 1, y)
		end
	end)
	function loader:Step(label, progress)
		if self.Finished then
			return
		end
		if label then
			status.Text = tostring(label)
		end
		if progress then
			self.Progress = math.clamp(progress, 0, 1)
			tween(fill, { Size = UDim2.fromScale(self.Progress, 1) }, 0.45)
			percent.Text = math.floor(self.Progress * 100 + 0.5) .. "%"
			sfx("Slide", 0.8 + self.Progress * 0.6)
		end
	end
	function loader:Done(label)
		if self.Finished then
			return
		end
		self:Step(label or "Ready", 1)
		task.wait(0.35)
		self.Finished = true
		Ticker.Remove(job)
		sfx("Loaded")
		tween(cardScale, { Scale = 1.06 }, 0.35, Enum.EasingStyle.Quint)
		fadeItems(snapshot(card), true, 0.3)
		tween(gui, { BackgroundTransparency = 1 }, 0.35)
		if blur then
			tween(blur, { Size = 0 }, 0.35)
		end
		task.delay(0.4, function()
			gui:Destroy()
			if blur then
				blur:Destroy()
			end
		end)
	end
	loader.Destroy = loader.Done
	-- Steps that run by themselves.
	if opts.Steps and opts.Auto ~= false then
		task.spawn(function()
			local steps = opts.Steps
			local each = (tonumber(opts.Duration) or 2) / math.max(1, #steps)
			for i, s in ipairs(steps) do
				if loader.Finished then
					return
				end
				loader:Step(s, i / #steps * 0.95)
				task.wait(each)
			end
			if opts.AutoFinish ~= false then
				loader:Done()
			end
		end)
	end
	return loader
end

