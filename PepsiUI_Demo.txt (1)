-- ======================================================================
local Overlay = {}
local function overlay()
	if Overlay.Gui and Overlay.Gui.Parent then
		return Overlay
	end
	local gui = newScreen("PepsiUI_Overlay", 1000)
	Overlay.Gui = gui
	Overlay.Root = create("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gui })
	return Overlay
end

-- Converts an AbsolutePosition to an offset inside the overlay.
local function overlayPoint(abs)
	return abs - overlay().Root.AbsolutePosition
end

local function overlaySize()
	local size = overlay().Root.AbsoluteSize
	if size.X < 10 then
		return viewportSize()
	end
	return size
end

-- ======================================================================
-- Tooltips (hover on PC, long press on phones)
-- ======================================================================
local Tooltip = { Token = 0 }
local function ensureTooltip()
	if Tooltip.Frame and Tooltip.Frame.Parent then
		return
	end
	local o = overlay()
	-- Grows with its text up to 260 wide, then wraps.
	local frame = create("Frame", {
		Name = "Tooltip",
		BackgroundColor3 = "Section",
		BackgroundTransparency = 0.02,
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		Visible = false,
		ZIndex = 50,
		Parent = o.Root,
	})
	corner(8, frame)
	stroke(frame, 0.82)
	padding(frame, 6, 11, 7, 11)
	local label = text({
		Parent = frame,
		Text = "",
		Size = 13,
		Color = "Text",
		Wrap = true,
		Rich = true,
		Auto = Enum.AutomaticSize.XY,
		Sz = UDim2.fromOffset(0, 0),
		Z = 51,
	})
	create("UISizeConstraint", { MaxSize = Vector2.new(260, 400), Parent = label })
	Tooltip.Frame, Tooltip.Label, Tooltip.Scale = frame, label, create("UIScale", { Parent = frame })
end

local function placeTooltip()
	local frame = Tooltip.Frame
	local screen = overlaySize()
	local size = frame.AbsoluteSize
	local pos
	if Tooltip.Anchor and Tooltip.Anchor.Parent then
		local a = overlayPoint(Tooltip.Anchor.AbsolutePosition)
		local s = Tooltip.Anchor.AbsoluteSize
		pos = Vector2.new(a.X + s.X / 2 - size.X / 2, a.Y - size.Y - 8)
		if pos.Y < 4 then
			pos = Vector2.new(pos.X, a.Y + s.Y + 8)
		end
	else
		local m = mouseLocation()
		pos = Vector2.new(m.X + 16, m.Y + 18)
		if pos.X + size.X > screen.X - 6 then
			pos = Vector2.new(m.X - size.X - 10, pos.Y)
		end
		if pos.Y + size.Y > screen.Y - 6 then
			pos = Vector2.new(pos.X, m.Y - size.Y - 10)
		end
	end
	pos = Vector2.new(math.clamp(pos.X, 6, math.max(6, screen.X - size.X - 6)), math.clamp(pos.Y, 6, math.max(6, screen.Y - size.Y - 6)))
	frame.Position = UDim2.fromOffset(pos.X, pos.Y)
end

function Library:ShowTooltip(content, anchor)
	if not Settings.Tooltips or content == nil or content == "" then
		return
	end
	ensureTooltip()
	Tooltip.Token += 1
	local frame, label = Tooltip.Frame, Tooltip.Label
	label.Text = tostring(content)
	Tooltip.Anchor = anchor
	frame.Visible = true
	placeTooltip()
	frame.BackgroundTransparency = 1
	label.TextTransparency = 1
	Tooltip.Scale.Scale = 0.94
	tween(frame, { BackgroundTransparency = 0.02 }, 0.15)
	tween(label, { TextTransparency = 0 }, 0.15)
	tween(Tooltip.Scale, { Scale = 1 }, 0.25, Enum.EasingStyle.Back)
	if not anchor and not Tooltip.Job then
		Tooltip.Job = Ticker.Add(function()
			if not frame.Visible then
				Tooltip.Job = nil
				return true
			end
			placeTooltip()
		end)
	end
end

function Library:HideTooltip()
	if not Tooltip.Frame then
		return
	end
	Tooltip.Token += 1
	local token = Tooltip.Token
	tween(Tooltip.Frame, { BackgroundTransparency = 1 }, 0.1)
	tween(Tooltip.Label, { TextTransparency = 1 }, 0.1)
	task.delay(0.1, function()
		if Tooltip.Token == token and Tooltip.Frame then
			Tooltip.Frame.Visible = false
		end
	end)
end

-- Hover something for a moment to see its tooltip.
local function attachTooltip(object, source)
	local hovering, token = false, 0
	object.MouseEnter:Connect(function()
		if Library.Mobile then
			return
		end
		hovering = true
		token += 1
		local mine = token
		task.delay(0.45, function()
			if hovering and token == mine then
				local value = type(source) == "function" and source() or source
				if value and value ~= "" then
					Library:ShowTooltip(value)
				end
			end
		end)
	end)
	object.MouseLeave:Connect(function()
		hovering = false
		token += 1
		Library:HideTooltip()
	end)
	object.InputBegan:Connect(function(input)
		if isPress(input) then
			hovering = false
			token += 1
			Library:HideTooltip()
		end
	end)
end

-- ======================================================================
-- Context menu (right click on PC, long press on phones)
-- items = { { Name, Icon, Callback, Danger, Hint }, { Divider = true }, { Header = "x", Text = "y" } }
-- ======================================================================
local Context = {}
function Library:CloseContextMenu()
	local menu = Context.Menu
	if not menu then
		return
	end
	Context.Menu = nil
	local catcher, frame, scale = menu.Catcher, menu.Frame, menu.Scale
	catcher:Destroy()
	tween(scale, { Scale = 0.94 }, 0.12)
	fadeItems(menu.Items, true, 0.12)
	task.delay(0.13, function()
		frame:Destroy()
	end)
end

function Library:ContextMenu(items, at)
	self:CloseContextMenu()
	self:HideTooltip()
	if not items or #items == 0 then
		return
	end
	local o = overlay()
	local mobile = Library.Mobile
	local rowH = mobile and 38 or 30
	local width = mobile and 240 or 210
	local catcher = create("TextButton", {
		Name = "ContextCatcher",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = mobile and 0.6 or 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 60,
		Parent = o.Root,
	})
	local frame = create("Frame", {
		Name = "ContextMenu",
		BackgroundColor3 = "Section",
		Size = UDim2.fromOffset(width, 0),
		ZIndex = 61,
		Parent = o.Root,
	})
	corner(11, frame)
	stroke(frame, 0.84)
	padding(frame, 5, 5, 5, 5)
	list(frame, 2)
	local height = 10
	for i, item in ipairs(items) do
		if item.Divider then
			local line = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 7), LayoutOrder = i, ZIndex = 62, Parent = frame })
			create("Frame", { BackgroundColor3 = "Stroke", BackgroundTransparency = 0.9, BorderSizePixel = 0, Position = UDim2.fromOffset(4, 3), Size = UDim2.new(1, -8, 0, 1), ZIndex = 62, Parent = line })
			height += 7 + 2
		elseif item.Header then
			local body = item.Text and tostring(item.Text) or nil
			local bodyH = body and measure(body, 12, width - 24).Y + 2 or 0
			local h = 22 + (body and bodyH + 2 or 0) + 4
			local head = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, h), LayoutOrder = i, ZIndex = 62, Parent = frame })
			text({ Parent = head, Text = tostring(item.Header), Font = "Bold", Size = 13, Pos = UDim2.fromOffset(8, 4), Sz = UDim2.new(1, -16, 0, 18), Truncate = true, Z = 63 })
			if body then
				text({ Parent = head, Text = body, Size = 12, Color = "SubText", Wrap = true, YAlign = Enum.TextYAlignment.Top, Pos = UDim2.fromOffset(8, 23), Sz = UDim2.new(1, -16, 0, bodyH), Z = 63 })
			end
			height += h + 2
		else
			local row = create("TextButton", {
				Name = "Item",
				AutoButtonColor = false,
				Text = "",
				BackgroundColor3 = item.Danger and "Error" or "ElementHover",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, rowH),
				LayoutOrder = i,
				ZIndex = 62,
				Parent = frame,
			})
			corner(7, row)
			local x = 8
			if item.Icon then
				local img, ok = icon(row, item.Icon, 15, item.Danger and "Error" or "SubText", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), ZIndex = 63 })
				if ok then
					x = 30
				else
					img:Destroy()
				end
			end
			local label = text({ Parent = row, Text = tostring(item.Name or ""), Size = 13, Color = item.Danger and "Error" or "Text", Pos = UDim2.fromOffset(x, 0), Sz = UDim2.new(1, -x - 50, 1, 0), Truncate = true, Z = 63 })
			if item.Hint then
				text({ Parent = row, Text = tostring(item.Hint), Font = "Mono", Size = 11, Color = "Dim", XAlign = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0), Pos = UDim2.new(1, -8, 0, 0), Sz = UDim2.new(0, 60, 1, 0), Z = 63 })
			end
			if item.Disabled then
				label.TextTransparency = 0.5
			end
			row.MouseEnter:Connect(function()
				tween(row, { BackgroundTransparency = item.Danger and 0.85 or 0.2 }, 0.1)
				sfx("Hover")
			end)
			row.MouseLeave:Connect(function()
				tween(row, { BackgroundTransparency = 1 }, 0.12)
			end)
			row.Activated:Connect(function()
				if item.Disabled then
					return
				end
				sfx("Click")
				Library:CloseContextMenu()
				task.spawn(safeCall, item.Callback)
			end)
			height += rowH + 2
		end
	end
	frame.Size = UDim2.fromOffset(width, height)
	local screen = overlaySize()
	local pos
	if typeof(at) == "Instance" then
		local a = overlayPoint(at.AbsolutePosition)
		local s = at.AbsoluteSize
		if mobile then
			pos = Vector2.new(a.X + s.X / 2 - width / 2, a.Y + s.Y + 6)
		else
			pos = Vector2.new(a.X + s.X - width, a.Y + s.Y + 4)
		end
		if pos.Y + height > screen.Y - 8 then
			pos = Vector2.new(pos.X, a.Y - height - 6)
		end
	elseif typeof(at) == "Vector2" then
		pos = at
	else
		pos = mouseLocation()
	end
	if mobile and typeof(at) ~= "Vector2" then
		pos = Vector2.new(screen.X / 2 - width / 2, math.clamp(pos.Y, 8, math.max(8, screen.Y - height - 8)))
	end
	pos = Vector2.new(math.clamp(pos.X, 8, math.max(8, screen.X - width - 8)), math.clamp(pos.Y, 8, math.max(8, screen.Y - height - 8)))
	frame.Position = UDim2.fromOffset(pos.X, pos.Y)
	local scale = create("UIScale", { Scale = 0.92, Parent = frame })
	local snap = snapshot(frame)
	fadeItems(snap, true)
	fadeItems(snap, false, 0.14)
	tween(scale, { Scale = 1 }, 0.28, Enum.EasingStyle.Back)
	catcher.Activated:Connect(function()
		Library:CloseContextMenu()
	end)
	catcher.MouseButton2Click:Connect(function()
		Library:CloseContextMenu()
	end)
	Context.Menu = { Catcher = catcher, Frame = frame, Scale = scale, Items = snap }
	sfx("Pop", 1.1)
end

-- Right click or long press on an object opens a menu built by getItems().
local function attachContext(object, getItems)
	object.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			if os.clock() - (Context.LastOpen or 0) < 0.25 then
				return
			end
			local items = getItems()
			if items then
				Context.LastOpen = os.clock()
				Library:ContextMenu(items)
			end
		elseif isTouch(input) then
			local start = input.Position
			local alive = true
			local conn
			conn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End or (input.Position - start).Magnitude > 10 then
					alive = false
					conn:Disconnect()
				end
			end)
			task.delay(0.55, function()
				if alive and not Drag.Active and os.clock() - (Context.LastOpen or 0) > 0.25 then
					alive = false
					pcall(function()
						conn:Disconnect()
					end)
					local items = getItems()
					if items then
						Context.LastOpen = os.clock()
						Context.LongPressAt = os.clock()
						Library:ContextMenu(items, object)
					end
				end
			end)
		end
	end)
end

-- ======================================================================
-- Notifications
-- ======================================================================
local NotifyTypes = {
	Info = { Icon = "bell", Slot = nil, Sound = "Notify" },
	Success = { Icon = "circle-check", Slot = "Success", Sound = "Success" },
	Warning = { Icon = "triangle-alert", Slot = "Warning", Sound = "Warning" },
	Error = { Icon = "circle-x", Slot = "Error", Sound = "Error" },
}
Library.NotifyAdded = Signal.new()
local Toasts = { List = {}, Order = 0 }
local Island = { Queue = {}, Busy = false }

local function stackHolder()
	local o = overlay()
	local position = Settings.NotifyPosition
	if Toasts.Holder and Toasts.Holder.Parent and Toasts.Position == position then
		return Toasts.Holder
	end
	if Toasts.Holder then
		Toasts.Holder:Destroy()
		table.clear(Toasts.List)
	end
	local top = position:find("Top") ~= nil
	local left = position:find("left") ~= nil
	local center = position:find("center") ~= nil
	local width = Library.Mobile and 300 or 330
	local holder = create("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(center and 0.5 or (left and 0 or 1), top and 0 or 1),
		Position = UDim2.new(center and 0.5 or (left and 0 or 1), center and 0 or (left and 18 or -18), top and 0 or 1, top and 64 or -18),
		Size = UDim2.fromOffset(width, 700),
		ZIndex = 40,
		Parent = o.Root,
	})
	list(holder, 8, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Center, top and Enum.VerticalAlignment.Top or Enum.VerticalAlignment.Bottom)
	Toasts.Holder, Toasts.Position, Toasts.Top, Toasts.Left, Toasts.Width = holder, position, top, left or center, width
	return holder
end

local function toastHeight(width, opts)
	local contentWidth = width - 74
	local h = 12 + 18
	if opts.Content ~= "" then
		h += 3 + measure(opts.Content, 13, contentWidth).Y
	end
	if opts.Buttons then
		h += 36
	end
	return math.max(58, h + 14)
end

local function showToast(opts, kind)
	local holder = stackHolder()
	local width = Toasts.Width
	Toasts.Order += 1
	local fromLeft = Toasts.Left and Toasts.Position:find("center") == nil
	local offX = fromLeft and -(width + 30) or (width + 30)
	if Toasts.Position:find("center") then
		offX = 0
	end
	local height = toastHeight(width, opts)
	local slot = create("Frame", {
		Name = "Toast",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(width, 0),
		LayoutOrder = Toasts.Top and -Toasts.Order or Toasts.Order,
		Parent = holder,
	})
	local card = create("Frame", {
		Name = "Card",
		BackgroundColor3 = "Section",
		BackgroundTransparency = 0.03,
		Size = UDim2.new(1, 0, 0, height),
		Position = UDim2.fromOffset(offX, Toasts.Position:find("center") and (Toasts.Top and -24 or 24) or 0),
		Parent = slot,
	})
	corner(13, card)
	local cardStroke = stroke(card, 0.86)
	local tint = kind.Slot
	local bar = create("Frame", {
		Name = "Edge",
		BackgroundColor3 = tint or "AccentA",
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 10),
		Size = UDim2.new(0, 3, 1, -20),
		Parent = card,
	})
	corner(UDim.new(1, 0), bar)
	if not tint then
		gradient(bar, 90)
	end
	local tile = create("Frame", { Name = "Tile", Position = UDim2.fromOffset(14, 13), Size = UDim2.fromOffset(34, 34), BackgroundColor3 = tint or "AccentA", Parent = card })
	corner(10, tile)
	if not tint then
		gradient(tile, 45)
	end
	icon(tile, opts.Icon or kind.Icon, 18, Color3.new(1, 1, 1), { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
	text({ Parent = card, Text = opts.Title, Font = "SemiBold", Size = 14, Pos = UDim2.fromOffset(60, 12), Sz = UDim2.new(1, -110, 0, 18), Truncate = true })
	text({ Parent = card, Text = "now", Font = "Medium", Size = 11, Color = "Dim", XAlign = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0), Pos = UDim2.new(1, -34, 0, 13), Sz = UDim2.fromOffset(40, 16) })
	if opts.Content ~= "" then
		text({
			Parent = card,
			Text = opts.Content,
			Size = 13,
			Color = "SubText",
			Wrap = true,
			Rich = true,
			YAlign = Enum.TextYAlignment.Top,
			Pos = UDim2.fromOffset(60, 33),
			Sz = UDim2.new(1, -74, 0, measure(opts.Content, 13, width - 74).Y + 2),
		})
	end
	local closeButton = create("TextButton", {
		Name = "Close",
		AutoButtonColor = false,
		Text = "",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 8),
		Size = UDim2.fromOffset(22, 22),
		ZIndex = 6,
		Parent = card,
	})
	local closeIcon = icon(closeButton, "x", 14, "Dim", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 6 })
	local progress = create("Frame", {
		Name = "Progress",
		BackgroundColor3 = tint or "AccentA",
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -1),
		Size = UDim2.new(1, -28, 0, 2),
		BackgroundTransparency = 0.2,
		Parent = card,
	})
	corner(UDim.new(1, 0), progress)
	if not tint then
		gradient(progress)
	end
	local hit = create("TextButton", { Name = "Hit", AutoButtonColor = false, Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = card })

	local toast = { Slot = slot, Card = card, Closed = false }
	local remaining = opts.Duration
	local paused = false
	local function close(direction)
		if toast.Closed then
			return
		end
		toast.Closed = true
		local i = table.find(Toasts.List, toast)
		if i then
			table.remove(Toasts.List, i)
		end
		local outX = offX
		if direction then
			outX = direction * (width + 40)
		end
		tween(card, { Position = UDim2.fromOffset(outX, card.Position.Y.Offset) }, 0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		fadeItems(snapshot(card), true, 0.28)
		task.delay(0.26, function()
			tween(slot, { Size = UDim2.fromOffset(width, 0) }, 0.22)
			task.delay(0.24, function()
				slot:Destroy()
			end)
		end)
		safeCall(opts.OnClose)
	end
	toast.Close = close

	if opts.Buttons then
		local row = create("Frame", { Name = "Buttons", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 60, 1, -12), Size = UDim2.new(1, -74, 0, 28), ZIndex = 6, Parent = card })
		list(row, 6, Enum.FillDirection.Horizontal)
		for i, b in ipairs(opts.Buttons) do
			local primary = i == 1
			local button = create("TextButton", {
				AutoButtonColor = false,
				Text = "",
				BackgroundColor3 = "Element",
				Size = UDim2.fromOffset(0, 26),
				AutomaticSize = Enum.AutomaticSize.X,
				LayoutOrder = i,
				ZIndex = 7,
				Parent = row,
			})
			corner(8, button)
			padding(button, 0, 12, 0, 12)
			if primary then
				gradient(button)
			else
				stroke(button, 0.88)
			end
			text({ Parent = button, Text = tostring(b.Name or b.Title or "OK"), Font = "SemiBold", Size = 12, Color = primary and "OnAccent" or "Text", Auto = Enum.AutomaticSize.X, Sz = UDim2.fromOffset(0, 26), Z = 8 })
			button.Activated:Connect(function()
				sfx("Click")
				close()
				task.spawn(safeCall, b.Callback)
			end)
		end
	end

	-- Hover pauses the timer; swipe sideways to dismiss; tap runs the click action.
	hit.MouseEnter:Connect(function()
		paused = true
		tween(cardStroke, { Transparency = 0.7 }, 0.15)
		tween(closeIcon, { ImageColor3 = Theme.Text }, 0.15)
	end)
	hit.MouseLeave:Connect(function()
		paused = false
		tween(cardStroke, { Transparency = 0.86 }, 0.15)
		tween(closeIcon, { ImageColor3 = Theme.Dim }, 0.15)
	end)
	closeButton.Activated:Connect(function()
		sfx("Back")
		close()
	end)
	hit.InputBegan:Connect(function(input)
		if not isPress(input) then
			return
		end
		local start = input.Position
		local moved = 0
		paused = true
		startDrag(input, function(move)
			moved = move.Position.X - start.X
			if math.abs(moved) > 4 then
				card.Position = UDim2.fromOffset(moved, card.Position.Y.Offset)
			end
		end, function()
			paused = false
			if math.abs(moved) > 80 then
				close(moved > 0 and 1 or -1)
			elseif math.abs(moved) > 4 then
				tween(card, { Position = UDim2.fromOffset(0, card.Position.Y.Offset) }, 0.35, Enum.EasingStyle.Back)
			else
				if opts.Callback then
					task.spawn(safeCall, opts.Callback)
				end
				close()
			end
		end)
	end)

	table.insert(Toasts.List, toast)
	while #Toasts.List > 5 do
		Toasts.List[1].Close()
	end

	-- Enter: the slot opens, then the card slides in.
	tween(slot, { Size = UDim2.fromOffset(width, height) }, 0.28)
	tween(card, { Position = UDim2.fromOffset(0, 0) }, 0.5, Enum.EasingStyle.Back)
	local items = snapshot(card)
	fadeItems(items, true)
	fadeItems(items, false, 0.3)
	Ticker.Add(function(dt)
		if toast.Closed then
			return true
		end
		if not paused then
			remaining -= dt
		end
		progress.Size = UDim2.new(math.clamp(remaining / opts.Duration, 0, 1), -28 * math.clamp(remaining / opts.Duration, 0, 1), 0, 2)
		if remaining <= 0 then
			close()
			return true
		end
	end)
	return toast
end

-- Dynamic island: a pill at the top that grows into the message.
local ISLAND_BG = rgb(8, 8, 11)
local function islandFrame()
	local o = overlay()
	if Island.Frame and Island.Frame.Parent then
		return Island.Frame
	end
	local frame = create("Frame", {
		Name = "Island",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -50),
		Size = UDim2.fromOffset(44, 36),
		BackgroundColor3 = ISLAND_BG,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 45,
		Parent = o.Root,
	})
	corner(UDim.new(0, 18), frame)
	stroke(frame, 0.9, 1, Color3.new(1, 1, 1))
