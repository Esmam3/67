function Window:SelectTab(tab, pageIndex)
	if not tab then
		return
	end
	local previous = self.CurrentTab
	local changed = previous ~= tab
	if changed then
		sfx("Tab")
	end
	self.CurrentTab = tab
	if previous and previous ~= tab then
		previous.Paint(true)
	end
	tab.Paint(true)
	self:_moveTabHighlight(previous == nil)
	-- Keep the picked tab in view when the list scrolls.
	task.defer(function()
		local scroll = self.TabScroll
		local ratio = self:Ratio()
		local top = tab.Button.AbsolutePosition.Y - scroll.AbsolutePosition.Y
		local bottom = top + tab.Button.AbsoluteSize.Y
		if top < 0 or bottom > scroll.AbsoluteSize.Y then
			self:ScrollTo(tab.Button, scroll, 8 / math.max(0.05, ratio) * ratio)
		end
	end)
	-- Header: icon, name and the sub page crumb.
	if setIcon(self.CrumbIcon, tab.IconName or "layout-grid") then
		self.CrumbIcon.Visible = true
	else
		self.CrumbIcon.Visible = false
	end
	self.CrumbTitle.Text = tab.Name
	self.PageDesc.Text = tab.Description ~= "" and tab.Description or self.Subtitle
	if changed then
		self.CrumbTitle.TextTransparency = 1
		self.PageDesc.TextTransparency = 1
		tween(self.CrumbTitle, { TextTransparency = 0 }, 0.3)
		tween(self.PageDesc, { TextTransparency = 0 }, 0.4)
	end
	if #tab.Pages == 0 then
		newPage(self, tab, tab.Name)
	end
	-- Sub page pills.
	for _, c in ipairs(self.SubPills:GetChildren()) do
		if c:IsA("GuiButton") then
			c:Destroy()
		end
	end
	local showBar = #tab.Pages > 1
	self.SubBar.Visible = showBar
	local top = showBar and HEADER_H + 42 or HEADER_H
	self.Pages.Position = UDim2.fromOffset(0, top)
	self.Pages.Size = UDim2.new(1, 0, 1, -top)
	if showBar then
		-- Pill widths come from the text so the highlight can slide to exact spots.
		local x = 4
		for i, page in ipairs(tab.Pages) do
			local width = math.floor(measure(page.Name, 13).X + 30)
			local pill = create("TextButton", {
				Name = "Pill" .. i,
				AutoButtonColor = false,
				Text = "",
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(width, 26),
				LayoutOrder = i,
				ZIndex = 5,
				Parent = self.SubPills,
			})
			local pillLabel = text({ Parent = pill, Text = page.Name, Font = "SemiBold", Size = 13, Color = "SubText", XAlign = Enum.TextXAlignment.Center, Sz = UDim2.fromScale(1, 1), Z = 6 })
			page.Pill, page.PillLabel, page.PillX, page.PillWidth = pill, pillLabel, x, width
			x += width + 4
			pill.MouseEnter:Connect(function()
				if self.CurrentPage ~= page then
					tween(pillLabel, { TextColor3 = Theme.Text }, 0.15)
				end
			end)
			pill.MouseLeave:Connect(function()
				if self.CurrentPage ~= page then
					tween(pillLabel, { TextColor3 = Theme.SubText }, 0.15)
				end
			end)
			pill.Activated:Connect(function()
				if self.CurrentPage ~= page then
					sfx("Click")
				end
				self:SelectPage(tab, i)
			end)
		end
	end
	self:SelectPage(tab, pageIndex or tab.LastPage or 1, previous ~= tab and previous or nil)
	if changed then
		self:SaveState()
	end
end

function Window:SelectPage(tab, index, fromTab)
	local page = tab.Pages[index] or tab.Pages[1]
	index = table.find(tab.Pages, page) or 1
	local previous = self.CurrentPage
	tab.LastPage = index
	for _, t in ipairs(self.Tabs) do
		for _, p in ipairs(t.Pages) do
			if p ~= page then
				p.Scroll.Visible = false
			end
		end
	end
	self.CurrentPage = page
	page.Scroll.Visible = true
	-- Slide in: up/down between tabs, sideways between sub pages.
	if previous ~= page then
		local offset
		if fromTab then
			local a = table.find(self.Tabs, fromTab) or 0
			local b = table.find(self.Tabs, tab) or 0
			offset = UDim2.fromOffset(0, b >= a and 22 or -22)
		elseif previous and previous.Tab == tab then
			local a = table.find(tab.Pages, previous) or 0
			offset = UDim2.fromOffset(index >= a and 28 or -28, 0)
		else
			offset = UDim2.fromOffset(0, 18)
		end
		page.Scroll.Position = offset
		tween(page.Scroll, { Position = UDim2.fromOffset(0, 0) }, 0.42)
	end
	local hasCrumb = #tab.Pages > 1
	self.CrumbSep.Visible = hasCrumb
	self.CrumbSub.Visible = hasCrumb
	self.CrumbSub.Text = hasCrumb and page.Name or ""
	for _, p in ipairs(tab.Pages) do
		if p.PillLabel then
			tween(p.PillLabel, { TextColor3 = p == page and Theme.Text or Theme.SubText }, 0.2)
		end
	end
	if page.Pill then
		local target = { Position = UDim2.fromOffset(page.PillX, 4), Size = UDim2.fromOffset(page.PillWidth, 26) }
		if fromTab or not previous or previous.Tab ~= tab then
			setProps(self.SubHighlight, target)
		else
			tween(self.SubHighlight, target, 0.38, Enum.EasingStyle.Back)
		end
	end
end

function Tab:SubTab(opts)
	if type(opts) == "string" then
		opts = { Name = opts }
	end
	opts = opts or {}
	local tab = rawget(self, "Tab") or self
	local page = newPage(tab.Window, tab, opts.Name or opts.Title or ("Page " .. (#tab.Pages + 1)))
	page.Icon = opts.Icon
	local sub = setmetatable({ Page = page, Window = tab.Window, Tab = tab, Kind = "Page", Name = page.Name }, Tab)
	if tab.Window.CurrentTab == tab then
		tab.Window:SelectTab(tab, tab.LastPage)
	end
	return sub
end
