local colorProps = {
	BackgroundColor3 = true, TextColor3 = true, ImageColor3 = true, PlaceholderColor3 = true,
	ScrollBarImageColor3 = true, BorderColor3 = true, TextStrokeColor3 = true, Color = true,
}

-- create("Frame", { BackgroundColor3 = "Section", FontFace = "Bold", ... })
-- A colour given as a slot name is bound to the theme; a weight name sets a themed font.
local function create(className, props, children)
	local object = Instance.new(className)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		elseif colorProps[k] and type(v) == "string" then
			bind(object, k, v)
		elseif k == "FontFace" and type(v) == "string" then
			setFont(object, v)
		else
			object[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = object
	end
	if parent then
		object.Parent = parent
	end
	return object
end

local function corner(radius, parent)
	local c = Instance.new("UICorner")
	if typeof(radius) == "UDim" then
		c.CornerRadius = radius
	else
		local base = radius or 8
		Corners[c] = base
		c.CornerRadius = UDim.new(0, math.floor(base * Settings.Roundness + 0.5))
	end
	c.Parent = parent
	return c
end

local function stroke(parent, transparency, thickness, slot)
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.92
	if typeof(slot) == "Color3" then
		s.Color = slot
	else
		bind(s, "Color", slot or "Stroke")
	end
	s.Parent = parent
	return s
end

local function padding(parent, top, right, bottom, left)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, top or 0),
		PaddingRight = UDim.new(0, right or top or 0),
		PaddingBottom = UDim.new(0, bottom or top or 0),
		PaddingLeft = UDim.new(0, left or right or top or 0),
		Parent = parent,
	})
end

local function list(parent, gap, direction, halign, valign)
	return create("UIListLayout", {
		Padding = UDim.new(0, gap or 6),
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

-- UIGradient multiplies with the object's own colour, so the base becomes white and the
-- gradient carries the real colours.
local function gradient(parent, rotation, a, b)
	local g = Instance.new("UIGradient")
	g.Rotation = rotation or 0
	Gradients[g] = { a or "AccentA", b or "AccentB" }
	g.Color = accentSequence(a, b)
	if parent then
		if parent:IsA("ImageLabel") or parent:IsA("ImageButton") then
			unbind(parent, "ImageColor3")
			parent.ImageColor3 = Color3.new(1, 1, 1)
		elseif parent:IsA("GuiObject") then
			unbind(parent, "BackgroundColor3")
			parent.BackgroundColor3 = Color3.new(1, 1, 1)
		end
	end
	g.Parent = parent
	return g
end

-- Big surfaces that follow the Transparency setting.
local function glass(object, base)
	Glass[object] = base
	object.BackgroundTransparency = base + (1 - base) * Settings.Transparency
	return object
end

local function text(props)
	local color = props.Color or "Text"
	local label = create("TextLabel", {
		Name = props.Name or "Text",
		BackgroundTransparency = 1,
		FontFace = props.Font or "Medium",
		TextColor3 = color,
		TextSize = props.Size or 14,
		Text = tostring(props.Text or ""),
		TextXAlignment = props.XAlign or Enum.TextXAlignment.Left,
		TextYAlignment = props.YAlign or Enum.TextYAlignment.Center,
		TextTruncate = props.Truncate and Enum.TextTruncate.AtEnd or Enum.TextTruncate.None,
		TextWrapped = props.Wrap or false,
		RichText = props.Rich or false,
		AutomaticSize = props.Auto or Enum.AutomaticSize.None,
		Size = props.Sz or UDim2.new(1, 0, 0, props.Height or 18),
		Position = props.Pos or UDim2.new(),
		AnchorPoint = props.Anchor or Vector2.zero,
		TextTransparency = props.Transparency or 0,
		ZIndex = props.Z or 1,
		LayoutOrder = props.Order or 0,
		Parent = props.Parent,
	})
	return label
end

