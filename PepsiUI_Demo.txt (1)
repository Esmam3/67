	end)
	create("Frame", { BackgroundColor3 = "Stroke", BackgroundTransparency = 0.92, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 52), Size = UDim2.new(1, 0, 0, 1), ZIndex = 53, Parent = card })
	local results = create("ScrollingFrame", {
		Name = "Results",
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = "AccentA",
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 53,
		Parent = card,
	})
	padding(results, 4, 6, 4, 6)
	list(results, 2)
	local footer
	if footerH > 0 then
		footer = text({ Parent = card, Text = "↑ ↓ to move   ·   Enter to open   ·   Esc to close", Size = 11, Color = "Dim", XAlign = Enum.TextXAlignment.Center, Anchor = Vector2.new(0, 1), Pos = UDim2.new(0, 0, 1, -4), Sz = UDim2.new(1, 0, 0, 18), Z = 53 })
	end
	local index = self:_searchIndex()
	local rows, bars, matches, selected = {}, {}, {}, 1
	local function highlight()
		for i, row in ipairs(rows) do
			local on = i == selected
			tween(row, { BackgroundTransparency = on and 0.1 or 1 }, 0.1)
			if bars[i] then
				bars[i].Visible = on
			end
		end
		local row = rows[selected]
		if row then
			local top = (selected - 1) * (rowH + 2)
			local view = results.AbsoluteWindowSize.Y / math.max(0.05, self:Ratio())
			local canvas = results.CanvasPosition.Y / math.max(0.05, self:Ratio())
			if top < canvas then
				results.CanvasPosition = Vector2.new(0, top * self:Ratio())
			elseif top + rowH > canvas + view then
				results.CanvasPosition = Vector2.new(0, (top + rowH - view + 8) * self:Ratio())
			end
		end
	end
	local function activate(i)
		local m = matches[i]
		if not m then
			return
		end
		sfx("Click")
		self:CloseModal()
		task.delay(0.05, m.Run)
	end
	local function render()
		for _, row in ipairs(rows) do
			row:Destroy()
		end
		table.clear(rows)
		table.clear(bars)
		local q = box.Text
		table.clear(matches)
		for _, item in ipairs(index) do
			-- Names match loosely (letters in order); descriptions only when the words are there.
			local score = fuzzyScore(q, item.Name)
			if q ~= "" and score == 0 and (item.Search or ""):lower():find(q:lower(), 1, true) then
				score = 220
			end
			if score > 0 then
				if item.Kind == "Tab" then
					score += 40
				end
				-- The script's own features come before the menu's settings.
				if item.Settings then
					score *= 0.75
				end
				table.insert(matches, { Item = item, Score = score })
			end
		end
		table.sort(matches, function(a, b)
			return a.Score > b.Score
		end)
		for i = #matches, 41, -1 do
			matches[i] = nil
		end
		for i, m in ipairs(matches) do
			matches[i] = m.Item
		end
		if q == "" then
			-- Show tabs first when nothing is typed.
			local tabs = {}
			for _, item in ipairs(index) do
				if item.Kind == "Tab" then
					table.insert(tabs, item)
				end
			end
			matches = tabs
		end
		for i, item in ipairs(matches) do
			local row = create("TextButton", {
				AutoButtonColor = false,
				Text = "",
				BackgroundColor3 = "ElementHover",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, rowH),
				LayoutOrder = i,
				ZIndex = 54,
				Parent = results,
			})
			corner(9, row)
			local bar = create("Frame", { Name = "Bar", BackgroundColor3 = "AccentA", Position = UDim2.new(0, 0, 0.5, -9), Size = UDim2.fromOffset(3, 18), Visible = false, ZIndex = 55, Parent = row })
			corner(UDim.new(1, 0), bar)
			gradient(bar, 90)
			bars[i] = bar
			local tile = create("Frame", { BackgroundColor3 = "Element", Position = UDim2.new(0, 10, 0.5, -14), Size = UDim2.fromOffset(28, 28), ZIndex = 55, Parent = row })
			corner(8, tile)
			icon(tile, item.Icon, 15, item.Kind == "Tab" and "AccentA" or "SubText", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 56 })
			text({ Parent = row, Text = item.Name, Font = "SemiBold", Size = 14, Pos = UDim2.fromOffset(48, mobile and 6 or 3), Sz = UDim2.new(1, -140, 0, 18), Truncate = true, Z = 55 })
			text({ Parent = row, Text = item.Path, Size = 11, Color = "Dim", Pos = UDim2.fromOffset(48, mobile and 25 or 21), Sz = UDim2.new(1, -140, 0, 14), Truncate = true, Z = 55 })
			text({ Parent = row, Text = item.Kind, Font = "Mono", Size = 10, Color = "Dim", XAlign = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0.5), Pos = UDim2.new(1, -12, 0.5, 0), Sz = UDim2.fromOffset(80, 14), Z = 55 })
			row.MouseEnter:Connect(function()
				selected = i
				highlight()
			end)
			row.Activated:Connect(function()
				activate(i)
			end)
			rows[i] = row
		end
		if #matches == 0 then
			local empty = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, rowH * 2), ZIndex = 54, Parent = results })
			text({ Parent = empty, Text = "Nothing matches \"" .. q .. "\"", Size = 13, Color = "Dim", XAlign = Enum.TextXAlignment.Center, Sz = UDim2.fromScale(1, 1), Z = 55 })
			table.insert(rows, empty)
		end
		selected = math.clamp(selected, 1, math.max(1, #matches))
		local shown = math.min(math.max(#matches, #matches == 0 and 2 or 0), maxRows)
		local listH = shown * (rowH + 2) + 8
		results.Size = UDim2.new(1, 0, 0, listH)
		tween(card, { Size = UDim2.fromOffset(width, 54 + listH + footerH) }, 0.22)
		highlight()
	end
	box:GetPropertyChangedSignal("Text"):Connect(function()
		selected = 1
		sfx("Type")
		render()
	end)
	box.FocusLost:Connect(function(enter)
		if enter then
			activate(selected)
		end
	end)
	self.ModalInput = UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Down then
			selected = math.min(#matches, selected + 1)
			highlight()
		elseif input.KeyCode == Enum.KeyCode.Up then
			selected = math.max(1, selected - 1)
			highlight()
		end
	end)
	render()
	tween(cardScale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
	if not mobile then
		task.defer(function()
			pcall(function()
				box:CaptureFocus()
			end)
		end)
	end
	return { Close = function()
		self:CloseModal()
	end }
end

-- Opens the right tab, unfolds what's folded, scrolls there and flashes it.
function Window:JumpTo(target)
	if not target then
		return
	end
	local section = target.RootSection or target
	local page = section.Page
	if not page then
		return
	end
	local tab = page.Tab
	self:SelectTab(tab, table.find(tab.Pages, page))
	local container = target.Container
	while container do
		if container.Expand then
			container:Expand(true)
		end
		container = container.Container
	end
	if target.Expand and target.Collapsed then
		target:Expand(true)
	end
	task.delay(0.35, function()
		self:ScrollTo(target.Frame)
		task.delay(0.1, function()
			if target.Highlight then
				target:Highlight()
			end
		end)
	end)
end

function Window:ScrollTo(frame, scroll, margin)
	local page = self.CurrentPage
	scroll = scroll or (page and page.Scroll)
	if not scroll or not frame or not frame.Parent then
		return
	end
	task.spawn(function()
		local desired = (margin or 12) * self:Ratio()
		local function offset()
			return frame.AbsolutePosition.Y - scroll.AbsolutePosition.Y
		end
		local start = scroll.CanvasPosition.Y
		local err = offset() - desired
		if math.abs(err) < 3 then
			return
		end
		scroll.CanvasPosition = Vector2.new(0, math.max(0, start + err))
		task.wait()
		local moved = scroll.CanvasPosition.Y - start
		local err2 = offset() - desired
		if math.abs(err2) > 3 and math.abs(moved) > 1 then
			local k = (err - err2) / moved
			if k > 0.05 then
				scroll.CanvasPosition = Vector2.new(0, math.max(0, scroll.CanvasPosition.Y + err2 / k))
			end
		end
	end)
end

-- ======================================================================
-- Sidebar entries: categories and tabs
-- ======================================================================
local TAB_H, CATEGORY_H, CATEGORY_MIN, ENTRY_GAP = 38, 26, 12, 4

function Window:_entryY(target)
	local y = 2
	for _, entry in ipairs(self.Entries) do
		if entry == target then
			return y
		end
		if entry.Frame.Visible then
			y += entry:Height() + ENTRY_GAP
		end
	end
	return y
end

function Window:_moveTabHighlight(instant)
	local tab = self.CurrentTab
	local hl = self.TabHighlight
	if not tab or tab.Hidden then
		hl.Visible = false
		return
	end
	local y = self:_entryY(tab)
	local was = hl.Visible
	hl.Visible = true
	local target = UDim2.fromOffset(10, y)
	if instant or not was then
		hl.Position = target
		hl.Size = UDim2.new(1, -20, 0, TAB_H)
	else
		-- Stretch towards the new tab, then settle: feels like it's being pulled.
		local from = hl.Position.Y.Offset
		local top, bottom = math.min(from, y), math.max(from, y) + TAB_H
		tween(hl, { Position = UDim2.fromOffset(10, top), Size = UDim2.new(1, -20, 0, bottom - top) }, 0.14, Enum.EasingStyle.Quad)
		task.delay(0.14, function()
			if self.CurrentTab == tab then
				tween(hl, { Position = target, Size = UDim2.new(1, -20, 0, TAB_H) }, 0.3, Enum.EasingStyle.Back)
			end
		end)
	end
	tween(self.HighlightBar, { Size = UDim2.fromOffset(3, 0) }, 0.08)
	task.delay(0.16, function()
		tween(self.HighlightBar, { Size = UDim2.fromOffset(3, 18) }, 0.35, Enum.EasingStyle.Back)
	end)
end

function Window:Category(name)
	local window = self
	local frame = create("Frame", {
		Name = "Category",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, self.Collapsed and CATEGORY_MIN or CATEGORY_H),
		LayoutOrder = #self.Entries + 1,
		ZIndex = 4,
		Parent = self.TabItems,
	})
	local label = text({ Parent = frame, Text = tostring(name):upper(), Font = "Bold", Size = 11, Color = "Dim", Pos = UDim2.fromOffset(6, 8), Sz = UDim2.new(1, -12, 0, 14), Truncate = true, Z = 4 })
	local line = create("Frame", { BackgroundColor3 = "Stroke", BackgroundTransparency = 0.9, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 22, 0, 1), Visible = self.Collapsed, ZIndex = 4, Parent = frame })
	local entry = { Kind = "Category", Frame = frame, Name = name }
	function entry:Height()
		return window.Collapsed and CATEGORY_MIN or CATEGORY_H
