-- Chips: tags that wrap onto new lines
-- ======================================================================
function Section:Chips(opts)
	opts = opts or {}
	local e = newBlock(self, "Chips", opts)
	padding(e.Frame, 10, 10, 10, 10)
	list(e.Frame, 8)
	e.Name = tostring(opts.Name or "")
	if e.Name ~= "" then
		text({ Parent = e.Frame, Text = e.Name, Font = "SemiBold", Size = 14, Height = 18, Order = 1 })
	end
	e.Multi = opts.Multi ~= false
	e.Options = {}
	for _, v in ipairs(opts.Options or opts.Values or {}) do
		table.insert(e.Options, tostring(v))
	end
	if e.Multi then
		e.Value = {}
		for _, v in ipairs(type(opts.Default) == "table" and opts.Default or {}) do
			table.insert(e.Value, tostring(v))
		end
	else
		e.Value = opts.Default and tostring(opts.Default) or nil
	end
	e.Callback = opts.Callback
	local wrap = create("Frame", { Name = "Wrap", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = e.Frame })
	local layout = list(wrap, 6, Enum.FillDirection.Horizontal)
	pcall(function()
		layout.Wraps = true
	end)
	local chips = {}
	local function isOn(v)
		if e.Multi then
			return table.find(e.Value, v) ~= nil
		end
		return e.Value == v
	end
	local function render(animate)
		for v, c in pairs(chips) do
			local on = isOn(v)
			paint(c.Fill, { BackgroundTransparency = on and 0 or 1 }, animate, 0.18)
			paint(c.Label, { TextColor3 = on and Theme.OnAccent or Theme.SubText }, animate, 0.18)
			paint(c.Stroke, { Transparency = on and 1 or 0.82 }, animate, 0.18)
		end
	end
	painter(function()
		render(false)
	end)
	local function build()
		for _, c in pairs(chips) do
			c.Button:Destroy()
		end
		chips = {}
		for i, v in ipairs(e.Options) do
			-- The label carries the side padding so the fill always covers the whole chip.
			local b = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = "Field", Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = i, Parent = wrap })
			corner(UDim.new(1, 0), b)
			local s = stroke(b, 0.82)
			local fill = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 1, Parent = b })
			corner(UDim.new(1, 0), fill)
			gradient(fill)
			local l = text({ Parent = b, Text = v, Font = "SemiBold", Size = 12, Color = "SubText", Auto = Enum.AutomaticSize.X, Sz = UDim2.fromOffset(0, 28), Z = 2 })
			padding(l, 0, 13, 0, 13)
			local sc = create("UIScale", { Parent = b })
			b.Activated:Connect(function()
				if e.Locked then
					return
				end
				tween(sc, { Scale = 0.92 }, 0.06)
				task.delay(0.07, function()
					tween(sc, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
				end)
				if e.Multi then
					local list4 = table.clone(e.Value)
					local idx = table.find(list4, v)
					if idx then
						table.remove(list4, idx)
					else
						table.insert(list4, v)
					end
					sfx(idx and "ToggleOff" or "ToggleOn", 1.2, 0.6)
					e:Set(list4)
				else
					sfx("Click")
					if e.Value == v then
						e:Set(nil)
					else
						e:Set(v)
					end
				end
			end)
			chips[v] = { Button = b, Fill = fill, Label = l, Stroke = s }
		end
		render(false)
	end
	function e:Set(value, silent)
		if self.Multi then
			local out = {}
			for _, v in ipairs(type(value) == "table" and value or {}) do
				table.insert(out, tostring(v))
			end
			self.Value = out
		else
			self.Value = value ~= nil and tostring(value) or nil
		end
		render(true)
		if not silent then
			self:_emit(self.Multi and table.clone(self.Value) or self.Value)
		end
	end
	function e:Refresh(options)
		self.Options = {}
		for _, v in ipairs(options or {}) do
			table.insert(self.Options, tostring(v))
		end
		build()
	end
	build()
	e.NoReset, e.NoCopy = false, false
	register(e, opts)
	return e
end
