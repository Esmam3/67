-- ======================================================================
-- Applying the theme
-- ======================================================================
local function applyFonts()
	for object, weight in pairs(FontObjects) do
		if object.Parent then
			pcall(function()
				object.FontFace = fontFace(weight)
			end)
		end
	end
end

local function applyShape()
	for c, base in pairs(Corners) do
		if c.Parent then
			c.CornerRadius = UDim.new(0, math.floor(base * Settings.Roundness + 0.5))
		end
	end
end

local function applyGlass(smooth)
	for object, base in pairs(Glass) do
		if object.Parent then
			paint(object, { BackgroundTransparency = base + (1 - base) * Settings.Transparency }, smooth, 0.2)
		end
	end
end

local function applyGradients()
	for g, slots in pairs(Gradients) do
		if g.Parent then
			g.Color = accentSequence(slots[1], slots[2])
		end
	end
end

local function applyTheme(smooth)
	derive()
	local pending = {}
	for slot, set in pairs(Bindings) do
		local value = Theme[slot]
		if value then
			for object, props in pairs(set) do
				if object.Parent then
					local entry = pending[object]
					if not entry then
						entry = {}
						pending[object] = entry
					end
					for prop in pairs(props) do
						entry[prop] = value
					end
				end
			end
		end
	end
	for object, props in pairs(pending) do
		paint(object, props, smooth, 0.3)
	end
	applyGradients()
	for _, fn in ipairs(Painters) do
		safeCall(fn, smooth)
	end
	Library.ThemeChanged:Fire()
end

-- Live edits (dragging a colour picker) repaint at most ~30 times a second.
local refreshQueued = false
local function queueRefresh()
	if refreshQueued then
		return
	end
	refreshQueued = true
	task.delay(0.03, function()
		refreshQueued = false
		applyTheme(false)
	end)
end

function Library:RefreshTheme(smooth)
	applyTheme(smooth)
end

