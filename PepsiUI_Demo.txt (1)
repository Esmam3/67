local function pageOf(self)
	local tab = rawget(self, "Tab") or self
	local page = rawget(self, "Page")
	if not page then
		page = tab.Pages[1] or newPage(tab.Window, tab, tab.Name)
		self.Page = page
	end
	return tab, page
end

