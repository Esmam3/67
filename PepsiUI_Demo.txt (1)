		create("UIGradient", { Transparency = NumberSequence.new(1, 0), Parent = alphaFill })
		alphaKnob = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1 - state.Alpha, 0.5), Size = UDim2.fromOffset(6, 18), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 10, Parent = alphaBar })
		corner(UDim.new(1, 0), alphaKnob)
		stroke(alphaKnob, 0.4, 1, Color3.new(0, 0, 0))
