local function sectionHeader(section, opts, parent)
	local hasDesc = opts.Description ~= nil
	local head = create("TextButton", {
		Name = "Header",
		AutoButtonColor = false,
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, hasDesc and 38 or 24),
		LayoutOrder = 0,
		ZIndex = 3,
		Parent = parent,
	})
	local x = 2
	if opts.Icon then
		local img, ok = icon(head, opts.Icon, 16, Color3.new(1, 1, 1), { Position = UDim2.fromOffset(2, 3), ZIndex = 3 })
		if ok then
			gradient(img, 45)
			x = 25
		else
			img:Destroy()
		end
	end
	local rightPad = opts.Collapsible and 30 or 4
	local title = text({ Parent = head, Text = section.Name, Font = "Bold", Size = 15, Pos = UDim2.fromOffset(x, 2), Sz = UDim2.new(1, -x - rightPad - 70, 0, 19), Truncate = true, Z = 3 })
	local desc
	if hasDesc then
		desc = text({ Parent = head, Text = tostring(opts.Description), Color = "SubText", Size = 12, Pos = UDim2.fromOffset(2, 21), Sz = UDim2.new(1, -rightPad - 4, 0, 15), Truncate = true, Z = 3 })
	end
	local badge = create("TextLabel", {
		Name = "Badge",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -rightPad, 0, 2),
		Size = UDim2.fromOffset(0, 19),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = "Element",
		Text = "",
		FontFace = "SemiBold",
		TextSize = 11,
		TextColor3 = "SubText",
		Visible = false,
		ZIndex = 4,
		Parent = head,
	})
	corner(UDim.new(1, 0), badge)
	padding(badge, 0, 8, 0, 8)
	local chevron
	if opts.Collapsible then
		chevron = icon(head, "chevron-down", 16, "SubText", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 3), ZIndex = 4 })
	end
	return head, title, desc, badge, chevron
end

local function newContainer(window, page, frame, parent, root)
	local container = setmetatable({
		Window = window,
		Page = page,
		Frame = frame,
		Elements = {},
		Count = 0,
		Container = parent,
		Kind = "Group",
	}, Section)
	container.Root = root or container
	container.RootSection = container.Root
	return container
end

function Tab:Section(opts)
	if type(opts) == "string" then
		opts = { Name = opts }
	end
	opts = opts or {}
	local tab, page = pageOf(self)
	local window = tab.Window
	page.Order += 1
	local side = opts.Side == "Right" and "Right" or (opts.Side == "Full" or opts.Full) and "Full" or "Left"
	if opts.Side == nil and not opts.Full then
		-- Alternate sides when you don't pick one.
		local left, right = 0, 0
		for _, s in ipairs(page.Sections) do
			if s.Side == "Left" then
				left += 1
			elseif s.Side == "Right" then
				right += 1
			end
		end
		side = right < left and "Right" or "Left"
	end
	local parent = side == "Full" and page.Full or ((side == "Right" and window.TwoColumns ~= false) and page.Right or page.Left)
	local frame = create("Frame", {
		Name = "Section_" .. tostring(opts.Name or ""),
		BackgroundColor3 = "Section",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = page.Order,
		ZIndex = 2,
		Parent = parent,
	})
	local plain = opts.Plain == true
	local frameStroke
	if plain then
		frame.BackgroundTransparency = 1
		unbind(frame, "BackgroundColor3")
	else
		glass(frame, 0.12)
		corner(14, frame)
		frameStroke = stroke(frame, 0.93)
		padding(frame, 12, 12, 12, 12)
	end
	list(frame, 6)
	local body = create("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ClipsDescendants = true,
		LayoutOrder = 1,
		ZIndex = 2,
		Parent = frame,
	})
	local bodyLayout = list(body, 6)
	local section = newContainer(window, page, body, nil, nil)
	section.Kind = "Section"
	section.Name = tostring(opts.Name or opts.Title or "")
	section.Side = side
	section.Shell = frame
	section.Body = body
	section.BodyLayout = bodyLayout
	section.Tab = tab
	section.IconName = opts.Icon
	section.AllElements = {}
	section.CardStroke = frameStroke
	section.Collapsible = opts.Collapsible == true
	section.Collapsed = false
	if section.Name ~= "" or opts.Icon then
		local head, title, desc, badge, chevron = sectionHeader(section, opts, frame)
		section.HeaderFrame, section.TitleLabel, section.DescLabel, section.BadgeLabel, section.Chevron = head, title, desc, badge, chevron
		if section.Collapsible then
			head.Activated:Connect(function()
				sfx("Click")
				section:Expand(section.Collapsed)
			end)
			head.MouseEnter:Connect(function()
				tween(chevron, { ImageColor3 = Theme.Text }, 0.15)
			end)
			head.MouseLeave:Connect(function()
				tween(chevron, { ImageColor3 = Theme.SubText }, 0.15)
			end)
		end
		if opts.Badge then
			section:SetBadge(opts.Badge)
		end
	end
	-- Sections keep their real frame in .Frame for layout moves, and put elements in the body.
	section.Frame = frame
	section.ElementParent = body
	table.insert(page.Sections, section)
	if opts.Collapsed then
		section:Expand(false, true)
	end
	return section
end
