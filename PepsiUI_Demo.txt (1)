	corner(7, swatch)
	stroke(swatch, 0.75)
	local solid = create("Frame", { Name = "Solid", Size = UDim2.fromScale(0.5, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 8, Parent = swatch })
	local alpha = create("Frame", { Name = "Alpha", Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0.5, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 8, Parent = swatch })
	return swatch, solid, alpha
