-- Shows a model (or your character) you can spin around.
function Section:Viewport(opts)
	opts = opts or {}
	local e = newBlock(self, "Viewport", opts)
	padding(e.Frame, 8, 8, 8, 8)
	local height = tonumber(opts.Height) or 180
	local vp = create("ViewportFrame", {
		BackgroundColor3 = "Field",
		Size = UDim2.new(1, 0, 0, height),
		Ambient = rgb(180, 180, 190),
		LightColor = rgb(255, 255, 255),
		LightDirection = Vector3.new(-1, -1, -0.5),
		Parent = e.Frame,
	})
	corner(8, vp)
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.Parent = vp
	vp.CurrentCamera = cam
	local model, angle, dragging = nil, 0, false
	local center, distance = Vector3.zero, 8
	local function load(object)
		if model then
			model:Destroy()
			model = nil
		end
		if object == nil or object == "Character" then
			object = LocalPlayer.Character
		end
		if typeof(object) ~= "Instance" then
			return
		end
		local ok, clone = pcall(function()
			local old = object.Archivable
			object.Archivable = true
			local c = object:Clone()
			object.Archivable = old
			return c
		end)
		if not ok or not clone then
			return
		end
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("Script") or d:IsA("LocalScript") then
				d:Destroy()
			end
		end
		clone.Parent = vp
		model = clone
		pcall(function()
			local cf, size = clone:GetBoundingBox()
			center = cf.Position
			distance = math.max(size.X, size.Y, size.Z) * 1.6 + 2
		end)
	end
	load(opts.Object or opts.Model)
	local hit = hitbox(vp, 3)
	hit.InputBegan:Connect(function(input)
		if not isPress(input) then
			return
		end
		dragging = true
		local start, startAngle = input.Position, angle
		local scroll = e.Page and e.Page.Scroll
		if scroll then
			scroll.ScrollingEnabled = false
		end
		startDrag(input, function(m)
			angle = startAngle + (m.Position.X - start.X) * 0.012
		end, function()
			dragging = false
			if scroll then
				scroll.ScrollingEnabled = true
			end
		end)
	end)
	Ticker.Add(function(dt)
		if not vp.Parent then
			return true
		end
		if not dragging and opts.Spin ~= false then
			angle += dt * 0.6
		end
		local pos = center + Vector3.new(math.sin(angle) * distance, distance * 0.15, math.cos(angle) * distance)
		cam.CFrame = CFrame.lookAt(pos, center)
	end)
	e.ViewportFrame = vp
	function e:SetObject(object)
		load(object)
	end
	e.Set = e.SetObject
	return e
end

