	local lock = icon(button, "lock", 13, "Dim", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Visible = false, ZIndex = 6 })
	local scale = create("UIScale", { Parent = img })
	tab.Button, tab.Label, tab.Icon, tab.IconGradient, tab.Letter, tab.BadgeLabel, tab.LockIcon, tab.Frame = button, label, img, iconGradient, letter, badge, lock, button

	function tab:Height()
		return TAB_H
	end
	function tab:SetCollapsed(collapsed)
		label.Visible = not collapsed
		if self.BadgeText then
			if collapsed then
				badge.Text = ""
				badge.Size = UDim2.fromOffset(8, 8)
				badge.AutomaticSize = Enum.AutomaticSize.None
				badge.AnchorPoint = Vector2.new(0.5, 0.5)
				badge.Position = UDim2.new(0, 33, 0, 9)
			else
				badge.Text = self.BadgeText
				badge.AutomaticSize = Enum.AutomaticSize.X
				badge.Size = UDim2.fromOffset(0, 18)
				badge.AnchorPoint = Vector2.new(1, 0.5)
				badge.Position = UDim2.new(1, -8, 0.5, 0)
			end
		end
	end

	local function paintTab(smooth)
		local selected = window.CurrentTab == tab
		paint(label, { TextColor3 = selected and Theme.Text or Theme.SubText }, smooth, 0.2)
		iconGradient.Enabled = selected
		paint(img, { ImageColor3 = selected and Color3.new(1, 1, 1) or Theme.SubText }, smooth, 0.2)
		if letter then
			paint(letter, { TextColor3 = selected and Theme.AccentA or Theme.SubText }, smooth, 0.2)
		end
		paint(button, { BackgroundTransparency = 1 }, smooth, 0.2)
	end
	tab.Paint = paintTab
	painter(function()
		paintTab(false)
	end)

	button.MouseEnter:Connect(function()
		sfx("Hover")
		if window.CurrentTab ~= tab then
			tween(button, { BackgroundTransparency = 0.6 }, 0.15)
			tween(label, { TextColor3 = Theme.Text }, 0.15)
			tween(img, { ImageColor3 = Theme.Text }, 0.15)
		end
		tween(scale, { Scale = 1.12 }, 0.2, Enum.EasingStyle.Back)
	end)
	button.MouseLeave:Connect(function()
		if window.CurrentTab ~= tab then
			paintTab(true)
		end
		tween(scale, { Scale = 1 }, 0.2)
	end)
	button.Activated:Connect(function()
		if tab.Locked then
			shake(button)
			sfx("Error")
			Library:Notify({ Title = tab.Name .. " is locked", Content = tab.LockReason or "This tab isn't available right now.", Type = "Warning", Duration = 3 })
			return
		end
		window:SelectTab(tab)
	end)
	attachTooltip(button, function()
		if window.Collapsed then
			return tab.Name .. (tab.Description ~= "" and ("\n<font color=\"#" .. toHex(Theme.SubText) .. "\">" .. tab.Description .. "</font>") or "")
		end
		return nil
	end)

	table.insert(self.Tabs, tab)
	table.insert(self.Entries, tab)
	if opts.Badge then
		tab:SetBadge(opts.Badge)
	end
	if opts.Locked then
		tab:SetLocked(true, opts.LockReason)
	end
	-- The first tab (or the one you had open last time) opens by itself.
	task.defer(function()
		if window.CurrentTab then
			return
		end
		local last = window.State.Tab
		if last and last ~= tab.Name then
			for _, t in ipairs(window.Tabs) do
				if t.Name == last then
					return
				end
			end
		end
		if last == tab.Name or #window.Tabs >= 1 then
			window:SelectTab(last == tab.Name and tab or window.Tabs[1])
		end
	end)
	return tab
end
