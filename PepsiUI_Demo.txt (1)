function Section:Textbox(opts)
	opts = opts or {}
	local multiline = opts.Multiline or opts.MultiLine
	local R = self.Window.RowHeight
	local e = newElement(self, "Textbox", opts, multiline and (R + 66) or nil)
	e.Value = tostring(opts.Default or opts.Value or "")
	local masked = opts.Password == true or opts.Masked == true
	local revealed = false
	local field = create("Frame", {
		Name = "Field",
		BackgroundColor3 = "Field",
		ZIndex = 4,
		Parent = e.Frame,
	})
	if multiline then
		field.Position = UDim2.new(0, 10, 0, e.TopHeight - 4)
		field.Size = UDim2.new(1, -20, 1, -(e.TopHeight + 6))
	else
		field.AnchorPoint = Vector2.new(1, 0.5)
		field.Position = UDim2.new(1, -10, 0, e.TopHeight / 2)
		field.Size = UDim2.new(0.55, -10, 0, R - 12)
		e.Title.Size = UDim2.new(0.45, -12, 0, 18)
		if e.Desc then
			e.Desc.Size = UDim2.new(0.45, -12, 0, 15)
		end
	end
	corner(8, field)
	local fieldStroke = stroke(field, 0.88)
	local rightPad = 8 + (masked and 22 or 0) + (opts.Clear ~= false and 20 or 0) + ((opts.MaxLength and not multiline) and 34 or 0)
	local box = create("TextBox", {
		Name = "Input",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, multiline and 6 or 0),
		Size = multiline and UDim2.new(1, -20, 1, -12) or UDim2.new(1, -10 - rightPad, 1, 0),
		FontFace = opts.Mono and "Mono" or "Medium",
		TextSize = 13,
		TextColor3 = "Text",
		PlaceholderText = tostring(opts.Placeholder or "Type here"),
		PlaceholderColor3 = "Dim",
		Text = e.Value,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
		ClearTextOnFocus = opts.ClearOnFocus == true or opts.ClearTextOnFocus == true,
		TextTruncate = multiline and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd,
		MultiLine = multiline == true,
		TextWrapped = multiline == true,
		ZIndex = 5,
		Parent = field,
	})
	local clearButton, eye, counter
	if opts.Clear ~= false and not multiline then
		clearButton = create("ImageButton", {
			Name = "Clear",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Image = iconId("x") or "",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, masked and -30 or -8, 0.5, 0),
			Size = UDim2.fromOffset(14, 14),
			ImageColor3 = Theme.Dim,
			Visible = false,
			ZIndex = 6,
			Parent = field,
		})
		bind(clearButton, "ImageColor3", "Dim")
	end
	if masked then
		eye = create("ImageButton", {
			Name = "Reveal",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Image = iconId("eye-off") or "",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.fromOffset(15, 15),
			ZIndex = 6,
			Parent = field,
		})
		bind(eye, "ImageColor3", "SubText")
	end
	if opts.MaxLength then
		-- Characters used / allowed, inside the field on the right.
		local x = -8 - (masked and 22 or 0) - (opts.Clear ~= false and 20 or 0)
		counter = text({ Parent = multiline and e.Frame or field, Text = "", Font = "Mono", Size = 10, Color = "Dim", XAlign = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0.5), Pos = multiline and UDim2.new(1, -12, 0, 18) or UDim2.new(1, x, 0.5, 0), Sz = UDim2.fromOffset(40, 12), Z = 6 })
	end
	local function display()
		if box:IsFocused() then
			return
		end
		if masked and not revealed and e.Value ~= "" then
			box.Text = string.rep("•", math.min(#e.Value, 24))
		else
			box.Text = e.Value
		end
		if clearButton then
			clearButton.Visible = e.Value ~= ""
		end
		if counter then
			counter.Text = #e.Value .. "/" .. opts.MaxLength
		end
	end
	local function invalid(message)
		sfx("Error", 1.1, 0.7)
		shake(field)
		fieldStroke.Color = Theme.Error
		fieldStroke.Transparency = 0.2
		tween(fieldStroke, { Transparency = 0.88 }, 0.8)
		task.delay(0.8, function()
			fieldStroke.Color = Theme.Stroke
		end)
		if message then
			Library:Notify({ Title = e.Name ~= "" and e.Name or "Input", Content = tostring(message), Type = "Warning", Duration = 3 })
		end
	end
	function e:Set(value, enter, silent)
		value = tostring(value or "")
		if opts.MaxLength then
			value = value:sub(1, opts.MaxLength)
		end
		if (opts.Numeric or opts.Number) and value ~= "" and not tonumber(value) then
			invalid()
			display()
			return false
		end
		if opts.Validate then
			local ok, okValue, message = pcall(opts.Validate, value)
			if ok and okValue == false then
				invalid(message)
				display()
				return false
			end
		end
		local changed = value ~= self.Value
		self.Value = value
		display()
		if (changed or enter) and not silent then
			if self.Flag then
				Library.Flags[self.Flag] = value
			end
			safeCall(self.Callback, value, enter)
			for _, fn in ipairs(self.Listeners) do
				safeCall(fn, value, enter)
			end
			Library.FlagChanged:Fire(self.Flag, value, self)
		end
		return true
	end
	function e:Focus()
		pcall(function()
			box:CaptureFocus()
		end)
	end
	box.Focused:Connect(function()
		tween(fieldStroke, { Color = Theme.AccentA, Transparency = 0.25 }, 0.15)
		tween(field, { BackgroundColor3 = Theme.Background }, 0.15)
		if masked and not revealed then
			box.Text = e.Value
		end
		sfx("Click", 1.2, 0.5)
	end)
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if not box:IsFocused() then
			return
		end
		if opts.MaxLength and #box.Text > opts.MaxLength then
			box.Text = box.Text:sub(1, opts.MaxLength)
		end
		if counter then
			counter.Text = #box.Text .. "/" .. opts.MaxLength
		end
		if clearButton then
			clearButton.Visible = box.Text ~= ""
		end
		sfx("Type")
		if opts.Live or opts.Instant then
			e:Set(box.Text)
		end
	end)
	box.FocusLost:Connect(function(enter)
		tween(fieldStroke, { Color = Theme.Stroke, Transparency = 0.88 }, 0.15)
		tween(field, { BackgroundColor3 = Theme.Field }, 0.15)
		if opts.Finished and not enter then
			display()
			return
		end
		local typed = box.Text
		task.defer(function()
			e:Set(typed, enter)
		end)
	end)
	if clearButton then
		clearButton.Activated:Connect(function()
			sfx("Back")
			e:Set("")
		end)
	end
	if eye then
		eye.Activated:Connect(function()
			revealed = not revealed
			setIcon(eye, revealed and "eye" or "eye-off")
			display()
		end)
	end
	e.Box = box
	register(e, opts)
	display()
	return e
end
