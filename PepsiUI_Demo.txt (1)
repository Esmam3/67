-- Shared logic for both the standalone picker and Toggle:AddColorpicker.
local function colorController(host, opts, swatch, solid, alphaPart, isInline)
	local default = fromHex(opts.Default or opts.Color) or Theme.AccentA
	local state = colorState(default, opts.Transparency)
	local picker = { State = state, Host = host, Value = default, Transparency = opts.Transparency, Listeners = {} }
	local panel
	local open = false
	local startColor
	local function show()
		local c = state.Color()
		solid.BackgroundColor3 = c
		alphaPart.BackgroundColor3 = c
		alphaPart.BackgroundTransparency = state.Alpha or 0
	end
	local function emit()
		picker.Value = state.Color()
		picker.Transparency = state.Alpha
		safeCall(opts.Callback, picker.Value, picker.Transparency)
		for _, fn in ipairs(picker.Listeners) do
			safeCall(fn, picker.Value, picker.Transparency)
		end
	end
	function picker.Changed(fromInput, released, rainbow)
		show()
		if panel and panel.IsOpen then
			panel.Render()
		end
		if state.Rainbow then
			RainbowPickers[picker] = true
		end
		emit()
	end
	local function ensurePanel()
		if not panel then
			panel = colorPanel(host, state, picker.Changed)
		end
		return panel
	end
	function picker.SetOpen(value)
		if host.OpenPanel and host.OpenPanel ~= picker then
			host.OpenPanel.SetOpen(false)
		end
		open = value
		local p = ensurePanel()
		p.SetOpen(open)
		host.OpenPanel = open and picker or nil
		host:_resize(open and (host.BaseHeight + p.Height + 6) or host.BaseHeight)
		if open then
			startColor = state.Color()
			sfx("Pop")
		else
			if startColor and toHex(startColor) ~= toHex(state.Color()) then
				pushRecent(state.Color())
			end
			sfx("Click", 0.9, 0.6)
		end
	end
	function picker.Set(color, alpha)
		color = fromHex(color)
		if not color then
			return
		end
		state.H, state.S, state.V = color:ToHSV()
		if alpha ~= nil and state.Alpha ~= nil then
			state.Alpha = math.clamp(tonumber(alpha) or 0, 0, 1)
		end
		state.Rainbow = false
		picker.Changed()
	end
	swatch.Activated:Connect(function()
		if host.Locked then
			return
		end
		picker.SetOpen(not open)
	end)
	local sc = create("UIScale", { Parent = swatch })
	swatch.MouseEnter:Connect(function()
		tween(sc, { Scale = 1.08 }, 0.15, Enum.EasingStyle.Back)
	end)
	swatch.MouseLeave:Connect(function()
		tween(sc, { Scale = 1 }, 0.15)
	end)
	if opts.Rainbow then
		state.Rainbow = true
		RainbowPickers[picker] = true
	end
	show()
	return picker
end

function Library._inlineColor(owner, parent, opts)
	local swatch, solid, alphaPart = swatchFrame(parent, 4)
	swatch.Size = UDim2.fromOffset(30, 20)
	local picker = colorController(owner, opts, swatch, solid, alphaPart, true)
	local api = { Type = "Colorpicker", Value = picker.Value, Transparency = picker.Transparency, Picker = picker }
	table.insert(picker.Listeners, function(c, a)
		api.Value, api.Transparency = c, a
		if api.Flag then
			Library.Flags[api.Flag] = c
		end
	end)
	function api:Set(c, a)
		picker.Set(c, a)
	end
	api.SetValue = api.Set
	api.SetValueRGB = api.Set
	function api:OnChanged(fn)
		table.insert(picker.Listeners, fn)
	end
	if opts.Flag then
		api.Flag = opts.Flag
		Library.Options[opts.Flag] = api
		Library.Flags[opts.Flag] = api.Value
	end
	api.Default = picker.Value
	return api
end

function Section:Colorpicker(opts)
	opts = opts or {}
	local e = newElement(self, "Colorpicker", opts)
	local right = rightGroup(e)
	local swatch, solid, alphaPart = swatchFrame(right, 10)
	reserve(e, 38)
	local hexLabel = text({ Parent = right, Text = "", Font = "Mono", Size = 11, Color = "Dim", XAlign = Enum.TextXAlignment.Right, Sz = UDim2.fromOffset(58, 14), Order = 5 })
	reserve(e, 58)
	local head = hitbox(e.Frame, 5, UDim2.new(1, 0, 0, e.TopHeight))
	attachContext(head, function()
		return e:ContextItems()
	end)
	local picker = colorController(e, opts, swatch, solid, alphaPart, false)
	e.Picker = picker
	e.Value = picker.Value
	e.Transparency = picker.Transparency
	local function sync(c, a)
		e.Value, e.Transparency = c, a
		hexLabel.Text = "#" .. toHex(c)
		if e.Flag then
			Library.Flags[e.Flag] = c
		end
		for _, fn in ipairs(e.Listeners) do
			safeCall(fn, c, a)
		end
		Library.FlagChanged:Fire(e.Flag, c, e)
	end
	table.insert(picker.Listeners, sync)
	hexLabel.Text = "#" .. toHex(e.Value)
	head.Activated:Connect(function()
		if e.Locked or recentLongPress() then
			return
		end
		picker.SetOpen(e.OpenPanel ~= picker)
	end)
	function e:Set(color, alpha)
		picker.Set(color, alpha)
	end
	e.SetValueRGB = e.Set
	function e:SetRainbow(on)
		picker.State.Rainbow = on == true
		picker.Changed()
	end
	register(e, opts)
	return e
end
Section.ColorPicker = Section.Colorpicker
Section.AddColorPicker = function(self, idx, opts)
	if type(idx) == "table" then
		return self:Colorpicker(idx)
	end
	opts = opts or {}
	opts.Flag = idx
	opts.Name = opts.Name or opts.Title or opts.Text
	return self:Colorpicker(opts)
end

-- ======================================================================
-- Blocks: elements that size themselves to their content
-- ======================================================================
local function newBlock(container, kind, opts, card)
	opts = opts or {}
	container.Count += 1
	local frame = create("Frame", {
		Name = kind,
		BackgroundColor3 = "Element",
		BackgroundTransparency = card == false and 1 or 0.45,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = container.Count,
		ClipsDescendants = true,
		Parent = container.ElementParent or container.Frame,
	})
	local s
	if card ~= false then
		corner(10, frame)
		s = stroke(frame, 0.95)
	else
		s = stroke(frame, 1)
	end
	local e = setmetatable({
		Type = kind,
		Name = tostring(opts.Name or opts.Title or ""),
		Frame = frame,
		Stroke = s,
		Indicator = create("Frame", { Name = "Indicator", BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0), Parent = frame }),
		Container = container,
		Section = container.Root,
		RootSection = container.Root,
		Page = container.Page,
		Window = container.Window,
		Height = 40,
		BaseHeight = 40,
		TopHeight = 40,
		Listeners = {},
		Opts = opts,
		Tooltip = opts.Tooltip,
		Auto = true,
		Hidden = false,
		NoReset = true,
		NoCopy = true,
	}, Element)
	e.Title = create("TextLabel", { Visible = false, Parent = frame })
	if card ~= false then
		frame.MouseEnter:Connect(function()
			tween(frame, { BackgroundTransparency = 0.3 }, 0.18)
		end)
		frame.MouseLeave:Connect(function()
			tween(frame, { BackgroundTransparency = 0.45 }, 0.18)
		end)
	end
	attachTooltip(frame, function()
		return e.Tooltip
	end)
	table.insert(container.Elements, e)
	if container.Root.AllElements then
		table.insert(container.Root.AllElements, e)
	end
	return e
end

-- Auto sized blocks just show or hide.
local baseSetVisible = Element.SetVisible
function Element:SetVisible(visible, instant)
	if self.Auto then
		self.Hidden = visible == false
		self.Frame.Visible = visible ~= false
		return
	end
	return baseSetVisible(self, visible, instant)
end

-- ======================================================================
-- Stepper: - value +
-- ======================================================================
function Section:Stepper(opts)
	opts = opts or {}
	local e = newElement(self, "Stepper", opts)
	local min, max = tonumber(opts.Min) or -math.huge, tonumber(opts.Max) or math.huge
	if min > max then
		min, max = max, min
	end
	local step = tonumber(opts.Step or opts.Increment) or 1
	local decimals = decimalsOf(step)
	e.Value = math.clamp(tonumber(opts.Default or opts.Value) or math.max(0, min), min, max)
	local right = rightGroup(e)
	local holder = create("Frame", { Name = "Stepper", BackgroundColor3 = "Field", Size = UDim2.fromOffset(112, 28), LayoutOrder = 10, ZIndex = 6, Parent = right })
	corner(9, holder)
	stroke(holder, 0.88)
	reserve(e, 112)
	local function sideButton(glyph, x, anchor)
		local b = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = "Element", BackgroundTransparency = 1, AnchorPoint = Vector2.new(anchor, 0), Position = UDim2.new(anchor, x, 0, 0), Size = UDim2.fromOffset(30, 28), ZIndex = 7, Parent = holder })
		corner(9, b)
		local img = icon(b, glyph, 14, "SubText", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 8 })
		b.MouseEnter:Connect(function()
			tween(b, { BackgroundTransparency = 0.3 }, 0.12)
			tween(img, { ImageColor3 = Theme.Text }, 0.12)
		end)
		b.MouseLeave:Connect(function()
			tween(b, { BackgroundTransparency = 1 }, 0.12)
			tween(img, { ImageColor3 = Theme.SubText }, 0.12)
		end)
		return b, img
	end
	local minus = sideButton("minus", 0, 0)
	local plus = sideButton("plus", 0, 1)
	local box = create("TextBox", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(30, 0),
		Size = UDim2.new(1, -60, 1, 0),
		FontFace = "Mono",
		TextSize = 13,
		TextColor3 = "Text",
		Text = "",
		ClearTextOnFocus = false,
		ZIndex = 7,
		Parent = holder,
	})
	local function label(v)
		local s = decimals > 0 and string.format("%." .. decimals .. "f", v) or tostring(math.floor(v + 0.5))
		return tostring(opts.Prefix or "") .. s .. tostring(opts.Suffix or "")
	end
	local scale = create("UIScale", { Parent = box })
	local function render(direction)
		box.Text = label(e.Value)
		if direction and Settings.Animations then
			box.Position = UDim2.fromOffset(30, direction * -6)
			tween(box, { Position = UDim2.fromOffset(30, 0) }, 0.2, Enum.EasingStyle.Back)
			scale.Scale = 1.15
			tween(scale, { Scale = 1 }, 0.2)
		end
	end
	function e:Set(value, silent)
		local v = math.clamp(round(tonumber(value) or self.Value, decimals), min, max)
		if v == self.Value then
			render()
			return
		end
		local direction = v > self.Value and 1 or -1
		self.Value = v
		render(direction)
		if not silent then
			self:_emit(v)
		end
	end
	local function repeater(button, delta)
		button.InputBegan:Connect(function(input)
			if not isPress(input) or e.Locked then
				return
			end
			local alive = true
			local conn
			conn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					alive = false
					conn:Disconnect()
				end
			end)
			e:Set(e.Value + delta)
			sfx("Click", delta > 0 and 1.1 or 0.9)
			task.spawn(function()
				task.wait(0.4)
				local wait = 0.12
				while alive and button.Parent do
					e:Set(e.Value + delta)
					sfx("Slide", delta > 0 and 1.3 or 1)
					task.wait(wait)
					wait = math.max(0.03, wait * 0.85)
				end
			end)
		end)
	end
	repeater(minus, -step)
	repeater(plus, step)
	box.FocusLost:Connect(function()
		local n = tonumber((box.Text:gsub("[^%d%.%-]", "")))
		if n then
			e:Set(n)
		else
			shake(holder)
		end
		render()
	end)
	register(e, opts)
	render()
	return e
end
Section.NumberInput = Section.Stepper

-- ======================================================================
-- Segmented control: a row of pills, one is picked
-- ======================================================================
function Section:Segmented(opts)
	opts = opts or {}
	local options = {}
	for _, v in ipairs(opts.Options or opts.Values or {}) do
		table.insert(options, tostring(v))
	end
	if #options == 0 then
		options = { "Off", "On" }
	end
	local textWidth = 0
	for _, v in ipairs(options) do
		textWidth = math.max(textWidth, measure(v, 12).X)
	end
	local segW = math.max(46, textWidth + 22)
	-- Short choices sit on the right of the title; longer ones get their own row.
	local inline = opts.Inline == true or (opts.Inline ~= false and #options <= 3 and segW * #options <= 130)
	local e = newElement(self, "Segmented", opts, (not inline) and (self.Window.RowHeight + 34) or nil)
	e.Options = options
	local default = opts.Default or opts.Value or options[1]
	if type(default) == "number" then
		default = options[default] or options[1]
	end
	e.Value = tostring(default)
	local bar = create("Frame", { Name = "Segments", BackgroundColor3 = "Field", ZIndex = 5, Parent = e.Frame })
	if inline then
		bar.AnchorPoint = Vector2.new(1, 0.5)
		bar.Position = UDim2.new(1, -10, 0, e.TopHeight / 2)
		bar.Size = UDim2.fromOffset(segW * #options + 6, 28)
		e.Title.Size = UDim2.new(1, -(segW * #options + 30), 0, 18)
	else
		bar.Position = UDim2.new(0, 10, 0, e.TopHeight - 4)
		bar.Size = UDim2.new(1, -20, 0, 30)
	end
	corner(9, bar)
	stroke(bar, 0.9)
	local hl = create("Frame", { Name = "Highlight", BackgroundColor3 = "AccentA", Size = UDim2.new(1 / #options, -4, 1, -6), Position = UDim2.new(0, 3, 0, 3), ZIndex = 5, Parent = bar })
	corner(7, hl)
	gradient(hl)
	local inner = create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(3, 0), Size = UDim2.new(1, -6, 1, 0), ZIndex = 6, Parent = bar })
	local labels = {}
	for i, v in ipairs(options) do
		local b = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundTransparency = 1, Position = UDim2.fromScale((i - 1) / #options, 0), Size = UDim2.fromScale(1 / #options, 1), ZIndex = 6, Parent = inner })
		local l = text({ Parent = b, Text = v, Font = "SemiBold", Size = 12, Color = "SubText", XAlign = Enum.TextXAlignment.Center, Sz = UDim2.fromScale(1, 1), Truncate = true, Z = 7 })
		labels[v] = l
		b.Activated:Connect(function()
			if e.Locked then
				return
			end
			if e.Value ~= v then
				sfx("Click")
			end
			e:Set(v)
		end)
		b.MouseEnter:Connect(function()
			if e.Value ~= v then
				tween(l, { TextColor3 = Theme.Text }, 0.12)
			end
		end)
		b.MouseLeave:Connect(function()
			if e.Value ~= v then
				tween(l, { TextColor3 = Theme.SubText }, 0.12)
			end
		end)
	end
	local function render(animate)
		local i = table.find(options, e.Value) or 1
		local target = UDim2.new((i - 1) / #options, 3 - (i - 1) * 6 / #options, 0, 3)
		if animate and Settings.Animations then
			tween(hl, { Position = target }, 0.35, Enum.EasingStyle.Back)
		else
			hl.Position = target
		end
		hl.Size = UDim2.new(1 / #options, -6 / #options, 1, -6)
		for v, l in pairs(labels) do
			paint(l, { TextColor3 = v == e.Value and Theme.OnAccent or Theme.SubText }, animate, 0.2)
		end
	end
	painter(function()
		render(false)
	end)
	function e:Set(value, silent)
		if type(value) == "number" then
			value = options[value]
		end
		value = tostring(value)
		if not table.find(options, value) or value == self.Value then
			return
		end
		self.Value = value
		render(true)
		if not silent then
			self:_emit(value)
		end
	end
	register(e, opts)
	render(false)
	return e
end
