-- ======================================================================
-- Configs (per game): every element with a Flag is saved
-- ======================================================================
local function encodeValue(element)
	local v = element.Value
	if element.Type == "Colorpicker" and typeof(v) == "Color3" then
		return { t = "color", v = toHex(v), a = element.Transparency }
	elseif element.Type == "Keybind" then
		local core = element.Core
		return { t = "key", v = (typeof(v) == "EnumItem") and v.Name or nil, m = core and core.Mode or element.Mode }
	elseif typeof(v) == "Color3" then
		return { t = "color", v = toHex(v) }
	elseif type(v) == "table" then
		local out = {}
		for i, x in ipairs(v) do
			out[i] = x
		end
		return { t = "list", v = out }
	end
	return { t = "value", v = v }
end

local function decodeValue(element, data)
	if type(data) ~= "table" or not element.Set then
		return
	end
	if data.t == "color" then
		local c = fromHex(data.v)
		if c then
			element:Set(c, data.a)
		end
	elseif data.t == "key" then
		element:Set(data.v)
		if data.m and element.SetMode then
			element:SetMode(data.m)
		end
	elseif data.t == "list" then
		element:Set(data.v)
	else
		element:Set(data.v)
	end
end

local function cleanName(name)
	return (tostring(name or ""):gsub("[^%w%s%-_]", ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

function Window:ConfigData()
	local data = {}
	for flag, element in pairs(Library.Options) do
		if not element.NoSave and element.Type and element.Set then
			data[flag] = encodeValue(element)
		end
	end
	return data
end

function Window:ApplyConfigData(data)
	if type(data) ~= "table" then
		return false
	end
	local count = 0
	for flag, value in pairs(data) do
		local element = Library.Options[flag]
		if element and not element.NoSave then
			local ok = pcall(decodeValue, element, value)
			if ok then
				count += 1
			end
		end
	end
	return true, count
end

function Window:ConfigList()
	local names = {}
	if not canFiles() or type(listfiles) ~= "function" then
		return names
	end
	ensureFolder(self.ConfigFolder)
	local ok, files = pcall(listfiles, self.ConfigFolder)
	if not ok or type(files) ~= "table" then
		return names
	end
	for _, path in ipairs(files) do
		local name = tostring(path):match("([^/\\]+)%.json$")
		if name then
			table.insert(names, name)
		end
	end
	table.sort(names)
	return names
end

function Window:SaveConfig(name)
	name = cleanName(name)
	if name == "" or not canFiles() then
		return false
	end
	return writeJSON(self.ConfigFolder .. "/" .. name .. ".json", { Flags = self:ConfigData(), Saved = os.time(), Version = Library.Version })
end

function Window:LoadConfig(name)
	local data = readJSON(self.ConfigFolder .. "/" .. cleanName(name) .. ".json")
	if not data then
		return false
	end
	return self:ApplyConfigData(data.Flags or data)
end

function Window:DeleteConfig(name)
	local path = self.ConfigFolder .. "/" .. cleanName(name) .. ".json"
	if canFiles() and type(delfile) == "function" then
		local ok = pcall(delfile, path)
		return ok
	end
	return false
end

function Window:SetAutoload(name)
	if not canFiles() then
		return
	end
	ensureFolder(self.ConfigFolder)
	if name then
		pcall(writefile, self.ConfigFolder .. "/autoload.txt", cleanName(name))
	elseif type(delfile) == "function" then
		pcall(delfile, self.ConfigFolder .. "/autoload.txt")
	end
end

function Window:GetAutoload()
	if not canFiles() then
		return nil
	end
	local path = self.ConfigFolder .. "/autoload.txt"
	local okExists, exists = pcall(isfile, path)
	if not okExists or not exists then
		return nil
	end
	local ok, name = pcall(readfile, path)
	return ok and name ~= "" and name or nil
end

-- Call this after building your tabs.
function Window:LoadAutoload()
	local name = self:GetAutoload()
	if name and self:LoadConfig(name) then
		Library:Notify({ Title = "Config loaded", Content = "Autoloaded \"" .. name .. "\".", Type = "Success", Duration = 3 })
		return true
	end
	return false
end
Window.LoadAutoloadConfig = Window.LoadAutoload

function Window:ExportConfig()
	return HttpService:JSONEncode({ PepsiConfig = self:ConfigData(), Game = game.PlaceId })
end

function Window:ImportConfig(textValue)
	local ok, data = pcall(function()
		return HttpService:JSONDecode(tostring(textValue))
	end)
	if not ok or type(data) ~= "table" then
		return false
	end
	return self:ApplyConfigData(data.PepsiConfig or data.Flags or data)
end

function Window:ResetConfig()
	for _, element in pairs(Library.Options) do
		if not element.NoSave and element.Reset then
			pcall(element.Reset, element)
		end
	end
end

-- ======================================================================
-- Server helpers
-- ======================================================================
function Library:Rejoin()
	pcall(function()
		if #Players:GetPlayers() <= 1 then
			TeleportService:Teleport(game.PlaceId, LocalPlayer)
		else
			TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
		end
	end)
end

function Library:ServerHop()
	local ok, err = pcall(function()
		local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true"
		local data = HttpService:JSONDecode(game:HttpGet(url))
		local choices = {}
		for _, server in ipairs(data.data or {}) do
			if server.id ~= game.JobId and (server.playing or 0) < (server.maxPlayers or 0) then
				table.insert(choices, server.id)
			end
		end
		if #choices == 0 then
			error("no other servers found")
		end
		TeleportService:TeleportToPlaceInstance(game.PlaceId, choices[math.random(1, #choices)], LocalPlayer)
	end)
	if not ok then
		Library:Notify({ Title = "Server hop", Content = "Couldn't find a server: " .. tostring(err):gsub("^.-:%d+: ", ""), Type = "Warning" })
	end
	return ok
end

