-- Fold or unfold a section (or a sub-settings group).
function Section:Expand(open, instant)
	if open == not self.Collapsed and not instant then
		return
	end
	local body = self.Body or self.Frame
	local layout = self.BodyLayout
	self.Collapsed = not open
	if self.Chevron then
		tween(self.Chevron, { Rotation = open and 0 or -90 }, instant and 0 or 0.3)
	end
	local ratio = self.Window:Ratio()
	local contentH = layout and (layout.AbsoluteContentSize.Y / ratio) or 0
	if contentH <= 0 then
		contentH = 0
		for _, e in ipairs(self.Elements) do
			if e.Frame.Visible then
				contentH += (e.Height or 40) + 6
			end
		end
	end
	self.ExpandToken = (self.ExpandToken or 0) + 1
	local token = self.ExpandToken
	if instant or not Settings.Animations then
		body.AutomaticSize = open and Enum.AutomaticSize.Y or Enum.AutomaticSize.None
		body.Size = UDim2.new(1, 0, 0, 0)
		body.Visible = open
		return
	end
	if open then
		body.Visible = true
		body.AutomaticSize = Enum.AutomaticSize.None
		body.Size = UDim2.new(1, 0, 0, 0)
		tween(body, { Size = UDim2.new(1, 0, 0, contentH) }, 0.32)
		task.delay(0.33, function()
			if self.ExpandToken == token and not self.Collapsed then
				body.AutomaticSize = Enum.AutomaticSize.Y
				body.Size = UDim2.new(1, 0, 0, 0)
			end
		end)
	else
		body.AutomaticSize = Enum.AutomaticSize.None
		body.Size = UDim2.new(1, 0, 0, contentH)
		tween(body, { Size = UDim2.new(1, 0, 0, 0) }, 0.28)
		task.delay(0.29, function()
			if self.ExpandToken == token and self.Collapsed then
				body.Visible = false
			end
		end)
	end
end

function Section:Collapse()
	self:Expand(false)
end

function Section:SetBadge(value)
	local badge = self.BadgeLabel
	if not badge then
