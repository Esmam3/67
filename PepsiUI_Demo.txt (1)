function Tab:TabBox(opts)
	opts = type(opts) == "string" and { Name = opts } or (opts or {})
	local section = self:Section({ Name = opts.Name, Icon = opts.Icon, Side = opts.Side, Description = opts.Description })
	local window = section.Window
	local bar = create("Frame", {
		Name = "TabBar",
		BackgroundColor3 = "Field",
		BackgroundTransparency = 0.3,
		Size = UDim2.new(1, 0, 0, 32),
		LayoutOrder = 0,
		Parent = section.Body,
	})
	corner(10, bar)
	stroke(bar, 0.94)
	local hl = create("Frame", { Name = "Highlight", BackgroundColor3 = "Element", Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -6, 1, -6), Parent = bar })
	corner(8, hl)
	stroke(hl, 0.88)
	local pills = create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(3, 0), Size = UDim2.new(1, -6, 1, 0), Parent = bar })
	local box = { Section = section, Tabs = {}, Bar = bar }
	-- Every pill is the same width, so positions are simple fractions.
	local function layout(animate)
		local n = math.max(1, #box.Tabs)
		for i, t in ipairs(box.Tabs) do
			t.Pill.Position = UDim2.fromScale((i - 1) / n, 0)
			t.Pill.Size = UDim2.fromScale(1 / n, 1)
			if t == box.Current then
				local target = { Position = UDim2.new((i - 1) / n, 3, 0, 3), Size = UDim2.new(1 / n, i == n and -6 or -3, 1, -6) }
				if animate then
					tween(hl, target, 0.32, Enum.EasingStyle.Back)
				else
					setProps(hl, target)
				end
			end
		end
	end
	local function selectBox(entry)
		local animate = box.Current ~= nil
		for _, t in ipairs(box.Tabs) do
			t.Frame.Visible = t == entry
			tween(t.Label, { TextColor3 = t == entry and Theme.Text or Theme.SubText }, 0.15)
		end
		box.Current = entry
		layout(animate)
	end
	function box:Tab(name)
		name = type(name) == "table" and (name.Name or name.Title) or tostring(name)
		local pill = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = pills })
		local label = text({ Parent = pill, Text = name, Font = "SemiBold", Size = 12, Color = "SubText", XAlign = Enum.TextXAlignment.Center, Sz = UDim2.fromScale(1, 1), Truncate = true })
		local frame = create("Frame", { Name = "Box_" .. name, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Visible = false, Parent = section.Body })
		list(frame, 6)
		local container = newContainer(window, section.Page, frame, section, section)
		container.Name = name
		local entry = { Pill = pill, Label = label, Frame = frame, Container = container }
		container.Expand = function()
			selectBox(entry)
		end
		table.insert(self.Tabs, entry)
		pill.Activated:Connect(function()
			if box.Current ~= entry then
				sfx("Click")
			end
			selectBox(entry)
		end)
		if #self.Tabs == 1 then
			selectBox(entry)
		else
			layout(false)
		end
		return container
	end
	box.AddTab = box.Tab
	return box
end
Tab.AddTabbox = Tab.TabBox
Tab.AddLeftTabbox = function(self, name)
	return self:TabBox({ Name = name, Side = "Left" })
end
Tab.AddRightTabbox = function(self, name)
	return self:TabBox({ Name = name, Side = "Right" })
end

-- ======================================================================
-- Elements: what every element shares
-- ======================================================================
local Element = {}
Element.__index = Element
Library.ElementClass = Element
Library.FlagChanged = Signal.new()

local function deepCopy(v)
	if typeof(v) ~= "table" then
		return v
	end
	local t = {}
	for k, x in pairs(v) do
		t[k] = deepCopy(x)
	end
	return t
end

local function recentLongPress()
	return os.clock() - (Context.LongPressAt or 0) < 0.8
end

local function newElement(container, kind, opts, height)
	opts = opts or {}
	local window = container.Window
	container.Count += 1
	local base = window.RowHeight
	local description = opts.Description or opts.Desc
	if description == "" then
		description = nil
	end
	local top = description and base + 16 or base
	local h = height and (height + (top - base)) or top
	local frame = create("Frame", {
		Name = kind .. "_" .. tostring(opts.Name or opts.Title or opts.Text or ""),
		Size = UDim2.new(1, 0, 0, h),
		BackgroundColor3 = "Element",
		BackgroundTransparency = 0.45,
		LayoutOrder = container.Count,
		ClipsDescendants = true,
		Parent = container.ElementParent or container.Frame,
	})
	corner(10, frame)
	local s = stroke(frame, 0.95)
	local indicator = create("Frame", {
		Name = "Indicator",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0, top / 2),
		Size = UDim2.fromOffset(2, 0),
		BackgroundColor3 = "AccentA",
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = frame,
	})
	corner(UDim.new(1, 0), indicator)
	gradient(indicator, 90)
	local name = tostring(opts.Name or opts.Title or opts.Text or "")
	local title = text({
		Parent = frame,
		Name = "Title",
		Text = name,
		Font = "SemiBold",
		Size = 14,
		Rich = true,
		Pos = UDim2.fromOffset(12, description and 8 or (base - 18) / 2),
		Sz = UDim2.new(1, -24, 0, 18),
		Truncate = true,
		Z = 2,
	})
	local desc
	if description then
		desc = text({ Parent = frame, Name = "Description", Text = tostring(description), Color = "SubText", Size = 12, Rich = true, Pos = UDim2.fromOffset(12, 27), Sz = UDim2.new(1, -24, 0, 15), Truncate = true, Z = 2 })
	end
	local e = setmetatable({
		Type = kind,
		Name = name,
		Frame = frame,
		Title = title,
		Desc = desc,
		Stroke = s,
		Indicator = indicator,
		Container = container,
		Section = container.Root,
		RootSection = container.Root,
		Page = container.Page,
		Window = window,
		Height = h,
		BaseHeight = h,
		TopHeight = top,
		Listeners = {},
		Dependents = {},
		Opts = opts,
		Tooltip = opts.Tooltip,
		DescriptionText = description and tostring(description) or nil,
		Callback = opts.Callback or opts.Changed,
		Hidden = false,
	}, Element)
	frame.MouseEnter:Connect(function()
		e:SetHover(true)
	end)
	frame.MouseLeave:Connect(function()
		e:SetHover(false)
	end)
	attachTooltip(frame, function()
		return e.Tooltip
	end)
	attachContext(frame, function()
		return e:ContextItems()
	end)
	table.insert(container.Elements, e)
	if container.Root.AllElements then
		table.insert(container.Root.AllElements, e)
	end
	if opts.Visible == false then
		e:SetVisible(false, true)
	end
	return e
end

local function register(e, opts)
	local flag = opts.Flag or opts.Idx or opts.Id
	e.Flag = flag
	if flag then
		Library.Options[flag] = e
		if e.Type == "Toggle" then
			Library.Toggles[flag] = e
		end
		Library.Flags[flag] = e.Value
	end
	e.Default = deepCopy(e.Value)
	if opts.Locked or opts.Disabled then
		e:SetLocked(true, type(opts.Locked) == "string" and opts.Locked or opts.LockReason)
	end
	if opts.DependsOn then
		e:DependsOn(opts.DependsOn, opts.DependsValue)
	end
	if opts.NoSave or opts.Save == false then
		e.NoSave = true
	end
	return e
end

-- A button over the whole row, above the labels.
local function hitbox(parent, z, size, pos)
	return create("TextButton", {
		Name = "Hit",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Text = "",
		Size = size or UDim2.fromScale(1, 1),
		Position = pos or UDim2.new(),
		ZIndex = z or 5,
		Parent = parent,
	})
end

function Element:_emit(value)
	if self.Flag then
		Library.Flags[self.Flag] = value
	end
	safeCall(self.Callback, value)
	for _, fn in ipairs(self.Listeners) do
		safeCall(fn, value)
	end
	Library.FlagChanged:Fire(self.Flag, value, self)
end

function Element:OnChanged(fn)
	table.insert(self.Listeners, fn)
	return self
end
Element.Changed = Element.OnChanged

function Element:Get()
	return self.Value
end
Element.GetValue = Element.Get

function Element:SetValue(...)
	if self.Set then
		return self:Set(...)
	end
end

function Element:Reset()
	if self.Set and self.Default ~= nil then
		self:Set(deepCopy(self.Default))
	end
end

function Element:ValueText()
	local v = self.Value
	if typeof(v) == "Color3" then
		return "#" .. toHex(v)
	elseif typeof(v) == "EnumItem" then
		return keyName(v)
	elseif type(v) == "table" then
		local parts = {}
		for _, x in ipairs(v) do
			table.insert(parts, tostring(x))
		end
		return table.concat(parts, self.Type == "RangeSlider" and " - " or ", ")
	end
	return tostring(v)
end

function Element:SetHover(on)
	if self.Locked or (Library.Mobile and on) then
		return
	end
	self.Hovering = on
	tween(self.Frame, { BackgroundTransparency = on and 0.12 or 0.45, BackgroundColor3 = on and Theme.ElementHover or Theme.Element }, 0.18)
	tween(self.Stroke, { Transparency = on and 0.88 or 0.95 }, 0.18)
	tween(self.Indicator, { Size = UDim2.fromOffset(2, on and 16 or 0) }, on and 0.3 or 0.2, on and Enum.EasingStyle.Back or Enum.EasingStyle.Quint)
end

function Element:SetTitle(t)
	self.Name = tostring(t)
	self.Title.Text = self.Name
end
Element.SetText = Element.SetTitle

function Element:SetDescription(t)
	self.DescriptionText = tostring(t)
	if self.Desc then
		self.Desc.Text = self.DescriptionText
	end
end

function Element:SetTooltip(t)
	self.Tooltip = t
end

-- Height changes (dropdown opening, panels...) go through here.
function Element:_resize(h, animate)
	self.Height = h
	if self.Hidden then
		return
	end
	tween(self.Frame, { Size = UDim2.new(1, 0, 0, h) }, animate == false and 0 or 0.3)
end

function Element:SetVisible(visible, instant)
	visible = visible ~= false
	if self.Hidden == not visible and not instant then
		return
	end
	self.Hidden = not visible
	local frame = self.Frame
	if instant or not Settings.Animations then
		frame.Visible = visible
		frame.Size = UDim2.new(1, 0, 0, self.Height)
		return
	end
	if visible then
		frame.Visible = true
		frame.Size = UDim2.new(1, 0, 0, 0)
		tween(frame, { Size = UDim2.new(1, 0, 0, self.Height) }, 0.28)
	else
		tween(frame, { Size = UDim2.new(1, 0, 0, 0) }, 0.22)
		task.delay(0.23, function()
			if self.Hidden then
				frame.Visible = false
			end
		end)
	end
end

function Element:DependsOn(target, want)
	if not target or not target.OnChanged then
		return self
	end
	if want == nil then
		want = true
	end
	local function matches()
		local v = target.Value
		if type(want) == "function" then
			return want(v) == true
		elseif type(v) == "table" then
			return table.find(v, want) ~= nil
		end
		return v == want
	end
	target:OnChanged(function()
		self:SetVisible(matches())
	end)
	self:SetVisible(matches(), true)
	return self
end

function Element:SetLocked(locked, reason)
	self.Locked = locked == true
	self.LockReason = reason
	if self.Locked then
		self:SetHover(false)
		if not self.LockOverlay then
			local overlayButton = create("TextButton", {
				Name = "Lock",
				AutoButtonColor = false,
				Text = "",
				BackgroundColor3 = "Section",
				BackgroundTransparency = 0.22,
				Size = UDim2.fromScale(1, 1),
				ZIndex = 30,
				Parent = self.Frame,
			})
			corner(10, overlayButton)
			local tag = create("Frame", { Name = "Tag", BackgroundColor3 = "Field", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0, self.TopHeight / 2), Size = UDim2.fromOffset(0, 24), AutomaticSize = Enum.AutomaticSize.X, ZIndex = 31, Parent = overlayButton })
			corner(UDim.new(1, 0), tag)
			stroke(tag, 0.85)
			padding(tag, 0, 10, 0, 8)
			list(tag, 5, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
			local img = icon(tag, "lock", 12, "SubText", { LayoutOrder = 1, ZIndex = 32 })
			text({ Parent = tag, Text = "Locked", Font = "SemiBold", Size = 11, Color = "SubText", Auto = Enum.AutomaticSize.X, Sz = UDim2.fromOffset(0, 14), Order = 2, Z = 32 })
			overlayButton.Activated:Connect(function()
				sfx("Error")
				shake(img)
				if self.LockReason then
					Library:Notify({ Title = self.Name, Content = self.LockReason, Type = "Warning", Duration = 3 })
				end
			end)
			self.LockOverlay = overlayButton
		end
		self.LockOverlay.Visible = true
	elseif self.LockOverlay then
		self.LockOverlay.Visible = false
	end
end
function Element:SetDisabled(disabled)
	self:SetLocked(disabled, nil)
end
function Element:SetEnabled(enabled)
	self:SetLocked(not enabled, nil)
end

function Element:Highlight()
	local s = self.Stroke
	s.Color = Theme.AccentA
	s.Transparency = 0
	s.Thickness = 1.5
	tween(s, { Transparency = 0.95 }, 1.6, Enum.EasingStyle.Quad)
	self.Frame.BackgroundColor3 = Theme.ElementHover
	self.Frame.BackgroundTransparency = 0
	tween(self.Frame, { BackgroundTransparency = 0.45, BackgroundColor3 = Theme.Element }, 1.2, Enum.EasingStyle.Quad)
	task.delay(1.6, function()
		s.Thickness = 1
		s.Color = Theme.Stroke
	end)
	sfx("Pop")
end

function Element:Destroy()
	self.Destroyed = true
	if self.Flag then
		Library.Options[self.Flag] = nil
		Library.Toggles[self.Flag] = nil
		Library.Flags[self.Flag] = nil
	end
	local list1 = self.Container.Elements
	local i = table.find(list1, self)
	if i then
		table.remove(list1, i)
	end
	local all = self.RootSection.AllElements
	if all then
		local j = table.find(all, self)
		if j then
			table.remove(all, j)
		end
	end
	self.Frame:Destroy()
end

function Element:ContextItems()
	local items = {}
	local info = self.Tooltip or self.DescriptionText
	table.insert(items, { Header = self.Name ~= "" and self.Name or self.Type, Text = info })
	if self.Set and self.Default ~= nil and not self.NoReset then
		table.insert(items, { Name = "Reset to default", Icon = "rotate-ccw", Callback = function()
			self:Reset()
			sfx("Back")
		end })
	end
	if self.Value ~= nil and self.Set and not self.NoCopy then
		table.insert(items, { Name = "Copy value", Icon = "copy", Callback = function()
			Library.ValueClipboard = { Type = self.Type, Value = deepCopy(self.Value) }
			copyText(self:ValueText())
			Library:Notify({ Title = "Copied", Content = self.Name .. ": " .. self:ValueText(), Duration = 2, Silent = false })
		end })
		local clip = Library.ValueClipboard
		local can = clip ~= nil and clip.Type == self.Type
		table.insert(items, { Name = "Paste value", Icon = "clipboard-paste", Disabled = not can, Callback = function()
			if can then
				self:Set(deepCopy(clip.Value))
			end
		end })
	end
	if self.Flag then
		table.insert(items, { Name = "Copy flag name", Icon = "hash", Hint = self.Flag:sub(1, 8), Callback = function()
			copyText(self.Flag)
		end })
	end
	for _, extra in ipairs(self.ExtraContext or {}) do
		table.insert(items, extra)
	end
	if #items == 1 and not info then
		return nil
	end
	return items
end

-- Right side of a row (switches, pills, swatches) laid out right to left.
local function rightGroup(e)
	local group = create("Frame", {
		Name = "Right",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0, e.TopHeight / 2),
		Size = UDim2.fromOffset(0, 28),
		AutomaticSize = Enum.AutomaticSize.X,
		ZIndex = 6,
		Parent = e.Frame,
	})
	list(group, 6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	e.Right = group
	e.RightWidth = 0
	return group
end

local function reserve(e, width)
	e.RightWidth = (e.RightWidth or 0) + width + (e.RightWidth and e.RightWidth > 0 and 6 or 0)
	e.Title.Size = UDim2.new(1, -24 - e.RightWidth - 6, 0, 18)
	if e.Desc then
		e.Desc.Size = UDim2.new(1, -24 - e.RightWidth - 6, 0, 15)
	end
end

-- ======================================================================
-- Toggle
-- ======================================================================
function Section:Toggle(opts)
	opts = opts or {}
	local e = newElement(self, "Toggle", opts)
	local checkbox = opts.Style == "Checkbox" or opts.Checkbox == true
	e.Value = opts.Default == true or opts.Value == true
	if opts.Risky then
		bind(e.Title, "TextColor3", "Warning")
	end
	local right = rightGroup(e)
	local track, fill, knob, check, checkScale, trackStroke
	if checkbox then
		track = create("Frame", { Name = "Box", Size = UDim2.fromOffset(22, 22), BackgroundColor3 = "Field", LayoutOrder = 100, ZIndex = 6, Parent = right })
		corner(7, track)
		trackStroke = stroke(track, 0.8)
		fill = create("Frame", { Name = "Fill", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 6, Parent = track })
		corner(7, fill)
		gradient(fill, 45)
		check = icon(fill, "check", 15, "OnAccent", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 7 })
		checkScale = create("UIScale", { Scale = 0, Parent = check })
		reserve(e, 22)
	else
		track = create("Frame", { Name = "Switch", Size = UDim2.fromOffset(42, 24), BackgroundColor3 = "Field", LayoutOrder = 100, ZIndex = 6, Parent = right })
		corner(UDim.new(1, 0), track)
		trackStroke = stroke(track, 0.86)
		fill = create("Frame", { Name = "Fill", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 6, Parent = track })
		corner(UDim.new(1, 0), fill)
		gradient(fill)
		local shadow = create("Frame", { Name = "KnobShadow", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 1), Size = UDim2.fromOffset(18, 18), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.75, ZIndex = 7, Parent = track })
		corner(UDim.new(1, 0), shadow)
		knob = create("Frame", { Name = "Knob", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(18, 18), BackgroundColor3 = "SubText", ZIndex = 8, Parent = track })
		corner(UDim.new(1, 0), knob)
		e.KnobShadow = shadow
		reserve(e, 42)
	end
	e.Track, e.Knob, e.Fill = track, knob, fill
	local function render(animate)
		local on = e.Value
		local t = animate and 0.25 or 0
		paint(fill, { BackgroundTransparency = on and 0 or 1 }, animate, t)
		paint(trackStroke, { Transparency = on and 1 or (checkbox and 0.8 or 0.86) }, animate, t)
		if checkbox then
			if animate then
				tween(checkScale, { Scale = on and 1 or 0 }, on and 0.35 or 0.15, on and Enum.EasingStyle.Back or Enum.EasingStyle.Quint)
			else
				checkScale.Scale = on and 1 or 0
			end
			return
		end
		local x = on and 21 or 3
		local color = on and Color3.new(1, 1, 1) or Theme.SubText
		if animate and Settings.Animations then
			-- The knob stretches while it moves, then snaps into place.
			tween(knob, { Size = UDim2.fromOffset(24, 18), Position = UDim2.new(0, on and 15 or 3, 0.5, 0), BackgroundColor3 = color }, 0.12, Enum.EasingStyle.Quad)
			tween(e.KnobShadow, { Size = UDim2.fromOffset(24, 18), Position = UDim2.new(0, on and 15 or 3, 0.5, 1) }, 0.12, Enum.EasingStyle.Quad)
			task.delay(0.12, function()
				if e.Value == on then
					tween(knob, { Size = UDim2.fromOffset(18, 18), Position = UDim2.new(0, x, 0.5, 0) }, 0.3, Enum.EasingStyle.Back)
					tween(e.KnobShadow, { Size = UDim2.fromOffset(18, 18), Position = UDim2.new(0, x, 0.5, 1) }, 0.3, Enum.EasingStyle.Back)
				end
			end)
		else
			knob.Size = UDim2.fromOffset(18, 18)
			knob.Position = UDim2.new(0, x, 0.5, 0)
			knob.BackgroundColor3 = color
			e.KnobShadow.Position = UDim2.new(0, x, 0.5, 1)
		end
	end
	e.Render = render
	painter(function()
		render(false)
	end)
	function e:Set(value, silent)
		value = value == true
		if value == self.Value then
			return
		end
		self.Value = value
		render(true)
		if not silent then
			self:_emit(value)
		elseif self.Flag then
			Library.Flags[self.Flag] = value
		end
	end
	local hit = hitbox(e.Frame, 5, UDim2.new(1, 0, 0, e.TopHeight))
	attachContext(hit, function()
		return e:ContextItems()
	end)
	hit.InputBegan:Connect(function(input)
		if isPress(input) and knob then
			tween(knob, { Size = UDim2.fromOffset(22, 18) }, 0.1)
		end
	end)
	hit.InputEnded:Connect(function(input)
		if isPress(input) and knob then
			tween(knob, { Size = UDim2.fromOffset(18, 18) }, 0.25, Enum.EasingStyle.Back)
		end
	end)
	hit.Activated:Connect(function(input)
		if e.Locked or recentLongPress() then
			return
		end
		e:Set(not e.Value)
		sfx(e.Value and "ToggleOn" or "ToggleOff")
		ripple(e.Frame, input, e.Value and Theme.AccentA or nil)
	end)
	e.Hit = hit

	-- Little extras on the right: a keybind, a colour, a gear for more settings.
	function e:AddKeybind(kopts)
		kopts = kopts or {}
		local kb = Library._inlineKeybind(e, right, kopts)
		reserve(e, kb.Width)
		return kb
	end
	function e:AddColorpicker(copts)
		copts = copts or {}
		local cp = Library._inlineColor(e, right, copts)
		reserve(e, 26)
		return cp
	end
	e.AddColorPicker = e.AddColorpicker
	function e:Settings(sopts)
		if self.SettingsGroup then
			return self.SettingsGroup
		end
		sopts = sopts or {}
		local gear = create("ImageButton", { Name = "Gear", AutoButtonColor = false, BackgroundTransparency = 1, Image = iconId("settings-2") or "", ImageColor3 = Theme.SubText, Size = UDim2.fromOffset(17, 17), LayoutOrder = 1, ZIndex = 7, Parent = right })
		bind(gear, "ImageColor3", "SubText")
