local SETTINGS_PATH = Library.Folder .. "/settings.json"
Library.WindowState = {}

function Library:SaveSettings()
	local data = { Settings = {}, ThemeColors = {}, Window = Library.WindowState, Version = Library.Version }
	for k, v in pairs(Settings) do
		local t = type(v)
		if t == "string" or t == "number" or t == "boolean" then
			data.Settings[k] = v
		end
	end
	for slot in pairs(DefaultTheme) do
		data.ThemeColors[slot] = toHex(Theme[slot])
	end
	return writeJSON(SETTINGS_PATH, data)
end

local saveQueued = false
local function queueSave()
	if saveQueued then
		return
	end
	saveQueued = true
	task.delay(0.8, function()
		saveQueued = false
		if not Library.Unloaded then
			Library:SaveSettings()
		end
	end)
end
Library.QueueSave = queueSave

local function loadPreset(name)
	local preset = Themes[name]
	if not preset then
		return false
	end
	for k, v in pairs(DefaultTheme) do
		Theme[k] = v
	end
	for k, v in pairs(preset) do
		if DefaultTheme[k] then
			Theme[k] = v
		end
	end
	return true
end

function Library:LoadSettings()
	if self.SettingsLoaded then
		return
	end
	self.SettingsLoaded = true
	local data = readJSON(SETTINGS_PATH)
	if not data then
		return
	end
	if type(data.Settings) == "table" then
		for k, v in pairs(data.Settings) do
			local default = DefaultSettings[k]
			if (default ~= nil and type(v) == type(default)) or (k == "Collapsed" and type(v) == "boolean") then
				Settings[k] = v
			end
		end
	end
	if Settings.Theme == "Custom" and type(data.ThemeColors) == "table" then
		for slot, hex in pairs(data.ThemeColors) do
			local c = fromHex(hex)
			if c and DefaultTheme[slot] then
				Theme[slot] = c
			end
		end
	elseif not loadPreset(Settings.Theme) then
		Settings.Theme = "Pepsi"
	end
	if type(data.Window) == "table" then
		Library.WindowState = data.Window
	end
	Settings.AnimSpeed = math.clamp(tonumber(Settings.AnimSpeed) or 1, 0.25, 3)
	Settings.Roundness = math.clamp(tonumber(Settings.Roundness) or 1, 0, 2.5)
	Settings.Transparency = math.clamp(tonumber(Settings.Transparency) or 0, 0, 0.9)
	Settings.Volume = math.clamp(tonumber(Settings.Volume) or 0.6, 0, 1)
	derive()
end

function Library:ResetSettings()
	for k, v in pairs(DefaultSettings) do
		Settings[k] = v
	end
	loadPreset("Pepsi")
	applyFonts()
	applyShape()
	applyGlass(true)
	applyTheme(true)
	for k, v in pairs(Settings) do
		Library.SettingChanged:Fire(k, v)
	end
	queueSave()
end

-- Change one setting and apply it everywhere.
function Library:SetSetting(key, value)
	if Settings[key] == value then
		return
	end
	Settings[key] = value
	if key == "Font" then
		applyFonts()
	elseif key == "Roundness" then
		applyShape()
	elseif key == "Transparency" then
		applyGlass(false)
	elseif key == "Gradient" then
		applyGradients()
		applyTheme(false)
	end
	Library.SettingChanged:Fire(key, value)
	queueSave()
end

function Library:GetSetting(key)
	return Settings[key]
end

-- ======================================================================
-- Theme API
-- ======================================================================
function Library:SetTheme(theme, smooth)
	if smooth == nil then
		smooth = true
	end
	if type(theme) == "string" then
		if not loadPreset(theme) then
			return false
		end
		Settings.Theme = theme
	elseif type(theme) == "table" then
		for k, v in pairs(theme) do
			local c = fromHex(v)
			if c and DefaultTheme[k] then
				Theme[k] = c
			end
		end
		Settings.Theme = "Custom"
	end
	applyTheme(smooth)
	queueSave()
	return true
end

function Library:SetThemeColor(slot, color, smooth)
	color = fromHex(color)
	if not color or not DefaultTheme[slot] then
		return
	end
	Theme[slot] = color
	Settings.Theme = "Custom"
	if smooth then
		applyTheme(true)
	else
		queueRefresh()
	end
	queueSave()
end

