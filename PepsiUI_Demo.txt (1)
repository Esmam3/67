local function safeCall(fn, ...)
	if type(fn) ~= "function" then
		return
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[Pepsi UI] callback error: " .. tostring(err))
	end
	return ok, err
end

local function connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(Library.Connections, c)
	return c
end

local function round(n, decimals)
	local m = 10 ^ (decimals or 0)
	return math.floor(n * m + 0.5) / m
end

local function decimalsOf(step)
	if step >= 1 or step <= 0 then
		return 0
	end
	return math.max(0, math.ceil(-math.log10(step) - 1e-9))
end

local function commas(n)
	local s = tostring(math.floor(math.abs(n)))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
	return (n < 0 and "-" or "") .. out
end

local function abbreviate(n)
	n = tonumber(n) or 0
	local abs = math.abs(n)
	local units = { { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }
	for _, u in ipairs(units) do
		if abs >= u[1] then
			local v = n / u[1]
			return (v >= 100 and string.format("%.0f", v) or v >= 10 and string.format("%.1f", v) or string.format("%.2f", v)):gsub("%.?0+$", "") .. u[2]
		end
	end
	if n % 1 ~= 0 then
		return string.format("%.2f", n):gsub("%.?0+$", "")
	end
	return tostring(n)
end
Library.Abbreviate = abbreviate
Library.Commas = commas

local function formatTime(seconds)
	seconds = math.max(0, math.floor(seconds or 0))
	local h = math.floor(seconds / 3600)
	local m = math.floor(seconds % 3600 / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end
Library.FormatTime = formatTime

-- Scores how well a query matches a piece of text: higher is better, 0 means no match.
local function fuzzyScore(query, textValue)
	query, textValue = query:lower(), textValue:lower()
	if query == "" then
		return 1
	end
	if textValue == query then
		return 1000
	end
	local start = textValue:find(query, 1, true)
	if start == 1 then
		return 800 - #textValue
	end
	if start then
		local before = textValue:sub(start - 1, start - 1)
		return (before == " " or before == "_" or before == "-") and 600 - start or 400 - start
	end
	-- Letters in order (so "atf" finds "Auto farm").
	local qi, score, last = 1, 0, 0
	for i = 1, #textValue do
		if textValue:sub(i, i) == query:sub(qi, qi) then
			score += (i == last + 1) and 6 or 2
			last = i
			qi += 1
			if qi > #query then
				return 100 + score - #textValue * 0.2
			end
		end
	end
	return 0
end
Library.FuzzyScore = fuzzyScore

-- ======================================================================
-- Signal: a tiny event object used by elements and the library.
-- ======================================================================
local Signal = {}
Signal.__index = Signal
function Signal.new()
	return setmetatable({ Handlers = {} }, Signal)
end
function Signal:Connect(fn)
	local handler = { Fn = fn, Connected = true }
	table.insert(self.Handlers, handler)
	local list = self.Handlers
	local connection = { Connected = true }
	function connection.Disconnect()
		handler.Connected = false
		connection.Connected = false
		local i = table.find(list, handler)
		if i then
			table.remove(list, i)
		end
	end
	return connection
end
function Signal:Once(fn)
	local connection
	connection = self:Connect(function(...)
		connection.Disconnect()
		fn(...)
	end)
	return connection
end
function Signal:Fire(...)
	for _, handler in ipairs(table.clone(self.Handlers)) do
		if handler.Connected then
			safeCall(handler.Fn, ...)
		end
	end
end
Library.Signal = Signal
Library.ThemeChanged = Signal.new()
Library.SettingChanged = Signal.new()
Library.Unloading = Signal.new()

