	local coins, gems, kills, level, xp, quest = 0, 0, 0, 1, 0, 0
	while not UI.Unloaded do
		local earned = math.random(5, 40)
		coins += earned
		if math.random() < 0.3 then
			gems += 1
		end
		kills += math.random(0, 2)
		xp += math.random(2, 6)
		if xp >= 100 then
			xp -= 100
			level += 1
			console:Log("Level up! Now level " .. level, "Success")
		end
		quest = (quest + 1) % 31
		stats:Set("Coins", coins)
		stats:Set("Gems", gems)
		stats:Set("Kills", kills)
		stats:Set("Level", level)
		levelBar:Set(xp)
		questBar:Set(quest)
		graph:Push(earned)
		if math.random() < 0.25 then
			console:Log("Picked up " .. earned .. " coins", "Info")
		end
		task.wait(1)
	end
end)

