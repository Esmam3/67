function Window:_renderHistory()
	local scroll = self.HistoryList
	if not scroll or not scroll.Parent then
		return
	end
	for _, c in ipairs(scroll:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	if #Library.NotifyHistory == 0 then
		local empty = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 120), ZIndex = 54, Parent = scroll })
		icon(empty, "bell-off", 28, "Dim", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 26), ZIndex = 54 })
