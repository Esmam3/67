end

local function showBubble(bubble, scale, on)
	if on then
		bubble.Visible = true
		tween(scale, { Scale = 1 }, 0.25, Enum.EasingStyle.Back)
	else
		tween(scale, { Scale = 0 }, 0.15)
		task.delay(0.16, function()
			if scale.Scale < 0.05 then
				bubble.Visible = false
			end
		end)
	end
end

function Section:Slider(opts)
	opts = opts or {}
	local min, max = tonumber(opts.Min) or 0, tonumber(opts.Max) or 100
	if max < min then
		min, max = max, min
	end
	local step = tonumber(opts.Increment or opts.Step or opts.Rounding) or 1
	if opts.Rounding and tonumber(opts.Rounding) and opts.Rounding >= 0 and opts.Rounding % 1 == 0 and not opts.Increment then
		step = 1 / (10 ^ opts.Rounding)
	end
	local snap, decimals = makeSnap(min, max, step)
	local fmt = formatter(opts, decimals)
	local e = newElement(self, "Slider", opts, self.Window.RowHeight + 18)
	e.Min, e.Max, e.Step = min, max, step
	e.Value = snap(opts.Default or opts.Value or min)
	local box = valueBox(e)
	e.Title.Size = UDim2.new(1, -110, 0, 18)
	local track, fill = sliderTrack(e)
	local knob, knobStroke, bubble, bubbleScale = sliderKnob(track)
	if opts.Ticks then
		local count = type(opts.Ticks) == "number" and opts.Ticks or math.min(10, math.floor((max - min) / step))
		for i = 1, count - 1 do
			create("Frame", { Name = "Tick", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(i / count, 0.5), Size = UDim2.fromOffset(2, 2), BackgroundColor3 = "Dim", BorderSizePixel = 0, ZIndex = 5, Parent = track })
		end
	end
	local dragging = false
	local function alphaOf(v)
		return max == min and 0 or (v - min) / (max - min)
	end
	local function render(animate)
		local a = alphaOf(e.Value)
		local t = animate and 0.12 or 0
		paint(fill, { Size = UDim2.fromScale(a, 1) }, animate and t > 0, t)
		paint(knob, { Position = UDim2.fromScale(a, 0.5) }, animate and t > 0, t)
		local label = fmt(e.Value)
		if not box:IsFocused() then
			box.Text = label
		end
		bubble.Text = label
	end
	e.Render = render
	function e:Set(value, silent)
		local v = snap(value)
		if v == self.Value then
			render(false)
			return
		end
		local old = self.Value
		self.Value = v
		render(not dragging)
		if dragging then
			sfx("Slide", 0.85 + alphaOf(v) * 0.6)
		end
		if not silent then
			self:_emit(v)
		elseif self.Flag then
			Library.Flags[self.Flag] = v
		end
		return old
	end
	function e:SetMin(v)
		min = tonumber(v) or min
		snap, decimals = makeSnap(min, max, step)
		e.Min = min
		self:Set(self.Value)
		render(false)
	end
	function e:SetMax(v)
		max = tonumber(v) or max
		snap, decimals = makeSnap(min, max, step)
		e.Max = max
		self:Set(self.Value)
		render(false)
	end
	local function fromInput(input)
		local x = (input.Position.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X)
		e:Set(min + math.clamp(x, 0, 1) * (max - min))
	end
	local hit = hitbox(track, 8, UDim2.new(1, 16, 0, 30), UDim2.new(0, -8, 0.5, -15))
	local lastClick = 0
	hit.InputBegan:Connect(function(input)
		if not isPress(input) or e.Locked then
			return
		end
		local now = os.clock()
		if now - lastClick < 0.3 and e.Default ~= nil then
			e:Set(e.Default)
			sfx("Back")
			lastClick = 0
			return
		end
		lastClick = now
		dragging = true
		local scroll = e.Page and e.Page.Scroll
		if scroll then
			scroll.ScrollingEnabled = false
		end
		tween(knob, { Size = UDim2.fromOffset(18, 18) }, 0.15, Enum.EasingStyle.Back)
		showBubble(bubble, bubbleScale, true)
		fromInput(input)
		startDrag(input, fromInput, function()
			dragging = false
			if scroll then
				scroll.ScrollingEnabled = true
			end
			tween(knob, { Size = UDim2.fromOffset(14, 14) }, 0.25, Enum.EasingStyle.Back)
			showBubble(bubble, bubbleScale, false)
			render(false)
		end)
	end)
	hit.MouseEnter:Connect(function()
		if not dragging then
			tween(knob, { Size = UDim2.fromOffset(16, 16) }, 0.15)
		end
	end)
	hit.MouseLeave:Connect(function()
		if not dragging then
			tween(knob, { Size = UDim2.fromOffset(14, 14) }, 0.15)
		end
	end)
	box.Focused:Connect(function()
		box.Text = tostring(e.Value)
	end)
	box.FocusLost:Connect(function()
		local n = tonumber((box.Text:gsub("[^%d%.%-]", "")))
		if n then
			e:Set(n)
		else
			shake(box)
		end
		box.Text = fmt(e.Value)
	end)
	register(e, opts)
	render(false)
	return e
end
