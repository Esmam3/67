function Window:BuildFizz()
	local layer = create("Frame", { Name = "Fizz", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = self.Decor })
	self.FizzLayer = layer
	local bubbles = {}
	for i = 1, (self.Mobile and 10 or 16) do
		local size = math.random(3, 9)
		local b = create("Frame", {
			Name = "Bubble",
			BackgroundColor3 = i % 3 == 0 and "AccentB" or "AccentA",
			BackgroundTransparency = 0.82,
			Size = UDim2.fromOffset(size, size),
			Position = UDim2.new(math.random(), 0, math.random(), 0),
			BorderSizePixel = 0,
			Parent = layer,
		})
		corner(UDim.new(1, 0), b)
		local ring = create("UIStroke", { Color = Color3.new(1, 1, 1), Transparency = 0.86, Thickness = 1, Parent = b })
		table.insert(bubbles, { Frame = b, Ring = ring, X = b.Position.X.Scale, Y = b.Position.Y.Scale, Speed = 0.012 + math.random() * 0.03, Phase = math.random() * 6, Sway = 0.004 + math.random() * 0.01 })
	end
	self.Bubbles = bubbles
	local function run()
		if self.FizzJob then
			return
		end
		self.FizzJob = Ticker.Add(function(dt)
			if not Settings.Fizz or Library.Unloaded then
				self.FizzJob = nil
				layer.Visible = false
				return true
			end
			if not self.Open then
				return
			end
			layer.Visible = true
			local t = os.clock()
			for _, b in ipairs(bubbles) do
				b.Y -= b.Speed * dt
				if b.Y < -0.05 then
					b.Y = 1.05
					b.X = math.random()
				end
				b.Frame.Position = UDim2.new(b.X + math.sin(t * 1.3 + b.Phase) * b.Sway, 0, b.Y, 0)
			end
		end)
	end
	self.RunFizz = run
	layer.Visible = Settings.Fizz
	if Settings.Fizz then
		run()
	end
end

function Window:BuildCursorGlow()
	local glow, ringT = glowBlob(self.Decor, 320, "AccentA", 0.02, 10)
	glow.Visible = false
	self.CursorGlowFrame = glow
	local target, current, alpha = Vector2.zero, nil, 0
	connect(UserInputService.InputChanged, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement or not self.Open or not Settings.CursorGlow then
			return
		end
		local rel = input.Position - self.Main.AbsolutePosition
		local size = self.Main.AbsoluteSize
		local inside = rel.X >= 0 and rel.Y >= 0 and rel.X <= size.X and rel.Y <= size.Y
		local ratio = self:Ratio()
		target = rel / ratio
		self.GlowInside = inside
		if not self.GlowJob then
			glow.Visible = true
			self.GlowJob = Ticker.Add(function(dt)
				if not current then
					current = target
				end
				current = Vector2.new(approach(current.X, target.X, dt, 10), approach(current.Y, target.Y, dt, 10))
				alpha = approach(alpha, (self.GlowInside and Settings.CursorGlow and self.Open) and 1 or 0, dt, 6)
				glow.Position = UDim2.fromOffset(current.X, current.Y)
				-- Only touch the rings while the glow is fading in or out.
				if math.abs(alpha - (self.GlowAlpha or -1)) > 0.01 then
					self.GlowAlpha = alpha
					for _, ring in ipairs(glow:GetChildren()) do
						if ring:IsA("Frame") then
							ring.BackgroundTransparency = 1 - (1 - ringT) * alpha
						end
					end
				end
				if alpha < 0.01 and not self.GlowInside then
					glow.Visible = false
					self.GlowJob = nil
					self.GlowAlpha = nil
					return true
				end
			end)
		end
	end)
end

function Window:_onSetting(key, value)
	if key == "Fizz" then
		self.FizzLayer.Visible = value
		if value then
			self.RunFizz()
		end
	elseif key == "Blur" then
		self:_blur(self.Open and value)
	elseif key == "MenuScale" then
		self:SetScale(value)
	elseif key == "Collapsed" then
		if value == nil then
			value = self.Mobile
		end
		self:SetSidebar(value == true)
	elseif key == "ShowButton" then
		if self.ToggleButton then
			-- Phones always keep it: it's the only way back into the menu.
			self.ToggleButton.Button.Visible = value == true or self.Mobile
		end
	elseif key == "Watermark" then
		if value then
			self:Watermark()
		elseif self.WatermarkFrame then
			self.WatermarkFrame.Visible = false
		end
	elseif key == "KeybindList" then
		if not self.Mobile then
			self:KeybindList(value)
		end
	elseif key == "NotifyPosition" or key == "NotifyStyle" then
		stackHolder()
	end
end

-- ======================================================================
-- Live stats shared by the top bar and the home tab
-- ======================================================================
local LiveStats = { FPS = 60, Ping = 0, Started = os.clock() }
Library.LiveStats = LiveStats
do
	local frames, elapsed = 0, 0
	Ticker.Add(function(dt)
		frames += 1
		elapsed += dt
		if elapsed >= 0.5 then
			LiveStats.FPS = math.floor(frames / elapsed + 0.5)
			frames, elapsed = 0, 0
			local ok, ping = pcall(function()
				return LocalPlayer:GetNetworkPing() * 1000
			end)
			if not ok or type(ping) ~= "number" or ping <= 0 then
				ok, ping = pcall(function()
					return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
				end)
			end
			if ok and type(ping) == "number" then
				LiveStats.Ping = math.floor(ping + 0.5)
			end
		end
	end)
end

-- Moves something with mouse or finger using its Position (works the same in every screen).
local function dragWithPosition(object, handle, onDrop, onTap)
	handle.InputBegan:Connect(function(input)
		if not isPress(input) or Drag.Active then
			return
		end
		local parentSize = object.Parent.AbsoluteSize
		local p = object.Position
		local startX = p.X.Scale * parentSize.X + p.X.Offset
		local startY = p.Y.Scale * parentSize.Y + p.Y.Offset
		local start = input.Position
		local moved = false
		startDrag(input, function(move)
			local delta = move.Position - start
			if not moved and delta.Magnitude < 6 then
				return
			end
			moved = true
			local size = object.AbsoluteSize
			local a = object.AnchorPoint
			local x = math.clamp(startX + delta.X, a.X * size.X, math.max(a.X * size.X, parentSize.X - (1 - a.X) * size.X))
			local y = math.clamp(startY + delta.Y, a.Y * size.Y, math.max(a.Y * size.Y, parentSize.Y - (1 - a.Y) * size.Y))
			object.Position = UDim2.fromOffset(x, y)
		end, function()
			if moved then
				safeCall(onDrop)
			else
				safeCall(onTap)
			end
		end)
	end)
end
Library.Draggable = dragWithPosition

-- ======================================================================
-- Floating open button (big on phones, drag it anywhere, it snaps to the side)
-- ======================================================================
function Window:BuildToggleButton(opts)
	local gui = newScreen("PepsiUI_Button", 210)
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	end)
	self.ButtonGui = gui
	local size = self.Mobile and 56 or 46
	local margin = 16 + size / 2
	local saved = self.State.Button
	local function sidePosition(side, yScale)
		return side == "R" and UDim2.new(1, -margin, yScale, 0) or UDim2.new(0, margin, yScale, 0)
	end
	local button = create("TextButton", {
		Name = "Toggle",
		AutoButtonColor = false,
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = type(saved) == "table" and sidePosition(saved.Side, tonumber(saved.Y) or 0.5) or sidePosition("L", 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local glow = glowBlob(button, size * 2.2, "AccentA", 0.04, 5)
	glow.Position = UDim2.fromScale(0.5, 0.5)
	local ring = create("Frame", {
		Name = "Ring",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 6, 1, 6),
		BackgroundColor3 = "AccentA",
		Parent = button,
	})
	corner(UDim.new(1, 0), ring)
	local ringGradient = gradient(ring, 45)
	local face = create("Frame", {
		Name = "Face",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = "Background",
		ClipsDescendants = true,
		Parent = button,
	})
	corner(UDim.new(1, 0), face)
	local logo = makeLogo(face, size - 12, opts.ButtonLogo or opts.Logo, self.Title)
	if logo then
		logo.AnchorPoint = Vector2.new(0.5, 0.5)
		logo.Position = UDim2.fromScale(0.5, 0.5)
	end
	local badge = create("TextLabel", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -6, 0, 6),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = "Error",
		Text = "",
		FontFace = "Bold",
		TextSize = 11,
		TextColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 5,
		Parent = button,
	})
	corner(UDim.new(1, 0), badge)
	stroke(badge, 0, 2, "Background")
	local scaler = create("UIScale", { Parent = button })
	button.MouseEnter:Connect(function()
		tween(scaler, { Scale = 1.08 }, 0.2, Enum.EasingStyle.Back)
		sfx("Hover")
	end)
	button.MouseLeave:Connect(function()
		tween(scaler, { Scale = 1 }, 0.2)
	end)
	button.MouseButton1Down:Connect(function()
		tween(scaler, { Scale = 0.88 }, 0.08)
	end)
	button.MouseButton1Up:Connect(function()
		tween(scaler, { Scale = 1 }, 0.4, Enum.EasingStyle.Back)
	end)
	local function snap()
		local screen = gui.AbsoluteSize
		if screen.X < 10 then
			return
		end
		local p = button.Position
		local x = p.X.Scale * screen.X + p.X.Offset
		local y = p.Y.Scale * screen.Y + p.Y.Offset
		local side = x > screen.X / 2 and "R" or "L"
		local edge = math.min(0.45, (margin + 4) / screen.Y)
		local yScale = math.clamp(y / screen.Y, edge, 1 - edge)
		local target = sidePosition(side, yScale)
		-- Convert the target to the same kind of position first so the tween is smooth.
		local tx = target.X.Scale * screen.X + target.X.Offset
		tween(button, { Position = UDim2.fromOffset(tx, yScale * screen.Y) }, 0.45, Enum.EasingStyle.Back)
		task.delay(0.46, function()
			button.Position = target
		end)
		self.State.Button = { Side = side, Y = yScale }
		queueSave()
	end
	dragWithPosition(button, button, snap, function()
		self:Toggle()
	end)
	if not self.Mobile then
		attachTooltip(button, function()
			return (self.Open and "Hide " or "Open ") .. self.Title .. " (" .. keyName(self.ToggleKey) .. ")"
		end)
	end
	-- The ring turns slowly so it reads as alive.
	Ticker.Add(function(dt)
		if not ring.Parent then
			return true
		end
		ringGradient.Rotation = (ringGradient.Rotation + dt * (self.Open and 90 or 40)) % 360
	end)
	local handle = { Button = button, Ring = ring, Badge = badge }
	function handle.SetState(open)
		tween(ring, { BackgroundTransparency = open and 0 or 0.35 }, 0.25)
		tween(glow, { Size = UDim2.fromOffset(size * (open and 2.4 or 1.8), size * (open and 2.4 or 1.8)) }, 0.4)
	end
	self.ToggleButton = handle
	if opts.ShowButton == false or not Settings.ShowButton then
		button.Visible = false
	end
	if self.Mobile and opts.ShowButton ~= false then
		button.Visible = true
	end
end

function Window:_updateBadges()
	local n = self.Unread or 0
	local label = n > 9 and "9+" or tostring(n)
	if self.BellBadge then
		local show = n > 0
		if show and not self.BellBadge.Visible then
			self.BellBadge.Size = UDim2.fromOffset(0, 0)
			tween(self.BellBadge, { Size = UDim2.fromOffset(16, 16) }, 0.35, Enum.EasingStyle.Back)
		end
		self.BellBadge.Visible = show
		self.BellBadge.Text = label
	end
	if self.ToggleButton then
		local badge = self.ToggleButton.Badge
		badge.Visible = n > 0 and not self.Open
		badge.Text = label
	end
end

function Window:_onNotify()
	if self.HistoryOpen then
		self:_renderHistory()
	else
		self.Unread = (self.Unread or 0) + 1
		self:_updateBadges()
		if self.Bell then
			local img = self.Bell:FindFirstChild("Icon")
			if img and Settings.Animations then
				task.spawn(function()
					for _, r in ipairs({ 14, -12, 9, -6, 3, 0 }) do
						img.Rotation = r
						task.wait(0.05)
					end
				end)
			end
		end
	end
end

