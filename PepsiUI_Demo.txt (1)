	local s = SoundCache[name]
	if not s or not s.Parent then
		s = Instance.new("Sound")
		s.Name = name
		s.Parent = soundParent()
		SoundCache[name] = s
	end
	local id = "rbxassetid://" .. tostring(def[1])
	if s.SoundId ~= id then
		s.SoundId = id
	end
	return s
