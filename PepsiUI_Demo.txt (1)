	local title = text({ Parent = frame, Text = "", Font = "SemiBold", Size = 14, Color = Color3.new(1, 1, 1), Pos = UDim2.fromOffset(40, 9), Sz = UDim2.new(1, -56, 0, 18), Truncate = true, Z = 46 })
