	stroke(track, 0.9)
	local fill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = "AccentA", ClipsDescendants = true, ZIndex = 4, Parent = track })
	corner(UDim.new(1, 0), fill)
	local fillGradient = gradient(fill)
	local shine = create("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.6, Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = fill })
	local shineGradient = create("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1) }), Offset = Vector2.new(-1, 0), Parent = shine })
	tween(shineGradient, { Offset = Vector2.new(1, 0) }, 1.6, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1)
	local function render(animate)
		local a = max > 0 and e.Value / max or 0
		paint(fill, { Size = UDim2.fromScale(a, 1) }, animate, 0.45)
		if opts.Format then
			local ok, s = pcall(opts.Format, e.Value, max)
			percent.Text = ok and tostring(s) or ""
		elseif opts.Suffix then
			percent.Text = abbreviate(e.Value) .. tostring(opts.Suffix)
		else
			percent.Text = math.floor(a * 100 + 0.5) .. "%"
		end
		if opts.Color then
			fillGradient.Enabled = false
			fill.BackgroundColor3 = typeof(opts.Color) == "Color3" and opts.Color or Theme[opts.Color] or Theme.AccentA
		end
	end
	function e:Set(value, newMax)
		if newMax then
			max = math.max(tonumber(newMax) or max, 1e-6)
		end
		self.Value = math.clamp(tonumber(value) or 0, 0, max)
		render(true)
		for _, fn in ipairs(self.Listeners) do
			safeCall(fn, self.Value)
		end
	end
	function e:SetMax(v)
		max = math.max(tonumber(v) or max, 1e-6)
		render(true)
	end
	e.NoReset = true
	e.NoSave = true
	register(e, opts)
	render(false)
	return e
end
