-- ======================================================================
local Listening = nil -- the keybind waiting for a key

local function keybindCore(owner, pill, label, opts)
	local kb = {
		Type = "Keybind",
		Value = toKey(opts.Default or opts.Key),
		Mode = opts.Mode or "Toggle",
		State = false,
		Name = owner and owner.Name or tostring(opts.Name or "Keybind"),
		Listeners = {},
		Owner = owner,
	}
	local pillStroke = pill:FindFirstChildOfClass("UIStroke")
	local function show()
		label.Text = Listening == kb and "..." or keyName(kb.Value)
	end
	kb.Show = show
	local function stopListening()
		if Listening == kb then
			Listening = nil
		end
		if pillStroke then
			tween(pillStroke, { Color = Theme.Stroke, Transparency = 0.86 }, 0.15)
		end
		show()
	end
	function kb.Listen()
		if Listening and Listening ~= kb then
			Listening.Stop()
		end
		Listening = kb
		show()
		sfx("Click")
		if pillStroke then
			pillStroke.Color = Theme.AccentA
			tween(pillStroke, { Transparency = 0.1 }, 0.15)
		end
		task.spawn(function()
			while Listening == kb and pill.Parent do
				if pillStroke then
					tween(pillStroke, { Transparency = 0.6 }, 0.45, Enum.EasingStyle.Sine)
				end
				task.wait(0.45)
				if Listening ~= kb then
					break
				end
				if pillStroke then
					tween(pillStroke, { Transparency = 0.05 }, 0.45, Enum.EasingStyle.Sine)
				end
				task.wait(0.45)
			end
		end)
	end
	kb.Stop = stopListening
	function kb.SetKey(key, silent)
		kb.Value = toKey(key)
		show()
		if not silent then
			safeCall(opts.ChangedCallback or opts.Changed, kb.Value)
		end
	end
	function kb.Fire(state)
		kb.State = state
		safeCall(opts.Callback, state)
		for _, fn in ipairs(kb.Listeners) do
			safeCall(fn, state)
		end
		if owner and owner.Type == "Toggle" and opts.SyncToggle ~= false then
			if kb.Mode == "Hold" then
				owner:Set(state)
			elseif state ~= nil and kb.Mode == "Toggle" then
				owner:Set(not owner.Value)
			end
		end
	end
	function kb.Matches(input)
		local v = kb.Value
		return v ~= nil and (input.KeyCode == v or input.UserInputType == v)
	end
	return kb
end

connect(UserInputService.InputBegan, function(input, processed)
	if Library.Unloaded then
		return
	end
	if Listening then
		local kb = Listening
		if input.UserInputType == Enum.UserInputType.Keyboard then
			Listening = nil
			if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
				kb.SetKey(nil)
				sfx("Back")
			else
				kb.SetKey(input.KeyCode)
				sfx("Success", 1.2, 0.6)
			end
			kb.Stop()
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
			Listening = nil
			kb.SetKey(input.UserInputType)
			kb.Stop()
		end
		return
	end
	if processed then
		return
	end
	for _, kb in ipairs(Library.Keybinds) do
		if not kb.Destroyed and kb.Matches(input) and kb.Mode ~= "Always" then
			if kb.Mode == "Hold" then
				kb.Fire(true)
			else
				kb.Fire(not kb.State)
			end
		end
	end
end)
connect(UserInputService.InputEnded, function(input)
	if Library.Unloaded then
		return
	end
	for _, kb in ipairs(Library.Keybinds) do
		if not kb.Destroyed and kb.Mode == "Hold" and kb.State and kb.Matches(input) then
			kb.Fire(false)
		end
	end
end)

