	local line = create("Frame", { Name = "Line", BackgroundColor3 = "AccentA", BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -3), Size = UDim2.new(0, 0, 0, 2), ZIndex = 46, Parent = frame })
