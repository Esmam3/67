-- Stat cards: little live numbers in a grid
-- ======================================================================
function Section:Stats(items, opts)
	opts = opts or {}
	if type(items) == "table" and items.Items then
		opts = items
		items = items.Items
	end
	local e = newBlock(self, "Stats", opts, false)
	local columns = opts.Columns or (self.Window.Mobile and 2 or ((self.Side == "Full") and 4 or 2))
	local grid = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = e.Frame })
	create("UIGridLayout", {
		CellPadding = UDim2.fromOffset(6, 6),
		CellSize = UDim2.new(1 / columns, -6 + 6 / columns, 0, 58),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	local cards = {}
	local function addCard(item, i)
		local card = create("Frame", { BackgroundColor3 = "Element", BackgroundTransparency = 0.4, LayoutOrder = i, Parent = grid })
		corner(10, card)
		stroke(card, 0.94)
		local tile = create("Frame", { Position = UDim2.fromOffset(10, 12), Size = UDim2.fromOffset(32, 32), BackgroundColor3 = item.Color or "AccentA", BackgroundTransparency = 0.82, Parent = card })
		corner(9, tile)
		icon(tile, item.Icon or "activity", 16, item.Color or "AccentA", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
		local value = text({ Parent = card, Text = tostring(item.Value or "0"), Font = "Bold", Size = 17, Pos = UDim2.fromOffset(50, 10), Sz = UDim2.new(1, -58, 0, 20), Truncate = true })
		local label = text({ Parent = card, Text = tostring(item.Name or ""), Size = 11, Color = "SubText", Pos = UDim2.fromOffset(50, 31), Sz = UDim2.new(1, -58, 0, 14), Truncate = true })
		cards[tostring(item.Name or i)] = { Value = value, Label = label, Current = tonumber(item.Value), Format = item.Format }
	end
	for i, item in ipairs(items or {}) do
		addCard(item, i)
	end
	-- Numbers count up/down to the new value.
	function e:Set(name, value)
		local c = cards[tostring(name)]
		if not c then
			return
		end
		local target = tonumber(value)
		local fmt = c.Format or abbreviate
		if not target or not c.Current or not Settings.Animations then
			c.Value.Text = target and fmt(target) or tostring(value)
			c.Current = target
			return
		end
		local from = c.Current
		c.Current = target
		if c.Job then
			Ticker.Remove(c.Job)
		end
		local t = 0
		c.Job = Ticker.Add(function(dt)
			t = math.min(1, t + dt / 0.6)
			local eased = 1 - (1 - t) ^ 3
			local v = from + (target - from) * eased
			c.Value.Text = fmt(math.abs(target) >= 1000 and math.floor(v + 0.5) or (target % 1 == 0 and math.floor(v + 0.5) or round(v, 2)))
			if t >= 1 then
				c.Value.Text = fmt(target)
				c.Job = nil
				return true
			end
		end)
	end
	function e:Get(name)
		local c = cards[tostring(name)]
		return c and c.Current
	end
	function e:Add(item)
		local n = 0
		for _ in pairs(cards) do
			n += 1
		end
		addCard(item, n + 1)
	end
	return e
end
