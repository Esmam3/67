local function runIsland()
	if Island.Busy then
		return
	end
	local opts = table.remove(Island.Queue, 1)
	if not opts then
		return
	end
	Island.Busy = true
	Island.Skip = false
	task.spawn(function()
		local frame = islandFrame()
		local kind = opts.Kind
		local accent = kind.Slot and Theme[kind.Slot] or nil
		Island.TileGradient.Enabled = accent == nil
		Island.LineGradient.Enabled = accent == nil
		Island.Tile.BackgroundColor3 = accent or Color3.new(1, 1, 1)
		Island.Line.BackgroundColor3 = accent or Color3.new(1, 1, 1)
		setIcon(Island.Icon, opts.Icon or kind.Icon)
		Island.Title.Text = opts.Title
		Island.Body.Text = opts.Content
		local width = math.min(overlaySize().X - 24, 360)
		local bodyH = opts.Content ~= "" and measure(opts.Content, 13, width - 56).Y + 4 or 0
		Island.Body.Size = UDim2.new(1, -56, 0, bodyH)
		local height = opts.Content ~= "" and (36 + bodyH + 10) or 36
		-- Sit under the top bar when it's in its usual place.
		local top = Library.Mobile and 8 or 12
		for _, w in ipairs(Library.Windows) do
			local bar = w.WatermarkFrame
			if bar and bar.Visible and bar.Position.Y.Scale == 0 and bar.Position.Y.Offset < 60 and bar.Position.X.Scale == 0.5 then
				top = bar.Position.Y.Offset + 40
			end
		end
		Island.Title.TextTransparency = 1
		Island.Body.TextTransparency = 1
		Island.Line.Size = UDim2.new(0, 0, 0, 2)
		if not frame.Visible then
			frame.Visible = true
			frame.Size = UDim2.fromOffset(36, 36)
			frame.Position = UDim2.new(0.5, 0, 0, -44)
			tween(frame, { Position = UDim2.new(0.5, 0, 0, top) }, 0.35, Enum.EasingStyle.Back)
			task.wait(0.22)
		end
		tween(frame, { Size = UDim2.fromOffset(width, height) }, 0.5, Enum.EasingStyle.Back)
		task.wait(0.18)
		tween(Island.Title, { TextTransparency = 0 }, 0.2)
		tween(Island.Body, { TextTransparency = 0 }, 0.25)
		tween(Island.Line, { Size = UDim2.new(1, -36, 0, 2) }, 0.3)
		local hold = #Island.Queue > 0 and math.min(opts.Duration, 2.2) or opts.Duration
		local start = os.clock()
		tween(Island.Line, { Size = UDim2.new(0, 0, 0, 2) }, hold, Enum.EasingStyle.Linear)
		while os.clock() - start < hold and not Island.Skip and not Library.Unloaded do
			task.wait(0.05)
		end
		tween(Island.Title, { TextTransparency = 1 }, 0.15)
		tween(Island.Body, { TextTransparency = 1 }, 0.15)
		task.wait(0.12)
		if #Island.Queue > 0 then
			tween(frame, { Size = UDim2.fromOffset(120, 36) }, 0.3)
			task.wait(0.25)
		else
			tween(frame, { Size = UDim2.fromOffset(36, 36) }, 0.35)
			task.wait(0.28)
			tween(frame, { Position = UDim2.new(0.5, 0, 0, -44) }, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			task.wait(0.3)
			if #Island.Queue == 0 then
				frame.Visible = false
			end
		end
		Island.Busy = false
		runIsland()
	end)
end

function Library:Notify(opts, maybeText, maybeTime)
	if type(opts) ~= "table" then
		if type(maybeText) == "string" then
			opts = { Title = tostring(opts), Content = maybeText, Duration = maybeTime }
		else
			opts = { Title = Library.DefaultTitle or "Pepsi Hub", Content = tostring(opts), Duration = maybeText }
		end
	end
	local kindName = opts.Type or opts.Kind or "Info"
	local kind = NotifyTypes[kindName] or NotifyTypes.Info
	local data = {
		Title = tostring(opts.Title or Library.DefaultTitle or "Pepsi Hub"),
		Content = tostring(opts.Content or opts.Description or opts.Text or ""),
		Duration = math.max(1, (tonumber(opts.Duration or opts.Time) or 4) * (Settings.NotifyDuration or 1)),
		Icon = opts.Icon,
		Buttons = opts.Buttons or opts.Actions,
		Callback = opts.Callback,
		OnClose = opts.OnClose,
		Kind = kind,
	}
	local entry = { Title = data.Title, Content = data.Content, Type = kindName, Icon = data.Icon or kind.Icon, Time = os.time() }
	table.insert(Library.NotifyHistory, 1, entry)
	while #Library.NotifyHistory > 60 do
		table.remove(Library.NotifyHistory)
	end
	Library.NotifyAdded:Fire(entry)
	if not Settings.Notifications or Library.Unloaded or opts.Silent then
		return { Close = function() end }
	end
	sfx(kind.Sound)
	if Settings.NotifyStyle == "Island" and not data.Buttons then
		table.insert(Island.Queue, data)
		runIsland()
		return {
			Close = function()
				Island.Skip = true
			end,
		}
	end
	return showToast(data, kind)
end

function Library:ClearNotifications()
	for _, toast in ipairs(table.clone(Toasts.List)) do
		toast.Close()
	end
	table.clear(Island.Queue)
	Island.Skip = true
end

