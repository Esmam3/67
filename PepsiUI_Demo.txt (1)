local function defaultLogo(parent, size, letter)
	local tile = create("Frame", { Name = "Logo", BackgroundColor3 = "AccentA", Size = UDim2.fromOffset(size, size), Parent = parent })
	corner(math.floor(size * 0.3), tile)
	gradient(tile, 45)
	text({
		Parent = tile,
		Text = tostring(letter or "P"):sub(1, 1):upper(),
		Font = "Heavy",
		Size = math.floor(size * 0.55),
		Color = "OnAccent",
		XAlign = Enum.TextXAlignment.Center,
		Sz = UDim2.fromScale(1, 1),
	})
	return tile
end

local function makeLogo(parent, size, logo, title)
	if type(logo) == "function" then
		local ok, made = pcall(logo, parent, size)
		if ok and made then
			return made
		end
	elseif logo ~= nil and logo ~= false then
		local id = iconId(logo)
		if id then
			local image = create("ImageLabel", { Name = "Logo", BackgroundTransparency = 1, Image = id, Size = UDim2.fromOffset(size, size), Parent = parent })
			corner(math.floor(size * 0.3), image)
			return image
		end
	end
	return defaultLogo(parent, size, title)
end
Library.MakeLogo = makeLogo

local function iconButton(parent, name, glyph, size, onClick, opts)
	opts = opts or {}
	local b = create("TextButton", {
		Name = name,
		AutoButtonColor = false,
		Text = "",
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = "Element",
		BackgroundTransparency = 0.45,
		LayoutOrder = opts.Order or 0,
		ZIndex = opts.Z or 4,
		Parent = parent,
	})
	corner(10, b)
	local s = stroke(b, 0.93)
	local img = icon(b, glyph, math.floor(size * 0.5), "SubText", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = (opts.Z or 4) + 1 })
	local scale = create("UIScale", { Parent = b })
	b.MouseEnter:Connect(function()
		tween(b, { BackgroundColor3 = opts.Danger and Theme.Error or Theme.ElementHover, BackgroundTransparency = opts.Danger and 0.15 or 0.1 }, 0.15)
		tween(img, { ImageColor3 = opts.Danger and Color3.new(1, 1, 1) or Theme.Text }, 0.15)
		tween(s, { Transparency = 0.85 }, 0.15)
		sfx("Hover")
	end)
	b.MouseLeave:Connect(function()
		tween(b, { BackgroundColor3 = Theme.Element, BackgroundTransparency = 0.45 }, 0.18)
		tween(img, { ImageColor3 = Theme.SubText }, 0.18)
		tween(s, { Transparency = 0.93 }, 0.18)
	end)
	b.MouseButton1Down:Connect(function()
		tween(scale, { Scale = 0.88 }, 0.08)
	end)
	b.MouseButton1Up:Connect(function()
		tween(scale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
	end)
	b.MouseLeave:Connect(function()
		tween(scale, { Scale = 1 }, 0.2)
	end)
	b.Activated:Connect(function()
		sfx("Click")
		safeCall(onClick)
	end)
	painter(function()
		b.BackgroundColor3 = Theme.Element
		img.ImageColor3 = Theme.SubText
	end)
	if opts.Tooltip then
		attachTooltip(b, opts.Tooltip)
	end
	return b, img
end

function Library:CreateWindow(opts)
	opts = opts or {}
	-- Running the script again replaces the old menu instead of stacking a second one.
	local env = (type(getgenv) == "function" and getgenv()) or _G
	if not opts.KeepOthers then
		pcall(function()
			local old = rawget(env, "__PepsiUI")
			if old and old ~= Library and type(old.Unload) == "function" and not old.Unloaded then
				old:Unload()
			end
		end)
	end
	pcall(function()
		env.__PepsiUI = Library
	end)

	Library:LoadSettings()
	local mobile = opts.Mobile
	if mobile == nil then
		mobile = Library.Mobile
	end
	Library.Mobile = mobile
	Library.DefaultTitle = opts.Title or "Pepsi Hub"
	local stateKey = mobile and "Mobile" or "PC"
	local state = Library.WindowState[stateKey]
	if type(state) ~= "table" then
		state = {}
		Library.WindowState[stateKey] = state
	end

	local baseW, baseH = mobile and MOBILE_W or BASE_W, mobile and MOBILE_H or BASE_H
	if opts.Size then
		baseW, baseH = opts.Size.X.Offset, opts.Size.Y.Offset
	end
	local self = setmetatable({
		Title = opts.Title or "Pepsi Hub",
		Subtitle = opts.Subtitle or "",
		Tabs = {},
		Entries = {},
		Elements = {},
		Open = true,
		Mobile = mobile,
		ToggleKey = toKey(state.ToggleKey) or opts.ToggleKey or Enum.KeyCode.RightControl,
		ConfigFolder = opts.ConfigFolder or (Library.Folder .. "/configs/" .. tostring(game.PlaceId)),
		RowHeight = mobile and 44 or 40,
		BaseW = baseW,
		BaseH = baseH,
		W = math.clamp(tonumber(state.W) or baseW, MIN_W, MAX_W),
		H = math.clamp(tonumber(state.H) or baseH, MIN_H, MAX_H),
		PosX = tonumber(state.X) or 0,
		PosY = tonumber(state.Y) or 0,
		UserScale = Settings.MenuScale or 1,
		TargetScale = 1,
		State = state,
		Opts = opts,
		Unread = 0,
	}, Window)
	self.CurX, self.CurY = self.PosX, self.PosY
	table.insert(Library.Windows, self)
	if opts.Accent then
		Theme.AccentA = fromHex(opts.Accent[1]) or Theme.AccentA
		Theme.AccentB = fromHex(opts.Accent[2]) or Theme.AccentB
		derive()
	end
	if opts.Theme and Settings.Theme == "Pepsi" then
		loadPreset(opts.Theme)
		derive()
	end
	preloadSounds()

	local gui = newScreen("PepsiUI", 200)
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	end)
	self.Gui = gui

	local holder = create("Frame", {
		Name = "Holder",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, self.PosX, 0.5, self.PosY),
		Size = UDim2.fromOffset(self.W, self.H),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	self.Holder = holder
	self.Scale = create("UIScale", { Scale = 1, Parent = holder })
	self.Shadows = {}
	-- Soft shadow: many faint layers, a bit lower than the window.
	local SHADOW = { { 48, 0.975 }, { 34, 0.965 }, { 22, 0.95 }, { 12, 0.93 }, { 4, 0.9 } }
	self.ShadowSpec = SHADOW
	for i, layer in ipairs(SHADOW) do
		local shadow = create("Frame", {
			Name = "Shadow",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 10),
			Size = UDim2.new(1, layer[1], 1, layer[1]),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = layer[2],
			Parent = holder,
		})
		corner(16 + layer[1] / 2, shadow)
		self.Shadows[i] = shadow
	end

	local main = create("Frame", {
		Name = "Main",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = "Background",
		ClipsDescendants = true,
		Parent = holder,
	})
	glass(main, 0.02)
	corner(16, main)
	self.MainStroke = stroke(main, 0.86)
	self.Main = main

	-- Background: two soft accent glows, rising bubbles and a glow that follows the mouse.
	local decor = create("Frame", { Name = "Decor", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = main })
	self.Decor = decor
	local glowA = glowBlob(decor, 440, "AccentA", 0.026, 12)
	glowA.Position = UDim2.new(1, -40, 0, -30)
	local glowB = glowBlob(decor, 400, "AccentB", 0.024, 12)
	glowB.Position = UDim2.new(0, 60, 1, 40)
	self.Glows = { glowA, glowB }
	self:BuildFizz()
	if not mobile then
		self:BuildCursorGlow()
	end

	-- ---------------- sidebar ----------------
	local collapsed = Settings.Collapsed
	if collapsed == nil then
		collapsed = mobile
	end
	if opts.Collapsed ~= nil and Settings.Collapsed == nil then
		collapsed = opts.Collapsed
	end
	self.Collapsed = collapsed
	local sideW = collapsed and SIDEBAR_MIN or SIDEBAR_W
