local function choiceList(self, opts, multi)
	opts = opts or {}
	local options = {}
	for _, v in ipairs(opts.Options or opts.Values or {}) do
		table.insert(options, tostring(v))
	end
	local rowH = self.Window.Mobile and 34 or 28
	local e = newElement(self, multi and "Checkboxes" or "Radio", opts, self.Window.RowHeight + #options * rowH)
	e.Options = options
	if multi then
		e.Value = {}
		for k, v in pairs(opts.Default or {}) do
			if v == true then
				table.insert(e.Value, tostring(k))
			elseif type(k) == "number" then
				table.insert(e.Value, tostring(v))
			end
		end
	else
		e.Value = opts.Default ~= nil and tostring(opts.Default) or options[1]
	end
	local holder = create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, e.TopHeight - 6), Size = UDim2.new(1, -20, 0, #options * rowH), ZIndex = 4, Parent = e.Frame })
	local rows = {}
	for i, v in ipairs(options) do
		local b = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = "ElementHover", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, (i - 1) * rowH), Size = UDim2.new(1, 0, 0, rowH - 2), ZIndex = 5, Parent = holder })
		corner(7, b)
		local mark = create("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 6, 0.5, 0), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = "Field", ZIndex = 6, Parent = b })
		corner(multi and UDim.new(0, 5) or UDim.new(1, 0), mark)
		local markStroke = stroke(mark, 0.75)
		local dot = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = multi and UDim2.fromScale(1, 1) or UDim2.fromOffset(8, 8), BackgroundColor3 = "AccentA", ZIndex = 7, Parent = mark })
		corner(multi and UDim.new(0, 5) or UDim.new(1, 0), dot)
		gradient(dot, 45)
		local dotScale = create("UIScale", { Scale = 0, Parent = dot })
		if multi then
			icon(dot, "check", 11, "OnAccent", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 8 })
		end
		local l = text({ Parent = b, Text = v, Size = 13, Color = "SubText", Pos = UDim2.fromOffset(30, 0), Sz = UDim2.new(1, -36, 1, 0), Truncate = true, Z = 6 })
		rows[v] = { Button = b, Scale = dotScale, Label = l, Stroke = markStroke }
		b.MouseEnter:Connect(function()
			tween(b, { BackgroundTransparency = 0.6 }, 0.1)
		end)
		b.MouseLeave:Connect(function()
			tween(b, { BackgroundTransparency = 1 }, 0.12)
		end)
		b.Activated:Connect(function()
			if e.Locked then
				return
			end
			if multi then
				local list3 = table.clone(e.Value)
				local idx = table.find(list3, v)
				if idx then
					table.remove(list3, idx)
				else
					table.insert(list3, v)
				end
				sfx(idx and "ToggleOff" or "ToggleOn", 1.15, 0.7)
				e:Set(list3)
			else
				if e.Value ~= v then
					sfx("Click")
				end
				e:Set(v)
			end
		end)
	end
	local function isOn(v)
		if multi then
			return table.find(e.Value, v) ~= nil
		end
		return e.Value == v
	end
	local function render(animate)
		for v, r in pairs(rows) do
			local on = isOn(v)
			if animate and Settings.Animations then
				tween(r.Scale, { Scale = on and 1 or 0 }, on and 0.3 or 0.15, on and Enum.EasingStyle.Back or Enum.EasingStyle.Quint)
			else
				r.Scale.Scale = on and 1 or 0
			end
			paint(r.Label, { TextColor3 = on and Theme.Text or Theme.SubText }, animate, 0.15)
			paint(r.Stroke, { Transparency = on and 1 or 0.75 }, animate, 0.15)
		end
	end
	painter(function()
		render(false)
	end)
	function e:Set(value, silent)
		if multi then
			local out = {}
			for k, v in pairs(type(value) == "table" and value or {}) do
				if v == true then
					table.insert(out, tostring(k))
				elseif type(k) == "number" and table.find(options, tostring(v)) then
					table.insert(out, tostring(v))
				end
			end
			self.Value = out
			render(true)
			if not silent then
				self:_emit(table.clone(out))
			end
		else
			value = tostring(value)
			if not table.find(options, value) or value == self.Value then
				return
			end
			self.Value = value
			render(true)
			if not silent then
				self:_emit(value)
			end
		end
	end
	register(e, opts)
	render(false)
	return e
end

