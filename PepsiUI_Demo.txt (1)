-- ======================================================================
-- Search / command palette (Ctrl+K): finds any tab, section or feature
-- ======================================================================
local TypeIcons = {
	Tab = "layout-grid", Page = "panel-top", Section = "layers", Toggle = "toggle-right", Slider = "sliders-horizontal",
	RangeSlider = "sliders-horizontal", Dropdown = "list", Button = "mouse-pointer-click", Textbox = "text-cursor-input",
	Keybind = "keyboard", Colorpicker = "palette", Stepper = "plus", Segmented = "toggle-left", Radio = "circle-dot",
	Checkboxes = "list-checks", Chips = "tags", Paragraph = "file-text", Progress = "loader", Console = "terminal",
}

local Unsearchable = { Label = true, Stats = true, Graph = true, Image = true, Viewport = true, Code = true, Console = true }

-- Things inside a hidden "depends on" group can't be jumped to.
local function reachable(element)
	local container = element.Container
	while container do
		if container.Dependent and container.Collapsed then
			return false
		end
		container = container.Container
	end
	return true
end

function Window:_searchIndex()
	local index = {}
	for _, tab in ipairs(self.Tabs) do
		local isSettings = tab == self.SettingsTab
		local first = #index + 1
		if not tab.Hidden then
			table.insert(index, { Name = tab.Name, Path = "Tab", Icon = tab.IconName or "layout-grid", Kind = "Tab", Search = tab.Name .. " " .. (tab.Description or ""), Run = function()
				self:SelectTab(tab)
			end })
			for p, page in ipairs(tab.Pages) do
				if #tab.Pages > 1 then
					table.insert(index, { Name = page.Name, Path = tab.Name, Icon = "panel-top", Kind = "Page", Search = page.Name, Run = function()
						self:SelectTab(tab, p)
					end })
				end
				for _, section in ipairs(page.Sections) do
					local where = tab.Name .. (#tab.Pages > 1 and (" › " .. page.Name) or "")
					if section.Name ~= "" then
						table.insert(index, { Name = section.Name, Path = where, Icon = section.IconName or "layers", Kind = "Section", Search = section.Name, Run = function()
							self:JumpTo(section)
						end })
					end
					for _, element in ipairs(section.AllElements) do
						if element.Name and element.Name ~= "" and not element.Hidden and element.Type and not Unsearchable[element.Type] and reachable(element) then
							table.insert(index, {
								Name = element.Name,
								Path = where .. (section.Name ~= "" and (" › " .. section.Name) or ""),
								Icon = TypeIcons[element.Type] or "circle-dot",
								Kind = element.Type,
								Search = element.Name .. " " .. (element.DescriptionText or ""),
								Element = element,
								Run = function()
									self:JumpTo(element)
								end,
							})
						end
					end
				end
			end
		end
		if isSettings then
			for i = first, #index do
				index[i].Settings = true
			end
		end
	end
	return index
end

