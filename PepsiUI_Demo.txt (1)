	return self:Slider(opts)
end

-- ======================================================================
-- Range slider: two handles for a "from - to" value, like 20 - 60
-- ======================================================================
function Section:RangeSlider(opts)
	opts = opts or {}
	local min, max = tonumber(opts.Min) or 0, tonumber(opts.Max) or 100
	if max < min then
		min, max = max, min
	end
	local step = tonumber(opts.Increment or opts.Step) or 1
	local gap = math.max(0, tonumber(opts.MinGap or opts.Gap) or 0)
	local snap, decimals = makeSnap(min, max, step)
	local fmt = formatter(opts, decimals)
	local e = newElement(self, "RangeSlider", opts, self.Window.RowHeight + 18)
	e.Min, e.Max, e.Step = min, max, step
	local d = opts.Default or opts.Value or { min, max }
	local low = snap(d[1] or d.Min or min)
	local high = snap(d[2] or d.Max or max)
	if low > high then
		low, high = high, low
	end
	local function pack(a, b)
		return { a, b, Min = a, Max = b }
	end
	e.Value = pack(low, high)
	local box = valueBox(e)
	e.Title.Size = UDim2.new(1, -150, 0, 18)
	local track, fill = sliderTrack(e)
	local knobA, strokeA, bubbleA, scaleA = sliderKnob(track)
	local knobB, strokeB, bubbleB, scaleB = sliderKnob(track)
	local active
	local function alphaOf(v)
		return max == min and 0 or (v - min) / (max - min)
	end
	local function render(animate)
		local a, b = alphaOf(e.Value[1]), alphaOf(e.Value[2])
		local t = animate and 0.12 or 0
		paint(fill, { Position = UDim2.fromScale(a, 0), Size = UDim2.fromScale(b - a, 1) }, animate, t)
		paint(knobA, { Position = UDim2.fromScale(a, 0.5) }, animate, t)
		paint(knobB, { Position = UDim2.fromScale(b, 0.5) }, animate, t)
		if not box:IsFocused() then
			box.Text = fmt(e.Value[1]) .. "  -  " .. fmt(e.Value[2])
		end
		bubbleA.Text = fmt(e.Value[1])
		bubbleB.Text = fmt(e.Value[2])
		-- Keep the knob you're dragging on top.
		knobA.ZIndex = active == 1 and 7 or 6
		knobB.ZIndex = active == 2 and 7 or 6
	end
	e.Render = render
	local function apply(a, b, silent)
		a, b = snap(a), snap(b)
		if a > b then
			a, b = b, a
		end
		if b - a < gap then
			if active == 1 then
				a = math.max(min, b - gap)
			else
				b = math.min(max, a + gap)
			end
		end
		if a == e.Value[1] and b == e.Value[2] then
			render(false)
			return
		end
		e.Value = pack(a, b)
		render(active == nil)
		if active then
			sfx("Slide", 0.85 + alphaOf(active == 1 and a or b) * 0.6)
		end
		if not silent then
			e:_emit(pack(a, b))
		elseif e.Flag then
			Library.Flags[e.Flag] = e.Value
		end
	end
	function e:Set(value, maybeHigh, silent)
		if type(value) == "number" then
			apply(value, tonumber(maybeHigh) or self.Value[2], silent)
		elseif type(value) == "table" then
			apply(value[1] or value.Min or self.Value[1], value[2] or value.Max or self.Value[2], maybeHigh == true or silent)
		end
	end
	function e:SetLow(v)
		apply(v, self.Value[2])
	end
	function e:SetHigh(v)
		apply(self.Value[1], v)
	end
	function e:ValueText()
		return fmt(self.Value[1]) .. " - " .. fmt(self.Value[2])
	end
	local function valueAt(input)
		local x = (input.Position.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X)
		return min + math.clamp(x, 0, 1) * (max - min)
	end
	local function move(input)
		local v = valueAt(input)
		if active == 1 then
			apply(math.min(v, e.Value[2] - gap), e.Value[2])
		else
			apply(e.Value[1], math.max(v, e.Value[1] + gap))
		end
	end
	local hit = hitbox(track, 8, UDim2.new(1, 16, 0, 30), UDim2.new(0, -8, 0.5, -15))
	hit.InputBegan:Connect(function(input)
		if not isPress(input) or e.Locked then
			return
		end
		local v = valueAt(input)
		local da, db = math.abs(v - e.Value[1]), math.abs(v - e.Value[2])
		if da == db then
			active = v < e.Value[1] and 1 or 2
		else
			active = da < db and 1 or 2
		end
		local knob = active == 1 and knobA or knobB
		local bubble, bscale = active == 1 and bubbleA or bubbleB, active == 1 and scaleA or scaleB
		local scroll = e.Page and e.Page.Scroll
		if scroll then
			scroll.ScrollingEnabled = false
		end
		tween(knob, { Size = UDim2.fromOffset(18, 18) }, 0.15, Enum.EasingStyle.Back)
		showBubble(bubble, bscale, true)
		move(input)
		startDrag(input, move, function()
			if scroll then
				scroll.ScrollingEnabled = true
			end
			tween(knob, { Size = UDim2.fromOffset(14, 14) }, 0.25, Enum.EasingStyle.Back)
			showBubble(bubble, bscale, false)
			active = nil
			render(false)
		end)
	end)
	box.Focused:Connect(function()
		box.Text = tostring(e.Value[1]) .. " - " .. tostring(e.Value[2])
	end)
	box.FocusLost:Connect(function()
		local nums = {}
		for n in box.Text:gmatch("%-?%d+%.?%d*") do
			table.insert(nums, tonumber(n))
		end
		if #nums >= 2 then
			apply(nums[1], nums[2])
		elseif #nums == 1 then
			shake(box)
		end
		render(false)
	end)
	register(e, opts)
	render(false)
	return e
end
Section.Range = Section.RangeSlider
Section.DualSlider = Section.RangeSlider
Section.AddRangeSlider = Section.RangeSlider

