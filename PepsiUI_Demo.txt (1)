function Library:PlaySound(name, pitch, volume)
	if not Settings.Sounds or self.Unloaded or Settings.Volume <= 0 then
		return
	end
	if name == "Hover" and not Settings.HoverSounds then
		return
	end
	local def = soundDef(name)
	if not def then
		return
	end
	local now = os.clock()
	local gap = (name == "Slide" or name == "Type") and 0.035 or 0.05
	if SoundLast[name] and now - SoundLast[name] < gap then
		return
	end
	SoundLast[name] = now
	local s = getSound(name, def)
	s.Volume = def[2] * Settings.Volume * 2 * (volume or 1)
	s.PlaybackSpeed = def[3] * (pitch or 1)
	local ok = pcall(function()
		SoundService:PlayLocalSound(s)
	end)
	if not ok then
		pcall(function()
			s.TimePosition = 0
			s:Play()
		end)
	end
end

