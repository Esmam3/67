function Library:GetTheme()
	local out = {}
	for slot in pairs(DefaultTheme) do
		out[slot] = Theme[slot]
	end
	return out
end

-- A short text that holds the whole theme (to share it with friends).
function Library:ExportTheme()
	local parts = {}
	for _, entry in ipairs(ThemeSlots) do
		table.insert(parts, toHex(Theme[entry[1]]))
	end
	return "PEPSI-" .. table.concat(parts, "-")
end

function Library:ImportTheme(code)
	code = tostring(code or ""):gsub("%s", "")
	local hexes = {}
	for hex in code:gmatch("%x%x%x%x%x%x") do
		table.insert(hexes, hex)
	end
	if #hexes < #ThemeSlots then
		local ok, data = pcall(function()
			return HttpService:JSONDecode(code)
		end)
		if ok and type(data) == "table" then
			return self:SetTheme(data, true)
		end
		return false
	end
	for i, entry in ipairs(ThemeSlots) do
		local c = fromHex(hexes[i])
		if c then
			Theme[entry[1]] = c
		end
	end
	Settings.Theme = "Custom"
	applyTheme(true)
	queueSave()
	return true
end

