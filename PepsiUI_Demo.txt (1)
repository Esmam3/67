--[[
	Pepsi UI v2.1 demo
	Loads the library from GitHub and builds a window with every element, so you can try it all.
	Your own scripts load the library the same way (see PepsiUI_Example.lua).
]]
local LIBRARY_URL = "https://raw.githubusercontent.com/Esmam3/67/refs/heads/main/pepsihubUI.txt"

local function pepsiToast(title, body)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", { Title = title, Text = body, Duration = 8 })
	end)
end
print("[Pepsi UI] loading the demo...")
local pepsiOk, pepsiError = xpcall(function()
local source = game:HttpGet(LIBRARY_URL)
local chunk, compileError = loadstring(source)
if not chunk then
	error("could not load Pepsi UI from " .. LIBRARY_URL .. ": " .. tostring(compileError))
end
local UI = chunk()
-- ======================================================================
-- Pepsi UI v2.1 demo: every element and feature in one window.
-- ======================================================================
local load = UI:Loader({ Title = "Pepsi Hub", Subtitle = "Pepsi UI demo" })
load:Step("Building the menu", 0.15)

local Window = UI:CreateWindow({
	Title = "Pepsi Hub",
	Subtitle = "UI demo",
	Badge = "v2.1",
	ToggleKey = Enum.KeyCode.RightControl,
	StartHidden = true,
})

-- ---------------------------------------------------------------- Home
Window:Category("Overview")
Window:BuildHome({
	Changelog = {
		{ Title = "Pepsi UI v2.1", Changes = { "Cleaner see-through look and new Pepsi blue colours", "Tabs on the side or across the top, switches or checkboxes: pick in Settings", "The Pepsi Hub logo is the open button" } },
		{ Title = "Pepsi UI v2", Changes = { "Live theme editor with a picker for every colour", "Range sliders, chips, steppers, segmented pills", "Sounds, island notifications, command search" } },
	},
	Discord = "https://discord.gg/pepsihub",
})

-- ---------------------------------------------------------------- Basics
load:Step("Adding toggles and sliders", 0.3)
Window:Category("Elements")
local Basics = Window:Tab({ Name = "Basics", Icon = "toggle-right", Description = "Toggles, sliders and buttons", Badge = "New" })

local toggles = Basics:Section({ Name = "Toggles", Icon = "toggle-right", Side = "Left", Description = "Right click or hold any row for more" })
local autoFarm = toggles:Toggle({
	Name = "Auto farm",
	Description = "Has a keybind and a colour on the right",
	Flag = "AutoFarm",
	Tooltip = "Press F to flip it, even with the menu closed",
	Callback = function(on)
		UI:Notify({ Title = "Auto farm", Content = on and "Started farming." or "Stopped.", Type = on and "Success" or "Info", Duration = 2 })
	end,
})
autoFarm:AddKeybind({ Default = "F", Flag = "AutoFarmKey" })
autoFarm:AddColorpicker({ Default = Color3.fromRGB(255, 70, 110), Flag = "AutoFarmColor" })
local farmMore = autoFarm:Settings()
farmMore:Slider({ Name = "Farm radius", Min = 10, Max = 200, Default = 60, Suffix = " studs", Flag = "FarmRadius" })
farmMore:Dropdown({ Name = "Priority", Options = { "Closest", "Weakest", "Strongest" }, Default = "Closest", Flag = "FarmPriority" })
toggles:Toggle({ Name = "Checkbox style", Description = "Style = \"Checkbox\" keeps it a checkbox", Style = "Checkbox", Default = true, Flag = "Checkbox" })
toggles:Toggle({ Name = "Risky feature", Description = "Shown in warning colour", Risky = true, Flag = "Risky" })
local locked = toggles:Toggle({ Name = "Locked feature", Description = "Tap it to see why", Flag = "Locked" })
locked:SetLocked(true, "This one is for VIP users only.")
local showExtra = toggles:Toggle({ Name = "Show extra options", Description = "Opens the group below", Flag = "ShowExtra" })
local extra = toggles:Group({ DependsOn = showExtra, Value = true })
extra:Slider({ Name = "Extra speed", Min = 1, Max = 10, Default = 5, Flag = "ExtraSpeed" })
extra:Toggle({ Name = "Extra safety", Default = true, Flag = "ExtraSafety" })

local sliders = Basics:Section({ Name = "Sliders", Icon = "sliders-horizontal", Side = "Right" })
sliders:Slider({ Name = "Walk speed", Min = 16, Max = 250, Default = 16, Suffix = " ws", Flag = "WalkSpeed", Tooltip = "Double click (or double tap) to reset" })
sliders:Slider({ Name = "Precision", Min = 0, Max = 1, Default = 0.5, Increment = 0.01, Flag = "Precision" })
sliders:Slider({ Name = "Steps", Min = 0, Max = 10, Default = 4, Ticks = 10, Flag = "Steps" })
sliders:RangeSlider({ Name = "Delay between hits", Min = 0, Max = 100, Default = { 20, 60 }, MinGap = 5, Suffix = "ms", Flag = "HitDelay" })
sliders:RangeSlider({ Name = "Level range", Min = 0, Max = 2500, Default = { 300, 1200 }, Increment = 50, Compact = true, Flag = "LevelRange" })
sliders:Stepper({ Name = "Quest amount", Min = 1, Max = 50, Default = 5, Flag = "QuestAmount" })

local buttons = Basics:Section({ Name = "Buttons", Icon = "mouse-pointer-click", Side = "Left" })
buttons:Button({ Name = "Primary", Style = "Primary", Icon = "zap", Callback = function()
	UI:Notify({ Title = "Clicked", Content = "Primary button.", Duration = 2 })
end })
buttons:Button({ Name = "Normal button", Description = "With a description" })
buttons:Button({ Name = "Hold to confirm", Description = "Keep holding for a second", Hold = 1, Icon = "hand", Callback = function()
	UI:Notify({ Title = "Held!", Type = "Success", Duration = 2 })
end })
buttons:Button({ Name = "Click twice", Description = "Asks before it runs", Confirm = true, Style = "Danger", Icon = "trash-2", Callback = function()
	UI:Notify({ Title = "Done", Content = "You confirmed it.", Type = "Warning", Duration = 2 })
end })
buttons:Button({ Name = "Cooldown", Description = "Can't spam it", Cooldown = 3, Style = "Outline", Icon = "timer" })
buttons:Button({ Name = "Loading", Description = "Shows a spinner while it works", Loading = true, Icon = "download", Callback = function()
	task.wait(2)
end })
buttons:Buttons({
	{ Name = "Save", Icon = "save", Style = "Primary" },
	{ Name = "Load", Icon = "download" },
	{ Name = "Clear", Icon = "x", Style = "Danger" },
})

-- Tab box: the little tabs are the card header.
local aim = Basics:TabBox({ Side = "Right" })
local aimMain = aim:Tab("Aimbot")
aimMain:Toggle({ Name = "Enabled", Flag = "AimEnabled" }):AddKeybind({ Default = "MouseButton2", Mode = "Hold", Flag = "AimKey" })
aimMain:Toggle({ Name = "Visible check", Default = true, Flag = "AimVisible" })
aimMain:Dropdown({ Name = "Target part", Options = { "Head", "Torso", "Closest" }, Default = "Head", Flag = "AimPart" })
local aimSmooth = aim:Tab("Smoothness")
aimSmooth:Slider({ Name = "Smoothness", Min = 1, Max = 20, Default = 6, Flag = "AimSmooth" })
aimSmooth:Toggle({ Name = "Humanize", Flag = "AimHuman" })
local aimFov = aim:Tab("FOV")
aimFov:Toggle({ Name = "Show circle", Default = true, Flag = "AimShowFov" }):AddColorpicker({ Default = Color3.fromRGB(240, 240, 255), Flag = "AimFovColor" })
aimFov:Slider({ Name = "Radius", Min = 20, Max = 600, Default = 160, Suffix = " px", Flag = "AimFovRadius" })

-- ---------------------------------------------------------------- Inputs
load:Step("Adding inputs", 0.45)
local Inputs = Window:Tab({ Name = "Inputs", Icon = "text-cursor-input", Description = "Dropdowns, text, keys and colours" })
local drops = Inputs:Section({ Name = "Dropdowns", Icon = "list", Side = "Left" })
drops:Dropdown({ Name = "Weapon", Options = { "Melee", "Sword", "Fruit", "Gun" }, Default = "Sword", Flag = "Weapon" })
drops:Dropdown({ Name = "Mobs", Description = "Pick as many as you like", Options = { "Bandit", "Pirate", "Marine", "Brute", "Gladiator", "Military", "Fishman", "Sky bandit" }, Multi = true, Default = { "Bandit" }, Flag = "Mobs" })
drops:Dropdown({ Name = "With icons", Options = { { Name = "Sword", Icon = "sword" }, { Name = "Shield", Icon = "shield" }, { Name = "Gem", Icon = "gem", Description = "Rare drop" } }, Flag = "IconDrop" })
drops:PlayerDropdown({ Name = "Target player", Flag = "TargetPlayer" })

local text = Inputs:Section({ Name = "Text", Icon = "type", Side = "Right" })
text:Textbox({ Name = "Username", Placeholder = "type a name", MaxLength = 20, Flag = "Username" })
text:Textbox({ Name = "Webhook", Placeholder = "secret", Password = true, Flag = "Webhook" })
text:Textbox({ Name = "Amount", Placeholder = "numbers only", Numeric = true, Flag = "Amount" })
text:Textbox({ Name = "Notes", Placeholder = "Write anything...", Multiline = true, Flag = "Notes" })

local keys = Inputs:Section({ Name = "Keybinds", Icon = "keyboard", Side = "Left" })
keys:Keybind({ Name = "Panic key", Default = "P", Flag = "PanicKey", Callback = function(state)
	UI:Notify({ Title = "Panic key", Content = "State: " .. tostring(state), Duration = 2 })
end })
keys:Keybind({ Name = "Sprint", Default = "LeftShift", Mode = "Hold", Flag = "SprintKey" })
keys:Label("On phones these become on-screen buttons you can drag anywhere.", { Icon = "smartphone" })

local colors = Inputs:Section({ Name = "Colours", Icon = "palette", Side = "Right" })
colors:Colorpicker({ Name = "ESP colour", Default = Color3.fromRGB(80, 160, 255), Flag = "EspColor" })
colors:Colorpicker({ Name = "Glow (with alpha)", Default = Color3.fromRGB(255, 120, 60), Transparency = 0.3, Flag = "GlowColor" })
colors:Colorpicker({ Name = "Rainbow", Default = Color3.fromRGB(255, 0, 0), Rainbow = true, Flag = "RainbowColor" })

-- ---------------------------------------------------------------- Layout
load:Step("Adding layouts", 0.6)
local Layout = Window:Tab({ Name = "Layout", Icon = "layout-dashboard", Description = "Pages, tab boxes and pickers" })
local pageA = Layout:SubTab("Pickers")
local pageB = Layout:SubTab("Boxes")
local pickers = pageA:Section({ Name = "Pickers", Icon = "circle-dot", Side = "Left" })
pickers:Segmented({ Name = "Mode", Options = { "Safe", "Fast" }, Flag = "Mode" })
pickers:Segmented({ Name = "Server region", Options = { "Auto", "EU", "US", "Asia" }, Flag = "Region" })
pickers:Radio({ Name = "Server", Options = { "Smallest", "Biggest", "Random" }, Flag = "ServerPick" })
local chipsSection = pageA:Section({ Name = "Chips", Icon = "tags", Side = "Right" })
chipsSection:Chips({ Name = "Chests to open", Options = { "Common", "Rare", "Epic", "Legendary", "Mythic", "Event" }, Default = { "Rare", "Epic" }, Flag = "Chests" })
chipsSection:Checkboxes({ Name = "Auto collect", Options = { "Coins", "Gems", "Fruits" }, Default = { "Coins" }, Flag = "Collect" })
local folded = pageA:Section({ Name = "Folded section", Icon = "layers", Side = "Right", Collapsible = true, Collapsed = true, Description = "Click the header" })
folded:Paragraph({ Title = "Hidden until opened", Content = "Sections can start folded so long menus stay tidy." })

local box = pageB:TabBox({ Name = "Tab box", Side = "Left" })
local boxA = box:Tab("Players")
boxA:Toggle({ Name = "Enabled", Flag = "EspEnabled" })
boxA:Slider({ Name = "Max distance", Min = 50, Max = 2000, Default = 800, Suffix = " studs", Flag = "EspDistance" })
local boxB = box:Tab("ESP")
boxB:Toggle({ Name = "Boxes", Default = true, Flag = "EspBoxes" })
boxB:Toggle({ Name = "Names", Flag = "EspNames" })
local boxC = box:Tab("Misc")
boxC:Button({ Name = "Rejoin", Icon = "refresh-cw", Callback = function()
	UI:Rejoin()
end })
local texts = pageB:Section({ Name = "Text blocks", Icon = "file-text", Side = "Right" })
texts:Paragraph({ Title = "Paragraph", Content = "Supports <b>bold</b>, <i>italic</i> and <font color=\"#FF4060\">colour</font>.", Icon = "info" })
texts:Label("A simple label with an icon.", { Icon = "sparkles" })
texts:Divider("Divider with text")
texts:Code({ Name = "Loadstring", Text = "loadstring(game:HttpGet(\"https://your.link/PepsiUI.lua\"))()" })
texts:Link({ Name = "Copy a link", Url = "https://discord.gg/pepsihub" })

-- ---------------------------------------------------------------- Live data
load:Step("Adding live widgets", 0.75)
local Live = Window:Tab({ Name = "Live", Icon = "activity", Description = "Numbers that update by themselves" })
local cards = Live:Section({ Name = "Stats", Icon = "gauge", Side = "Full" })
local stats = cards:Stats({
	{ Name = "Coins", Value = 0, Icon = "coins" },
	{ Name = "Gems", Value = 0, Icon = "gem" },
	{ Name = "Kills", Value = 0, Icon = "swords" },
	{ Name = "Level", Value = 1, Icon = "trophy" },
}, { Columns = 4 })
local progress = Live:Section({ Name = "Progress", Icon = "loader", Side = "Left" })
local levelBar = progress:Progress({ Name = "Level progress", Value = 0 })
local questBar = progress:Progress({ Name = "Quest", Value = 0, Max = 30, Format = function(v, max)
	return math.floor(v) .. " / " .. max
end })
local graph = progress:Graph({ Name = "Coins per second", Suffix = "/s" })
local logs = Live:Section({ Name = "Console", Icon = "terminal", Side = "Right" })
local console = logs:Console({ Name = "Farm log", Height = 170 })
console:Log("Pepsi UI v2.1 loaded", "Success")
logs:Viewport({ Object = "Character", Height = 170 })

-- ---------------------------------------------------------------- Feedback
load:Step("Adding notifications", 0.85)
local Feedback = Window:Tab({ Name = "Feedback", Icon = "bell", Description = "Notifications, dialogs and sounds" })
local notes = Feedback:Section({ Name = "Notifications", Icon = "bell-ring", Side = "Left" })
for _, kind in ipairs({ "Info", "Success", "Warning", "Error" }) do
	notes:Button({ Name = kind, Icon = kind == "Info" and "bell" or kind == "Success" and "circle-check" or kind == "Warning" and "triangle-alert" or "circle-x", Callback = function()
		UI:Notify({ Title = kind .. " notification", Content = "Hover to pause it, swipe it away or check the bell later.", Type = kind })
	end })
end
notes:Button({ Name = "With buttons", Icon = "mouse-pointer-click", Callback = function()
	UI:Notify({ Title = "Update ready", Content = "Pepsi Hub has a new version.", Buttons = {
		{ Name = "Update", Callback = function()
			UI:Notify({ Title = "Updating...", Type = "Success", Duration = 2 })
		end },
		{ Name = "Later" },
	} })
end })
notes:Segmented({ Name = "Style", Options = { "Stack", "Island" }, Default = UI.Settings.NotifyStyle, NoSave = true, Callback = function(v)
	UI:SetSetting("NotifyStyle", v)
end })
local dialogs = Feedback:Section({ Name = "Dialogs", Icon = "app-window", Side = "Right" })
dialogs:Button({ Name = "Confirm", Icon = "circle-check", Callback = function()
	Window:Confirm("Delete config?", "This can't be undone.", function()
		UI:Notify({ Title = "Deleted", Type = "Success", Duration = 2 })
	end, { Icon = "trash-2", Yes = "Delete" })
end })
dialogs:Button({ Name = "Prompt", Icon = "pencil", Callback = function()
	Window:Prompt("Name your config", "my config", function(name)
		UI:Notify({ Title = "You typed", Content = tostring(name), Duration = 3 })
	end)
end })
dialogs:Button({ Name = "Alert", Icon = "info", Callback = function()
	Window:Alert("Heads up", "Dialogs block the menu until you answer them.")
end })
dialogs:Button({ Name = "Search everything", Description = Window.Mobile and "Find any feature" or "Ctrl+K works too", Icon = "search", Callback = function()
	Window:OpenSearch()
end })
local sounds = Feedback:Section({ Name = "Sounds", Icon = "music", Side = "Right" })
sounds:Buttons({
	{ Name = "Click", Callback = function()
		UI:PlaySound("Click")
	end },
	{ Name = "Pop", Callback = function()
		UI:PlaySound("Pop")
	end },
	{ Name = "Success", Callback = function()
		UI:PlaySound("Success")
	end },
})
sounds:Label("Change the volume, the sound pack or turn sounds off in Settings.", { Icon = "volume-2" })

-- ---------------------------------------------------------------- Settings
load:Step("Loading your settings", 0.95)
Window:Category("Pepsi")
Window:BuildSettings()
Window:LoadAutoload()

-- Fake live numbers so the Live tab moves.
task.spawn(function()
	local coins, gems, kills, level, xp, quest = 0, 0, 0, 1, 0, 0
	while not UI.Unloaded do
		local earned = math.random(5, 40)
		coins += earned
		if math.random() < 0.3 then
			gems += 1
		end
		kills += math.random(0, 2)
		xp += math.random(2, 6)
		if xp >= 100 then
			xp -= 100
			level += 1
			console:Log("Level up! Now level " .. level, "Success")
		end
		quest = (quest + 1) % 31
		stats:Set("Coins", coins)
		stats:Set("Gems", gems)
		stats:Set("Kills", kills)
		stats:Set("Level", level)
		levelBar:Set(xp)
		questBar:Set(quest)
		graph:Push(earned)
		if math.random() < 0.25 then
			console:Log("Picked up " .. earned .. " coins", "Info")
		end
		task.wait(1)
	end
end)

UI:OnUnload(function()
	print("[Pepsi UI] demo unloaded")
end)

load:Done()
Window:SetOpen(true)
UI:Notify({
	Title = "Welcome to Pepsi UI",
	Content = Window.Mobile and "Tap the Pepsi Hub button to hide or show the menu. Hold any setting for more options." or "RightCtrl or the Pepsi Hub button hides the menu. Ctrl+K searches everything.",
	Type = "Success",
	Duration = 7,
})
end, function(e)
	return tostring(e) .. "\n" .. debug.traceback()
end)
if pepsiOk then
	print("[Pepsi UI] demo loaded")
else
	warn("[Pepsi UI] demo failed: " .. tostring(pepsiError))
	pepsiToast("Pepsi UI error", tostring(pepsiError):sub(1, 180))
end
