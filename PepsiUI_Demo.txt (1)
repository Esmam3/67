-- ======================================================================
-- Fading whole groups of objects (Roblox has no opacity for frames, so we remember
-- every transparency and tween them all).
-- ======================================================================
local function snapshot(root)
	local items = {}
	local function add(obj)
		if obj:IsA("UIStroke") then
			table.insert(items, { Obj = obj, Stroke = obj.Transparency })
		elseif obj:IsA("GuiObject") then
			local entry = { Obj = obj, Bg = obj.BackgroundTransparency }
			if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
				entry.Text = obj.TextTransparency
			end
			if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
				entry.Image = obj.ImageTransparency
			end
			if obj:IsA("ScrollingFrame") then
				entry.Bar = obj.ScrollBarImageTransparency
			end
			table.insert(items, entry)
		end
	end
	add(root)
	for _, d in ipairs(root:GetDescendants()) do
		add(d)
	end
	return items
end

local function fadeItems(items, out, time)
	for _, e in ipairs(items) do
		if e.Obj.Parent or e.Obj == items[1].Obj then
			local props = {}
			if e.Bg ~= nil then
				props.BackgroundTransparency = out and 1 or e.Bg
			end
			if e.Text ~= nil then
				props.TextTransparency = out and 1 or e.Text
			end
			if e.Image ~= nil then
				props.ImageTransparency = out and 1 or e.Image
			end
			if e.Bar ~= nil then
				props.ScrollBarImageTransparency = out and 1 or e.Bar
			end
			if e.Stroke ~= nil then
				props.Transparency = out and 1 or e.Stroke
			end
			if time and time > 0 then
				tween(e.Obj, props, time)
			else
				setProps(e.Obj, props)
			end
		end
	end
end

