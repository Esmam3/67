-- ======================================================================
local function timeAgo(t)
	local d = os.time() - (t or os.time())
	if d < 10 then
		return "now"
	elseif d < 60 then
		return d .. "s"
	elseif d < 3600 then
		return math.floor(d / 60) .. "m"
	end
	return math.floor(d / 3600) .. "h"
end

