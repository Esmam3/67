local function makeSnap(min, max, step)
	local decimals = decimalsOf(step)
	return function(v)
		v = math.clamp(tonumber(v) or min, min, max)
		v = min + math.floor((v - min) / step + 0.5) * step
		return math.clamp(round(v, decimals), min, max)
	end, decimals
end

local function formatter(opts, decimals)
	if type(opts.Format) == "function" then
		return function(v)
			local ok, s = pcall(opts.Format, v)
			return ok and tostring(s) or tostring(v)
		end
	end
	local prefix, suffix = tostring(opts.Prefix or ""), tostring(opts.Suffix or "")
	return function(v)
		local s
		if opts.Compact then
			s = abbreviate(v)
		elseif decimals > 0 then
			s = string.format("%." .. decimals .. "f", v)
		else
			s = tostring(math.floor(v + 0.5))
		end
		return prefix .. s .. suffix
	end
end

local function sliderTrack(e, h)
	local track = create("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -14),
		Size = UDim2.new(1, -24, 0, 6),
		BackgroundColor3 = "Field",
		ZIndex = 3,
		Parent = e.Frame,
	})
	corner(UDim.new(1, 0), track)
	stroke(track, 0.9)
	local fill = create("Frame", { Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = "AccentA", ZIndex = 4, Parent = track })
	corner(UDim.new(1, 0), fill)
	gradient(fill)
	return track, fill
end

local function sliderKnob(track)
	local knob = create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 6,
		Parent = track,
	})
	corner(UDim.new(1, 0), knob)
	local ks = stroke(knob, 0, 2, "AccentA")
	local bubble = create("TextLabel", {
		Name = "Bubble",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, -8),
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = "Section",
		Text = "",
		FontFace = "Mono",
		TextSize = 11,
		TextColor3 = "Text",
		Visible = false,
		ZIndex = 9,
		Parent = knob,
	})
	corner(6, bubble)
	stroke(bubble, 0.8)
	padding(bubble, 0, 7, 0, 7)
	local bubbleScale = create("UIScale", { Scale = 0, Parent = bubble })
	return knob, ks, bubble, bubbleScale
end

local function valueBox(e)
	local box = create("TextBox", {
		Name = "Value",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, e.Desc and 8 or (e.Window.RowHeight - 22) / 2),
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = "Field",
		FontFace = "Mono",
		TextSize = 12,
		TextColor3 = "Text",
		Text = "",
		ClearTextOnFocus = false,
		ZIndex = 7,
		Parent = e.Frame,
	})
	corner(7, box)
	local s = stroke(box, 0.9)
	padding(box, 0, 8, 0, 8)
	create("UISizeConstraint", { MinSize = Vector2.new(36, 22), Parent = box })
	box.Focused:Connect(function()
		tween(s, { Color = Theme.AccentA, Transparency = 0.3 }, 0.15)
	end)
	box.FocusLost:Connect(function()
		tween(s, { Color = Theme.Stroke, Transparency = 0.9 }, 0.15)
	end)
