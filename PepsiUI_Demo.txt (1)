local MONO_FAMILY = "rbxasset://fonts/families/RobotoMono.json"
local Weights = {
	Regular = Enum.FontWeight.Regular,
	Medium = Enum.FontWeight.Medium,
	SemiBold = Enum.FontWeight.SemiBold,
	Bold = Enum.FontWeight.Bold,
	Heavy = Enum.FontWeight.Heavy,
}

local function fontFace(weight)
	if weight == "Mono" then
		return Font.new(MONO_FAMILY, Enum.FontWeight.Medium)
	end
	local family = FontFamilies[Settings.Font] or FontFamilies["Builder Sans"]
	return Font.new(family, Weights[weight] or Enum.FontWeight.Medium)
end

local function setFont(object, weight)
	FontObjects[object] = weight
	object.FontFace = fontFace(weight)
end

-- ======================================================================
-- Tweening (respects the animation settings)
-- ======================================================================
local function setProps(object, props)
	for k, v in pairs(props) do
		local ok, err = pcall(function()
			object[k] = v
		end)
		if not ok and PEPSI_DEBUG then
			warn("[Pepsi UI] set " .. tostring(k) .. ": " .. tostring(err))
		end
	end
end

local function tween(object, props, time, style, direction, repeatCount, reverses)
	if object == nil then
		return
	end
	time = (time or 0.22) / math.max(0.1, Settings.AnimSpeed)
	if not Settings.Animations or time <= 0.001 then
		if repeatCount then
			return
		end
		setProps(object, props)
		return
	end
	local ok, t = pcall(function()
		return TweenService:Create(object, TweenInfo.new(time, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out, repeatCount or 0, reverses or false), props)
	end)
	if ok and t then
		t:Play()
		return t
	end
	if PEPSI_DEBUG then
		warn("[Pepsi UI] tween failed: " .. tostring(t))
	end
	setProps(object, props)
end
Library.Tween = tween

-- Paint: tween when smooth, set instantly otherwise.
local function paint(object, props, smooth, time)
	if smooth then
		tween(object, props, time or 0.25)
	else
		setProps(object, props)
	end
end

-- ======================================================================
-- Ticker: one RenderStepped loop that drives every per-frame effect.
-- ======================================================================
local Ticker = { Jobs = {}, Pending = {}, Running = false }
function Ticker.Add(fn)
	local id = {}
	if Ticker.Running then
		Ticker.Pending[id] = fn
	else
		Ticker.Jobs[id] = fn
	end
	if not Ticker.Connection then
		Ticker.Connection = connect(RunService.RenderStepped, function(dt)
			if Library.Unloaded then
				return
			end
			Ticker.Running = true
			for jobId, job in pairs(Ticker.Jobs) do
				local ok, finished = pcall(job, dt)
				if not ok then
					Ticker.Jobs[jobId] = nil
					warn("[Pepsi UI] effect stopped: " .. tostring(finished))
				elseif finished then
					Ticker.Jobs[jobId] = nil
				end
			end
			Ticker.Running = false
			for jobId, job in pairs(Ticker.Pending) do
				Ticker.Jobs[jobId] = job
			end
			table.clear(Ticker.Pending)
		end)
	end
	return id
end
function Ticker.Remove(id)
	if id then
		Ticker.Jobs[id] = nil
		Ticker.Pending[id] = nil
	end
end
Library.Ticker = Ticker

-- Smoothly moves a number towards a target: returns the new value.
local function approach(current, target, dt, speed)
	return current + (target - current) * (1 - math.exp(-dt * (speed or 14)))
end

-- Spring with a little overshoot, for things that should feel physical.
local Spring = {}
Spring.__index = Spring
function Spring.new(value, speed, damping)
	return setmetatable({ Value = value or 0, Target = value or 0, Velocity = 0, Speed = speed or 18, Damping = damping or 0.62 }, Spring)
end
function Spring:Step(dt)
	local steps = math.max(1, math.ceil(dt / (1 / 240)))
	local h = dt / steps
	local k = self.Speed * self.Speed
	local d = 2 * self.Damping * self.Speed
	for _ = 1, steps do
		local accel = k * (self.Target - self.Value) - d * self.Velocity
		self.Velocity += accel * h
		self.Value += self.Velocity * h
	end
	return self.Value
end
function Spring:Settled()
	return math.abs(self.Target - self.Value) < 0.001 and math.abs(self.Velocity) < 0.001
end
Library.Spring = Spring

