local function playerNames(includeSelf)
	local names = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if includeSelf or p ~= LocalPlayer then
			table.insert(names, p.Name)
		end
	end
	table.sort(names, function(a, b)
		return a:lower() < b:lower()
	end)
	return names
end

function Section:Dropdown(opts)
	opts = opts or {}
	local e = newElement(self, "Dropdown", opts)
	local mobile = self.Window.Mobile
	local base = e.TopHeight
	local rowH = mobile and 36 or 30
	local maxRows = opts.MaxVisible or (mobile and 5 or 6)
	e.Multi = opts.Multi == true or opts.MultiSelect == true
	e.Options = {}
	e.OptionData = {}
	local playersMode = opts.Players == true or opts.SpecialType == "Player"
	local function setOptions(source)
		e.Options = {}
		e.OptionData = {}
		for _, v in ipairs(source or {}) do
			if type(v) == "table" then
				local name = tostring(v.Name or v.Title or v.Value or v[1])
				table.insert(e.Options, name)
				e.OptionData[name] = v
			else
				table.insert(e.Options, tostring(v))
			end
		end
		if opts.Sort then
			table.sort(e.Options)
		end
	end
	setOptions(playersMode and playerNames(opts.IncludeSelf) or (opts.Options or opts.Values or opts.List))
	local function normalize(value)
		if e.Multi then
			local out = {}
			if type(value) == "table" then
				for k, v in pairs(value) do
					if v == true and type(k) ~= "number" then
						table.insert(out, tostring(k))
					elseif type(k) == "number" then
						table.insert(out, tostring(v))
					end
				end
			elseif value ~= nil then
				table.insert(out, tostring(value))
			end
			return out
		end
		if type(value) == "table" then
			value = value[1]
		end
		if type(value) == "number" and e.Options[value] and not table.find(e.Options, tostring(value)) then
			value = e.Options[value]
		end
		return value ~= nil and tostring(value) or nil
	end
	e.Value = normalize(opts.Default or opts.Value)

	local valueLabel = text({
		Parent = e.Frame,
		Name = "Value",
		Text = "",
		Color = "SubText",
		Size = 13,
		XAlign = Enum.TextXAlignment.Right,
		Anchor = Vector2.new(1, 0),
		Pos = UDim2.new(1, -36, 0, (base - 18) / 2),
		Sz = UDim2.new(0.5, -30, 0, 18),
		Truncate = true,
		Z = 4,
	})
	e.Title.Size = UDim2.new(0.5, -12, 0, 18)
	if e.Desc then
		e.Desc.Size = UDim2.new(0.5, -12, 0, 15)
	end
	local chevron = icon(e.Frame, "chevron-down", 16, "SubText", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0, base / 2), ZIndex = 4 })
	local head = hitbox(e.Frame, 5, UDim2.new(1, 0, 0, base))
	attachContext(head, function()
		return e:ContextItems()
	end)
	local panel = create("Frame", {
		Name = "Panel",
		Position = UDim2.fromOffset(8, base),
		Size = UDim2.new(1, -16, 0, 0),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = e.Frame,
	})
	local useSearch = opts.Search ~= false and (opts.Search == true or #e.Options > 6 or playersMode)
	local searchH = (useSearch or e.Multi) and 34 or 0
	local tools = create("Frame", { Name = "Tools", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), Visible = searchH > 0, ZIndex = 5, Parent = panel })
	local search = create("TextBox", {
		Name = "Search",
		Size = e.Multi and UDim2.new(1, -96, 1, 0) or UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = "Field",
		FontFace = "Medium",
		TextSize = 13,
		TextColor3 = "Text",
		PlaceholderText = "Search...",
		PlaceholderColor3 = "Dim",
		Text = "",
		ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		Visible = useSearch,
		ZIndex = 6,
		Parent = tools,
	})
	corner(8, search)
	padding(search, 0, 10, 0, 28)
	icon(search, "search", 13, "Dim", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, -19, 0.5, 0), ZIndex = 7 })
	if not useSearch and e.Multi then
		search.Size = UDim2.new(1, -96, 1, 0)
	end
	local function toolButton(label, x, fn)
		local b = create("TextButton", {
			AutoButtonColor = false,
			Text = label,
			FontFace = "SemiBold",
			TextSize = 12,
			TextColor3 = "SubText",
			BackgroundColor3 = "Field",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, x, 0, 0),
			Size = UDim2.fromOffset(44, 28),
			ZIndex = 6,
			Parent = tools,
		})
		corner(8, b)
		b.MouseEnter:Connect(function()
			tween(b, { TextColor3 = Theme.Text }, 0.12)
		end)
		b.MouseLeave:Connect(function()
			tween(b, { TextColor3 = Theme.SubText }, 0.12)
		end)
		b.Activated:Connect(function()
			sfx("Click")
			fn()
		end)
		return b
	end
	local optionList = create("ScrollingFrame", {
		Name = "List",
		Position = UDim2.fromOffset(0, searchH),
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = "AccentA",
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 5,
		Parent = panel,
	})
	list(optionList, 3)
	padding(optionList, 0, 4, 6, 0)
	local emptyLabel = text({ Parent = optionList, Text = "No options", Color = "Dim", Size = 12, Height = rowH, XAlign = Enum.TextXAlignment.Center, Order = 99999 })

	local function isSelected(v)
		if e.Multi then
			return table.find(e.Value, v) ~= nil
		end
		return e.Value == v
	end
	function e:IsSelected(v)
		return isSelected(tostring(v))
	end
	function e:GetActiveValues()
		if e.Multi then
			return table.clone(e.Value)
		end
		return e.Value and { e.Value } or {}
	end
	local function displayText()
		if e.Multi then
			if #e.Value == 0 then
				return opts.Placeholder or "None"
			elseif #e.Value <= 2 then
				return table.concat(e.Value, ", ")
			end
			return #e.Value .. " selected"
		end
		return e.Value or opts.Placeholder or "None"
	end
	function e:ValueText()
		if self.Multi then
			return table.concat(self.Value, ", ")
		end
		return tostring(self.Value or "None")
	end
	local buttons = {}
	local rows = {}
	local open = false
	local function visibleCount()
		local n = 0
		for _, b in pairs(buttons) do
			if b.Visible then
				n += 1
			end
		end
		return n
	end
	local function panelHeight()
		local shown = math.min(math.max(visibleCount(), 1), maxRows)
		return searchH + shown * (rowH + 3) + 8
	end
	local function resize(animate)
		local h = open and (base + panelHeight()) or base
		optionList.Size = UDim2.new(1, 0, 0, open and (panelHeight() - searchH) or 0)
		e:_resize(h, animate)
		tween(chevron, { Rotation = open and 180 or 0 }, 0.3, Enum.EasingStyle.Back)
		emptyLabel.Visible = visibleCount() == 0
	end
	local function paintOptions(smooth)
		valueLabel.Text = displayText()
		for v, b in pairs(buttons) do
			local on = isSelected(v)
			local info = rows[v]
			paint(b, { BackgroundTransparency = on and 0.15 or 1 }, smooth, 0.15)
			paint(info.Label, { TextColor3 = on and Theme.Text or Theme.SubText }, smooth, 0.15)
			if info.CheckScale then
				if smooth then
					tween(info.CheckScale, { Scale = on and 1 or 0 }, on and 0.3 or 0.12, on and Enum.EasingStyle.Back or Enum.EasingStyle.Quint)
				else
					info.CheckScale.Scale = on and 1 or 0
				end
			end
			if info.BoxFill then
				paint(info.BoxFill, { BackgroundTransparency = on and 0 or 1 }, smooth, 0.15)
			end
		end
	end
	painter(function()
		paintOptions(false)
	end)
	local function fire()
		local value = e.Multi and table.clone(e.Value) or e.Value
		e:_emit(value)
	end
	local function setOpen(state)
		if open == state then
			return
		end
		open = state
		if open then
			sfx("Pop")
			search.Text = ""
			-- Options slide in one after another.
			local i = 0
			for _, v in ipairs(e.Options) do
				local b = buttons[v]
				local info = rows[v]
				if b and info and b.Visible and i < 8 then
					i += 1
					info.Label.Position = UDim2.fromOffset(info.Pad - 8, 0)
					info.Label.TextTransparency = 1
					task.delay(i * 0.022, function()
						tween(info.Label, { Position = UDim2.fromOffset(info.Pad, 0), TextTransparency = 0 }, 0.25)
					end)
				end
			end
		else
			sfx("Click", 0.9, 0.6)
		end
		resize(true)
	end
	function e:Open()
		setOpen(true)
	end
	function e:Close()
		setOpen(false)
	end
	local function choose(v)
		if e.Multi then
			local i = table.find(e.Value, v)
			if i then
				table.remove(e.Value, i)
				sfx("ToggleOff", 1.1, 0.7)
			else
				table.insert(e.Value, v)
				sfx("ToggleOn", 1.1, 0.7)
			end
		else
			if e.Value == v then
				if opts.AllowNull then
					e.Value = nil
				end
			else
				e.Value = v
			end
			sfx("Click")
			task.delay(0.08, function()
				setOpen(false)
			end)
		end
		paintOptions(true)
		fire()
	end
	local function build()
		for _, b in pairs(buttons) do
			b:Destroy()
		end
		buttons = {}
		rows = {}
		for i, v in ipairs(e.Options) do
			local info = {}
			local data = e.OptionData[v]
			local b = create("TextButton", {
				Name = "Option",
				AutoButtonColor = false,
				Text = "",
				Size = UDim2.new(1, 0, 0, rowH),
				BackgroundColor3 = "ElementHover",
				BackgroundTransparency = 1,
				LayoutOrder = i,
				ZIndex = 6,
				Parent = optionList,
			})
			corner(7, b)
			local pad = 10
			if e.Multi then
				local box = create("Frame", { Name = "Box", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = "Field", ZIndex = 7, Parent = b })
				corner(5, box)
				stroke(box, 0.8)
				local boxFill = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 7, Parent = box })
				corner(5, boxFill)
				gradient(boxFill, 45)
				local tick = icon(boxFill, "check", 12, "OnAccent", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 8 })
				info.BoxFill = boxFill
				info.CheckScale = create("UIScale", { Scale = 0, Parent = tick })
				pad = 32
			end
			if data and data.Icon then
				local img, ok = icon(b, data.Icon, 15, "SubText", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, pad, 0.5, 0), ZIndex = 7 })
				if ok then
					pad += 22
				else
					img:Destroy()
				end
			end
			info.Pad = pad
			local label = text({ Parent = b, Name = "Label", Text = v, Size = 13, Color = "SubText", Pos = UDim2.fromOffset(pad, 0), Sz = UDim2.new(1, -pad - 30, 1, 0), Truncate = true, Z = 7 })
			if data and data.Description then
				label.Size = UDim2.new(1, -pad - 30, 0, rowH * 0.55)
				text({ Parent = b, Text = tostring(data.Description), Size = 11, Color = "Dim", Pos = UDim2.new(0, pad, 0.5, 0), Sz = UDim2.new(1, -pad - 30, 0, rowH * 0.45), Truncate = true, Z = 7 })
			end
			if not e.Multi then
				local check = icon(b, "check", 14, "AccentA", { Name = "Check", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), ZIndex = 7 })
				info.CheckScale = create("UIScale", { Scale = 0, Parent = check })
			end
			info.Label = label
			rows[v] = info
			b.MouseEnter:Connect(function()
				if not isSelected(v) then
					tween(b, { BackgroundTransparency = 0.55 }, 0.1)
				end
				tween(label, { TextColor3 = Theme.Text }, 0.1)
				sfx("Hover")
			end)
			b.MouseLeave:Connect(function()
				if not isSelected(v) then
					tween(b, { BackgroundTransparency = 1 }, 0.12)
					tween(label, { TextColor3 = Theme.SubText }, 0.12)
				end
			end)
			b.Activated:Connect(function()
				choose(v)
			end)
			buttons[v] = b
		end
		paintOptions(false)
	end
	if e.Multi then
		toolButton("All", -48, function()
			e.Value = {}
			for _, v in ipairs(e.Options) do
				local b = buttons[v]
				if b and b.Visible then
					table.insert(e.Value, v)
				end
			end
			paintOptions(true)
			fire()
		end)
		toolButton("None", 0, function()
			e.Value = {}
			paintOptions(true)
			fire()
		end)
	end
	head.Activated:Connect(function()
		if e.Locked or recentLongPress() then
			return
		end
		setOpen(not open)
	end)
	search:GetPropertyChangedSignal("Text"):Connect(function()
		local q = search.Text
		for v, b in pairs(buttons) do
			b.Visible = q == "" or fuzzyScore(q, v) > 0
		end
		if open then
			resize(false)
		end
	end)
	function e:Set(value, silent)
		self.Value = normalize(value)
		if not self.Multi and self.Value ~= nil and not table.find(self.Options, self.Value) and opts.Strict then
			self.Value = nil
		end
		paintOptions(true)
		if not silent then
			fire()
		elseif self.Flag then
			Library.Flags[self.Flag] = self.Value
		end
	end
	function e:Refresh(options, keep)
		setOptions(options)
		if not keep then
			if self.Multi then
				local kept = {}
				for _, v in ipairs(self.Value) do
					if table.find(self.Options, v) then
						table.insert(kept, v)
					end
				end
				self.Value = kept
			elseif self.Value and not table.find(self.Options, self.Value) then
				self.Value = nil
			end
		end
		build()
		resize(false)
	end
	e.SetValues = e.Refresh
	e.SetOptions = e.Refresh
	function e:Add(option)
		table.insert(self.Options, tostring(option))
		build()
		resize(false)
	end
	function e:Remove(option)
		local i = table.find(self.Options, tostring(option))
		if i then
			table.remove(self.Options, i)
			build()
			resize(false)
		end
	end
	if playersMode then
		local function refresh()
			task.defer(function()
				e:Refresh(playerNames(opts.IncludeSelf), true)
			end)
		end
		connect(Players.PlayerAdded, refresh)
		connect(Players.PlayerRemoving, refresh)
	end
	build()
	register(e, opts)
	paintOptions(false)
	return e
end
