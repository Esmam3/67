		Size = UDim2.fromOffset(0, 32),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = "Section",
		BackgroundTransparency = 0.06,
		Parent = self.ButtonGui,
	})
	corner(11, bar)
	stroke(bar, 0.86)
	padding(bar, 0, 14, 0, 12)
	list(bar, 9, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local dot = create("Frame", { Name = "Dot", Size = UDim2.fromOffset(8, 8), BackgroundColor3 = "AccentA", LayoutOrder = 0, Parent = bar })
	corner(UDim.new(1, 0), dot)
	gradient(dot)
	local order = 0
	local function seg(t, color, font)
		order += 1
		if order > 1 then
			create("Frame", { Name = "Sep", Size = UDim2.fromOffset(1, 14), BackgroundColor3 = "Stroke", BackgroundTransparency = 0.85, BorderSizePixel = 0, LayoutOrder = order * 2 - 1, Parent = bar })
		end
		local l = text({ Parent = bar, Text = t, Font = font or "SemiBold", Size = 13, Color = color or "Text", Auto = Enum.AutomaticSize.X, Sz = UDim2.fromOffset(0, 16), Order = order * 2 })
		return l
	end
	seg(self.Title, nil, "Bold")
	local gameLabel = seg(customText or (self.Subtitle ~= "" and self.Subtitle or "Roblox"), "SubText")
	local fps = seg("60 fps", "SubText", "Mono")
	local ping = seg("0 ms", "SubText", "Mono")
	local clock = seg(os.date("%H:%M"), "SubText", "Mono")
	dragWithPosition(bar, bar, function()
		self.State.Watermark = { bar.Position.X.Offset, bar.Position.Y.Offset }
		queueSave()
	end)
	local acc = 0
	Ticker.Add(function(dt)
		if not bar.Parent then
			return true
		end
		acc += dt
		if acc < 0.5 or not bar.Visible then
			return
		end
		acc = 0
		fps.Text = LiveStats.FPS .. " fps"
		ping.Text = LiveStats.Ping .. " ms"
		clock.Text = os.date("%H:%M")
		dot.BackgroundTransparency = dot.BackgroundTransparency == 0 and 0.35 or 0
	end)
	self.WatermarkFrame, self.WatermarkGame = bar, gameLabel
	self:_updateWatermark()
	return bar
end

function Window:SetWatermark(textValue)
	self:Watermark()
	self.WatermarkGame.Text = tostring(textValue)
end

-- ======================================================================
-- Keybind list (PC): your binds and whether they're on
-- ======================================================================
function Window:KeybindList(show)
	if not self.KeybindFrame then
		local saved = self.State.Keybinds
		local frame = create("Frame", {
			Name = "Keybinds",
			AnchorPoint = type(saved) == "table" and Vector2.zero or Vector2.new(1, 0),
			Position = type(saved) == "table" and UDim2.fromOffset(tonumber(saved[1]) or 16, tonumber(saved[2]) or 260) or UDim2.new(1, -16, 0.3, 0),
			Size = UDim2.fromOffset(220, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = "Section",
			BackgroundTransparency = 0.06,
			Visible = false,
			Parent = self.ButtonGui,
		})
		corner(12, frame)
		stroke(frame, 0.86)
		padding(frame, 10, 12, 10, 12)
		list(frame, 6)
		local head = create("Frame", { Name = "Head", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), Parent = frame })
		icon(head, "keyboard", 15, "AccentA", { Position = UDim2.fromOffset(0, 2) })
		text({ Parent = head, Text = "Keybinds", Font = "Bold", Size = 14, Pos = UDim2.fromOffset(22, 0), Sz = UDim2.new(1, -22, 1, 0) })
		local rows = create("Frame", { Name = "Rows", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = frame })
		list(rows, 4)
		local empty = text({ Parent = rows, Text = "No keybinds set", Size = 12, Color = "Dim", Height = 16, Order = 999 })
		dragWithPosition(frame, head, function()
			local size = frame.AbsoluteSize
			local a = frame.AnchorPoint
			self.State.Keybinds = { frame.Position.X.Offset - a.X * size.X, frame.Position.Y.Offset - a.Y * size.Y }
			frame.AnchorPoint = Vector2.zero
			frame.Position = UDim2.fromOffset(self.State.Keybinds[1], self.State.Keybinds[2])
			queueSave()
		end)
		local pool = {}
		local acc = 1
		Ticker.Add(function(dt)
			if not frame.Parent then
				return true
			end
			acc += dt
			if acc < 0.25 or not frame.Visible then
				return
			end
			acc = 0
			local shown = 0
			for _, kb in ipairs(Library.Keybinds) do
				if kb.Value and not kb.Destroyed and not kb.HideFromList then
					shown += 1
					local row = pool[shown]
					if not row then
						local frame = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 17), LayoutOrder = shown, Parent = rows })
						local dot = create("Frame", { Name = "Dot", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(6, 6), BackgroundColor3 = "Dim", Parent = frame })
						corner(UDim.new(1, 0), dot)
						local nameLabel = text({ Parent = frame, Name = "KeyName", Text = "", Size = 13, Pos = UDim2.fromOffset(13, 0), Sz = UDim2.new(1, -83, 1, 0), Truncate = true })
						local keyLabel = text({ Parent = frame, Name = "KeyValue", Text = "", Font = "Mono", Size = 11, XAlign = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0), Pos = UDim2.fromScale(1, 0), Sz = UDim2.new(0, 70, 1, 0) })
						row = { Frame = frame, Dot = dot, Name = nameLabel, Key = keyLabel }
						pool[shown] = row
					end
					row.Frame.Visible = true
					local on = kb.State == true or kb.Mode == "Always"
					row.Name.Text = kb.DisplayName or kb.Name or "Keybind"
					row.Name.TextColor3 = on and Theme.Text or Theme.SubText
					row.Key.Text = "[" .. keyName(kb.Value) .. "] " .. (kb.Mode == "Hold" and "hold" or kb.Mode == "Always" and "always" or "toggle")
					row.Key.TextColor3 = on and Theme.AccentA or Theme.Dim
					row.Dot.BackgroundColor3 = on and Theme.Success or Theme.Dim
				end
			end
			for i = shown + 1, #pool do
				pool[i].Frame.Visible = false
			end
			empty.Visible = shown == 0
		end)
		self.KeybindFrame = frame
	end
	self.KeybindFrame.Visible = show ~= false
	return self.KeybindFrame
end

-- ======================================================================
-- On-screen buttons (phones): run a feature without opening the menu
-- ======================================================================
function Window:AddMobileButton(opts)
	opts = opts or {}
	local key = tostring(opts.Key or opts.Flag or opts.Name or "Button")
	self.State.MobileButtons = type(self.State.MobileButtons) == "table" and self.State.MobileButtons or {}
	local saved = self.State.MobileButtons[key]
	self.MobileButtons = self.MobileButtons or {}
	local index = 0
	for _ in pairs(self.MobileButtons) do
		index += 1
	end
	local holder = create("TextButton", {
		Name = "MobileButton",
		AutoButtonColor = false,
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = type(saved) == "table" and UDim2.new(tonumber(saved[1]) or 0.85, 0, tonumber(saved[2]) or 0.3, 0) or UDim2.new(0.86, 0, 0.22 + (index % 6) * 0.1, 0),
		Size = UDim2.fromOffset(0, 42),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = "Section",
		BackgroundTransparency = 0.08,
		Parent = self.ButtonGui,
	})
	corner(UDim.new(1, 0), holder)
	local hStroke = stroke(holder, 0.8)
	padding(holder, 0, 16, 0, 12)
	list(holder, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	-- On: the pill turns into the accent gradient (white base x gradient). Off: plain card.
	local fillGradient = Instance.new("UIGradient")
	Gradients[fillGradient] = { "AccentA", "AccentB" }
	fillGradient.Color = accentSequence()
	fillGradient.Enabled = false
	fillGradient.Parent = holder
	local img = icon(holder, opts.Icon or "zap", 18, "Text", { LayoutOrder = 1 })
	local label = text({ Parent = holder, Text = tostring(opts.Name or "Button"), Font = "SemiBold", Size = 14, Auto = Enum.AutomaticSize.X, Sz = UDim2.fromOffset(0, 18), Order = 2 })
	local scale = create("UIScale", { Parent = holder })
	local handle = { Frame = holder, State = opts.Default == true, Key = key }
	local function render()
		local on = handle.State and opts.Toggle ~= false
		if on then
			fillGradient.Enabled = true
			tween(holder, { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0 }, 0.2)
		else
			tween(holder, { BackgroundColor3 = Theme.Section, BackgroundTransparency = 0.08 }, 0.2)
			task.delay(0.2, function()
				if not handle.State then
					fillGradient.Enabled = false
				end
			end)
		end
		tween(label, { TextColor3 = on and Theme.OnAccent or Theme.Text }, 0.2)
		tween(img, { ImageColor3 = on and Theme.OnAccent or Theme.Text }, 0.2)
		tween(hStroke, { Transparency = on and 1 or 0.8 }, 0.2)
	end
	unbind(holder, "BackgroundColor3")
	painter(function()
		if holder.Parent then
			render()
		end
	end)
	function handle.Set(stateValue, silent)
		handle.State = stateValue == true
		render()
		if not silent then
			task.spawn(safeCall, opts.Callback, handle.State)
		end
	end
	function handle.Destroy()
		holder:Destroy()
		self.MobileButtons[key] = nil
		self.State.MobileButtons[key] = nil
		queueSave()
	end
	dragWithPosition(holder, holder, function()
		local screen = self.ButtonGui.AbsoluteSize
		if screen.X > 10 then
			local p = holder.Position
			self.State.MobileButtons[key] = { (p.X.Scale * screen.X + p.X.Offset) / screen.X, (p.Y.Scale * screen.Y + p.Y.Offset) / screen.Y }
			queueSave()
		end
	end, function()
		tween(scale, { Scale = 0.9 }, 0.06)
		task.delay(0.07, function()
			tween(scale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
		end)
		sfx(opts.Toggle == false and "Click" or (handle.State and "ToggleOff" or "ToggleOn"))
		if opts.Toggle == false then
			task.spawn(safeCall, opts.Callback, true)
		else
			handle.Set(not handle.State)
		end
	end)
	attachContext(holder, function()
		return {
			{ Header = tostring(opts.Name or "Button"), Text = "Drag to move it. This button stays until you remove it." },
			{ Name = "Remove button", Icon = "trash-2", Danger = true, Callback = function()
				handle.Destroy()
				safeCall(opts.OnRemove)
			end },
		}
	end)
	render()
	if self.MobileButtons[key] then
		self.MobileButtons[key].Destroy()
	end
	self.MobileButtons[key] = handle
	return handle
end

-- ======================================================================
-- Modal layer: dialogs, search and the notification list share it
-- ======================================================================
function Window:OpenModal(kind, opts)
	opts = opts or {}
	if self.ModalKind then
		self:CloseModal(true)
	end
	Library:CloseContextMenu()
	Library:HideTooltip()
	self.ModalKind = kind
	self.ModalDismiss = opts.Dismiss ~= false
	self.ModalOnClose = opts.OnClose
	local modal = self.Modal
	modal.Visible = true
	if opts.Dim ~= false then
		tween(modal, { BackgroundTransparency = 0.42 }, 0.22)
	else
		modal.BackgroundTransparency = 1
	end
	local layer = create("Frame", { Name = kind, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 51, Parent = modal })
	self.ModalLayer = layer
	return layer
end

function Window:CloseModal(instant)
	if not self.ModalKind then
		return
	end
	local kind = self.ModalKind
	self.ModalKind = nil
	local layer = self.ModalLayer
	self.ModalLayer = nil
	local onClose = self.ModalOnClose
	self.ModalOnClose = nil
	if kind == "History" then
		self.HistoryOpen = false
	end
	if self.ModalInput then
		self.ModalInput:Disconnect()
		self.ModalInput = nil
	end
	if instant then
		if layer then
			layer:Destroy()
		end
	else
		tween(self.Modal, { BackgroundTransparency = 1 }, 0.18)
		if layer then
			fadeItems(snapshot(layer), true, 0.15)
			local card = layer:FindFirstChild("Card")
			local cardScale = card and card:FindFirstChildOfClass("UIScale")
			if cardScale then
				tween(cardScale, { Scale = 0.94 }, 0.15)
			end
			task.delay(0.17, function()
				layer:Destroy()
				if not self.ModalKind then
					self.Modal.Visible = false
				end
			end)
		end
	end
	safeCall(onClose)
end

-- Buttons used by dialogs: the label is a child so a gradient never tints the text.
local function dialogButton(parent, label, style, order, z)
	local button = create("TextButton", {
		AutoButtonColor = false,
		Text = "",
		Size = UDim2.fromOffset(0, 36),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = style == "Danger" and "Error" or "Element",
		LayoutOrder = order or 0,
		ZIndex = z or 54,
		Parent = parent,
	})
	corner(10, button)
	padding(button, 0, 18, 0, 18)
	create("UISizeConstraint", { MinSize = Vector2.new(84, 36), Parent = button })
	local textSlot = "Text"
	if style == "Primary" then
		gradient(button)
		textSlot = "OnAccent"
	elseif style == "Danger" then
		textSlot = nil
	else
		stroke(button, 0.88)
	end
	text({ Parent = button, Text = tostring(label), Font = "SemiBold", Size = 14, Color = textSlot or Color3.new(1, 1, 1), XAlign = Enum.TextXAlignment.Center, Auto = Enum.AutomaticSize.X, Sz = UDim2.fromOffset(0, 36), Z = (z or 54) + 1 })
	return button
end

function Window:Dialog(opts)
	opts = opts or {}
	local layer = self:OpenModal("Dialog", { Dismiss = opts.Dismissible ~= false, OnClose = opts.OnClose })
	local width = math.min(self.Mobile and 340 or 380, self.W - 40)
	local hasIcon = opts.Icon ~= false
	local textX = hasIcon and 72 or 22
	local content = opts.Content and tostring(opts.Content) or nil
	local contentH = content and (measure(content, 13, width - textX - 22).Y + 4) or 0
	local top = math.max(hasIcon and 60 or 0, 46 + contentH)
	local inputH = opts.Input and 46 or 0
	local height = top + inputH + 18 + 36 + 20
	local card = create("TextButton", {
		Name = "Card",
		AutoButtonColor = false,
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = "Section",
		ZIndex = 52,
		Parent = layer,
	})
	corner(16, card)
	stroke(card, 0.82)
	local cardScale = create("UIScale", { Scale = 0.9, Parent = card })
	if hasIcon then
		local slot = opts.IconColor or nil
		local tile = create("Frame", { Position = UDim2.fromOffset(20, 20), Size = UDim2.fromOffset(40, 40), BackgroundColor3 = slot or "AccentA", ZIndex = 53, Parent = card })
		corner(12, tile)
		if not slot then
			gradient(tile, 45)
		end
		icon(tile, opts.Icon or "info", 20, Color3.new(1, 1, 1), { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 54 })
	end
	text({ Parent = card, Text = tostring(opts.Title or "Are you sure?"), Font = "Bold", Size = 17, Pos = UDim2.fromOffset(textX, 20), Sz = UDim2.new(1, -textX - 20, 0, 22), Truncate = true, Z = 53 })
	if content then
		text({ Parent = card, Text = content, Color = "SubText", Size = 13, Wrap = true, Rich = true, YAlign = Enum.TextYAlignment.Top, Pos = UDim2.fromOffset(textX, 46), Sz = UDim2.new(1, -textX - 22, 0, contentH), Z = 53 })
	end
	local box
	if opts.Input then
		local input = type(opts.Input) == "table" and opts.Input or {}
		local field = create("Frame", { Position = UDim2.fromOffset(20, top + 10), Size = UDim2.new(1, -40, 0, 36), BackgroundColor3 = "Field", ZIndex = 53, Parent = card })
		corner(10, field)
		local fieldStroke = stroke(field, 0.86)
		box = create("TextBox", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(1, -24, 1, 0),
			FontFace = "Medium",
			TextSize = 14,
			TextColor3 = "Text",
			PlaceholderText = tostring(input.Placeholder or "Type here"),
			PlaceholderColor3 = "Dim",
			Text = tostring(input.Default or ""),
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			ZIndex = 54,
			Parent = field,
		})
		box.Focused:Connect(function()
			tween(fieldStroke, { Color = Theme.AccentA, Transparency = 0.3 }, 0.15)
		end)
		box.FocusLost:Connect(function()
			tween(fieldStroke, { Color = Theme.Stroke, Transparency = 0.86 }, 0.15)
		end)
	end
	local row = create("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -20),
		Size = UDim2.new(1, -40, 0, 36),
		ZIndex = 53,
		Parent = card,
	})
	list(row, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	local buttons = opts.Buttons or { { Name = "OK", Style = "Primary" } }
	local handle = {}
	local primaryButton
	for i, b in ipairs(buttons) do
		local button = dialogButton(row, b.Name or b.Title or "OK", b.Style, i, 54)
		local scale = create("UIScale", { Parent = button })
		button.MouseEnter:Connect(function()
			tween(scale, { Scale = 1.04 }, 0.15)
			sfx("Hover")
		end)
		button.MouseLeave:Connect(function()
			tween(scale, { Scale = 1 }, 0.15)
		end)
		local function run()
			sfx(b.Style == "Danger" and "Delete" or "Click")
			local value = box and box.Text or nil
			if b.Callback then
				local ok, result = pcall(b.Callback, value)
				if not ok then
					warn("[Pepsi UI] dialog callback error: " .. tostring(result))
				elseif result == false then
					shake(card)
					return
				end
			end
			if b.Close ~= false then
				self:CloseModal()
			end
		end
		button.Activated:Connect(run)
		if b.Style == "Primary" or b.Style == "Danger" or i == #buttons then
			primaryButton = run
		end
	end
	if box then
		box.FocusLost:Connect(function(enter)
			if enter and primaryButton then
				primaryButton()
			end
		end)
		if not self.Mobile then
			task.defer(function()
				pcall(function()
					box:CaptureFocus()
				end)
			end)
		end
	end
	tween(cardScale, { Scale = 1 }, 0.38, Enum.EasingStyle.Back)
	local items = snapshot(card)
	fadeItems(items, true)
	fadeItems(items, false, 0.2)
	sfx("Pop")
	handle.Close = function()
		self:CloseModal()
	end
	handle.Input = box
	handle.Card = card
	return handle
end

