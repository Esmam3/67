	local PlayerGui = t1.value1:WaitForChild("PlayerGui")
	
	local function fixTitle(gui)
		for _, v in ipairs(gui:GetDescendants()) do
			if v:IsA("TextLabel") and (v.Text == "Angeli" or v.Name == "Title") then
				v.Text = "Legacy Hub"
			end
		end
	end

	-- Check CoreGui and PlayerGui where Angeli UI mounts
	for _, parent in ipairs({CoreGui, PlayerGui}) do
		for _, child in ipairs(parent:GetChildren()) do
			fixTitle(child)
		end
		parent.ChildAdded:Connect(fixTitle)
	end
end)

