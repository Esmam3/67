local function StageComplete()
    tonumber(stageadd)
    while _G.Stage do
        local moneyText = game:GetService("Players").LocalPlayer.PlayerGui.HUD.Main.Money["01"].Number.Text
        local matches = {moneyText:match("(%d+)/(%d+)")}
        local current = matches[1]
        local required = matches[2]
        
        if current and required then
            if tonumber(current) >= tonumber(required) then
                break
            end
        end
        
        local targetStage = nil
        local worldFish = workspace["主场景"]["验证场景"].WorldFish
        
        for _, child in pairs(worldFish:GetChildren()) do
            if child:GetAttribute("StageId") == tonumber(stageadd) then
                local fishRoot = child:FindFirstChild("FishRoot")
                if fishRoot then
                    local prompt = fishRoot:FindFirstChild("PickupPrompt")
                end
                if fishRoot then
                    local price = child:GetAttribute("Price") or 0
                    if price > -1 then
                        targetStage = child
                    end
                end
            end
        end
        
        if targetStage then
            game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = targetStage.FishRoot.CFrame
            task.wait(0.2)
            fireproximityprompt(targetStage.FishRoot.PickupPrompt)
            task.wait(0.3)
        end
        
        pcall(function()
            local remote = game:GetService("ReplicatedStorage").Remote.Event.Level
            local goShow = remote:FindFirstChild("[C-S]GoShow")
            goShow:FireServer()
            task.wait(2)
        end)
    end
end

Stage = function()
    task.spawn(function()
        _G.Stage = true
        local currentStage = 1
        local targetStage = tonumber(stageadd)
        
        while _G.Stage and currentStage <= targetStage do
            pcall(function()
                local scene = workspace["主场景"]["验证场景"]
                
                for _, child in pairs(scene:GetChildren()) do
                    local stageNum = child.Name:match("(%d+)$")
                    if stageNum == tostring(currentStage) then
                        local water = child["水面"]
                        if water.CanCollide == true then
                            game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = water.CFrame * CFrame.new(0, 5, 0)
                        else
                            if currentStage < targetStage then
                                currentStage = currentStage + 1
                            else
                                StageComplete()
                                currentStage = 1
                            end
                            break
                        end
                    end
                end
            end)
            task.wait()
        end
    end)
end

