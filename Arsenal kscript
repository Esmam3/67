--- Triggerbot ---
Options.TriggerbotEnabled = false
Options.TriggerbotDelay = 0

local triggerbotConnection = nil
local isMouseDown = false
local lastShot = 0

local function isTriggerTarget(player)
    if not player or player == LocalPlayer then return false end
    return isTargetTeam(player)
end

local function updateTriggerbot()
    if not Options.TriggerbotEnabled or not isAlive then
        if isMouseDown then
            mouse1release()
            isMouseDown = false
        end
        return
    end

    local now = tick()
    local delaySeconds = Options.TriggerbotDelay / 1000
    if now - lastShot < delaySeconds then return end

    local character = LocalPlayer.Character
    if not character then return end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = {character, Camera}

    local centerPoint = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local ray = Camera:ScreenPointToRay(centerPoint.X, centerPoint.Y)
    local rayResult = Workspace:Raycast(ray.Origin, ray.Direction * 2000, rayParams)

    local shouldShoot = false
    if rayResult and rayResult.Instance then
        local model = rayResult.Instance:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChild("Humanoid") then
            local player = Players:GetPlayerFromCharacter(model)
            if player and isTriggerTarget(player) and not model:FindFirstChild("ForceField") then
                shouldShoot = true
            end
        end
    end

    if shouldShoot then
        if not isMouseDown then
            mouse1press()
            isMouseDown = true
            lastShot = now
        end
    elseif isMouseDown then
        mouse1release()
        isMouseDown = false
    end
end

