Options.ESPEnabled = false
Options.ESPBox = false
Options.ESPName = false
local drawingPool = {}

local function getOrCreateDrawing(player, type, class)
    if not drawingPool[player] then drawingPool[player] = {} end
    if not drawingPool[player][type] then
        local obj = Drawing.new(class)
        obj.Visible = false
        drawingPool[player][type] = obj
    end
    return drawingPool[player][type]
end

Players.PlayerRemoving:Connect(function(player)
    if drawingPool[player] then
        for _, obj in pairs(drawingPool[player]) do
            pcall(function() obj:Remove() end)
        end
        drawingPool[player] = nil
    end
end)

local function updateESP()
    if not Options.ESPEnabled then
        for _, types in pairs(drawingPool) do
            for _, obj in pairs(types) do obj.Visible = false end
        end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            local head = player.Character:FindFirstChild("Head")
            if root and head then
                local headPos, headOn = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local rootPos, rootOn = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                
                -- Box
                local box = getOrCreateDrawing(player, "Box", "Square")
                if Options.ESPBox and headOn and rootOn then
                    local height = math.abs(rootPos.Y - headPos.Y)
                    local width = height * 0.6
                    box.Size = Vector2.new(width, height)
                    box.Position = Vector2.new((headPos.X + rootPos.X)/2 - width/2, math.min(headPos.Y, rootPos.Y))
                    box.Thickness = 1.5
                    box.Color = Color3.fromRGB(255, 0, 0)
                    box.Visible = true
                else
                    box.Visible = false
                end

                -- Name
                local nameText = getOrCreateDrawing(player, "Name", "Text")
                if Options.ESPName and headOn then
                    nameText.Text = player.Name
                    nameText.Position = Vector2.new(headPos.X, headPos.Y - 15)
                    nameText.Color = Color3.fromRGB(255, 255, 255)
                    nameText.Size = 12
                    nameText.Center = true
                    nameText.Outline = true
                    nameText.Visible = true
                else
                    nameText.Visible = false
                end
            end
        end
    end
end

