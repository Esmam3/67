-- Load the Rain-Design Unnamed Library
local Library = loadstring(game:HttpGet('https://raw.githubusercontent.com/Rain-Design/Unnamed/main/Library.lua'))()
Library.Theme = "Dark"

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SPAWN_PLACE_ID = 138381251771774
local PORTAL_POS = Vector3.new(132, 60, 265)

local isSpawn = (game.PlaceId == SPAWN_PLACE_ID)
local autoFarmActive = false

-- Auto Upgrade Variables
local autoUpgrade = {
    Root = false,
    Buckets = false,
    Character = false,
    Diamonds = false,
    Survival = false,
    Treasure = false
}

-- --- DEFAULT DELAY CONFIGURATION ---
local delays = {
    BucketUsed = 0.15,
    BucketPoured = 0.15,
    TokensTake = 0.5
}

local function parseDelay(text, default)
    local num = tonumber(text)
    return num or default
end

-- Remotes
local PurchaseRemote = ReplicatedStorage:WaitForChild("VerdantRemotes"):WaitForChild("VDT_SkillTree.Purchase", 5)

-- --- UI SETUP ---
local Window = Library:Window({
   Text = isSpawn and "Verdant - Spawn Menu" or "Verdant - Farm Menu"
})

local Tab = Window:Tab({ Text = "Main" })

local FarmingSection = Tab:Section({
   Text = isSpawn and "Spawn Features" or "Farming Features",
   Side = "Left"  -- default, but explicit for clarity
})

if isSpawn then
    FarmingSection:Button({
       Text = "Start Game",
       Callback = function()
           local player = Players.LocalPlayer
           local character = player.Character or player.CharacterAdded:Wait()
           local rootPart = character:WaitForChild("HumanoidRootPart")
           rootPart.CFrame = CFrame.new(PORTAL_POS)
           task.wait(0.5)
           
           local PortalEvent = ReplicatedStorage.VerdantRemotes["VDT_Portal.CreateSetup"]
           PortalEvent:FireServer({ Difficulty = "Easy", MaxPlayers = 1 })
       end
    })
else
    FarmingSection:Toggle({ Text = "Auto Farm", Callback = function(b) autoFarmActive = b end })

    FarmingSection:Input({ Text = "Bucket Used Delay (Current: 0.15)", Callback = function(t) delays.BucketUsed = parseDelay(t, 0.15) end })
    FarmingSection:Input({ Text = "Bucket Poured Delay (Current: 0.15)", Callback = function(t) delays.BucketPoured = parseDelay(t, 0.15) end })
    FarmingSection:Input({ Text = "Cycle End Delay (Current: 0.5)", Callback = function(t) delays.TokensTake = parseDelay(t, 0.5) end })

    -- Auto Skill Tree Upgrades on the RIGHT side
    local UpgradeSection = Tab:Section({ 
        Text = "Auto Skill Tree Upgrades",
        Side = "Right"   -- <-- This puts it next to Farming Features
    })

    UpgradeSection:Toggle({ Text = "Auto Upgrade Root", Callback = function(b) autoUpgrade.Root = b end })
    UpgradeSection:Toggle({ Text = "Auto Upgrade Buckets", Callback = function(b) autoUpgrade.Buckets = b end })
    UpgradeSection:Toggle({ Text = "Auto Upgrade Character", Callback = function(b) autoUpgrade.Character = b end })
    UpgradeSection:Toggle({ Text = "Auto Upgrade Diamonds", Callback = function(b) autoUpgrade.Diamonds = b end })
    UpgradeSection:Toggle({ Text = "Auto Upgrade Survival", Callback = function(b) autoUpgrade.Survival = b end })
    UpgradeSection:Toggle({ Text = "Auto Upgrade Treasure", Callback = function(b) autoUpgrade.Treasure = b end })

    -- Non-Stop Sequential Auto Upgrade (unchanged)
    task.spawn(function()
        while true do
            if not isSpawn then
                for category, enabled in pairs(autoUpgrade) do
                    if enabled then
                        local catLower = string.lower(category)
                        local nodes = {
                            root = {{0,0},{1,-1},{1,-2},{0,-2},{1,-3},{0,-3},{-1,-1},{-1,-2},{2,-3},{2,-4},{-1,1},{-2,1},{-2,2},{-3,1},{-3,2},{-2,3},{-3,3},{-4,2},{-4,3}},
                            buckets = {{1,0},{2,0},{2,-1},{1,-1},{2,-2},{3,-1},{3,-2},{3,0},{4,-1},{3,-3},{4,-2},{0,1},{-1,1},{0,2},{-1,2},{1,1},{0,3},{-1,3},{1,2},{1,3},{0,-1},{-1,0}},
                            character = {{-1,0},{-2,1},{-2,0},{-1,1},{-2,2},{-1,-1},{-3,2},{1,-1},{0,-1},{2,-2},{2,-1},{1,-2},{0,-2},{1,0},{0,1},{2,0},{1,1},{0,2},{-1,2},{1,2},{2,2},{1,3}},
                            diamonds = {{0,-1},{0,-2},{-1,-2},{1,-3},{-1,-3},{1,-4},{1,-5}},
                            survival = {{0,-1},{0,-2},{1,-3}},
                            treasure = {{0,-1},{0,-2},{-1,-2},{1,-1},{2,-2},{3,-3}}
                        }

                        for _, coord in ipairs(nodes[catLower] or {}) do
                            local q, r = coord[1], coord[2]

                            local success, result = pcall(function()
                                return PurchaseRemote:InvokeServer(catLower, q, r)
                            end)

                            if success and result and result.ok == true then
                                print(`✅ Bought {catLower} {q},{r}`)
                            end

                            task.wait(0.08)
                        end
                    end
                end
            end
            task.wait(1)
        end
    end)

    -- Farming Loop (unchanged)
    task.spawn(function()
        while true do
            if autoFarmActive then
                local BucketUsed = ReplicatedStorage.VerdantRemotes["VDT_Bucket.Used"]
                BucketUsed:FireServer(workspace.Water.Top)
                task.wait(delays.BucketUsed)
                
                local BucketPoured = ReplicatedStorage.VerdantRemotes["VDT_Bucket.Poured"]
                BucketPoured:FireServer(workspace.Scripted.CheckpointParts["1"].Drain.Scripted.ProximityPosition.ProximityPrompt)
                task.wait(delays.BucketPoured)
                
                local TokensTake = ReplicatedStorage.VerdantRemotes["VDT_Tokens.Take"]
                TokensTake:FireServer(workspace.Scripted.CheckpointParts["1"].Drain.Scripted.ProximityPosition.ProximityPrompt)
                task.wait(delays.TokensTake)
            else
                task.wait(0.5)
            end
        end
    end)
end

Tab:Select()
