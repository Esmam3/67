-- Load the Rain-Design Unnamed Library
local Library = loadstring(game:HttpGet('https://raw.githubusercontent.com/Rain-Design/Unnamed/main/Library.lua'))()
Library.Theme = "Dark"

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SPAWN_PLACE_ID = 138381251771774
local PORTAL_POS = Vector3.new(132, 60, 265)

local isSpawn = (game.PlaceId == SPAWN_PLACE_ID)
local autoFarmActive = false

-- --- DEFAULT DELAY CONFIGURATION ---
local delays = {
    BucketUsed = 0.15,
    BucketPoured = 0.15,
    TokensTake = 0.5
}

-- Helper function to safely turn text input into a number
local function parseDelay(text, default)
    local num = tonumber(text)
    return num or default
end

-- --- UI SETUP VIA LIBRARY ---
local Window = Library:Window({
   Text = isSpawn and "Verdant - Spawn Menu" or "Verdant - Farm Menu"
})

local Tab = Window:Tab({
   Text = "Main"
})

local Section = Tab:Section({
   Text = isSpawn and "Spawn Features" or "Farming Features"
})

if isSpawn then
    -- Spawn Place: Clickable button to teleport and create portal
    Section:Button({
       Text = "Start Game",
       Callback = function()
           local player = Players.LocalPlayer
           local character = player.Character or player.CharacterAdded:Wait()
           local rootPart = character:WaitForChild("HumanoidRootPart")
           
           rootPart.CFrame = CFrame.new(PORTAL_POS)
           task.wait(0.5)
           
           local PortalEvent = ReplicatedStorage.VerdantRemotes["VDT_Portal.CreateSetup"]
           PortalEvent:FireServer({
               Difficulty = "Easy",
               MaxPlayers = 1
           })
       end
    })
else
    -- Any Other Place: Toggle for the optimized fast item loop
    Section:Toggle({
       Text = "Auto Farm",
       Callback = function(bool)
           autoFarmActive = bool
       end
    })

    -- Text Boxes for easy mobile typing instead of sliders
    Section:Input({
       Text = "Bucket Used Delay (Current: 0.15)",
       Callback = function(txt)
           delays.BucketUsed = parseDelay(txt, 0.15)
       end
    })

    Section:Input({
       Text = "Bucket Poured Delay (Current: 0.15)",
       Callback = function(txt)
           delays.BucketPoured = parseDelay(txt, 0.15)
       end
    })

    Section:Input({
       Text = "Cycle End Delay (Current: 0.5)",
       Callback = function(txt)
           delays.TokensTake = parseDelay(txt, 0.5)
       end
    })
    
    -- Automatic Cutscene Auto-Skip (No toggle, runs natively in background)
    task.spawn(function()
        local CutsceneEvent = ReplicatedStorage:WaitForChild("VerdantRemotes"):WaitForChild("VDT_CutsceneVoteSkip")
        while true do
            CutsceneEvent:FireServer("711dcd8c-d084-47b0-81de-3b27a701d892")
            task.wait(1.0)
        end
    end)
    
    -- Optimized background farming thread using dynamic text box values
    task.spawn(function()
        while true do
            if autoFarmActive then
                -- Fire Bucket Used
                local BucketUsed = ReplicatedStorage.VerdantRemotes["VDT_Bucket.Used"]
                BucketUsed:FireServer(workspace.Water.Top)
                task.wait(delays.BucketUsed)
                
                -- Fire Bucket Poured
                local BucketPoured = ReplicatedStorage.VerdantRemotes["VDT_Bucket.Poured"]
                BucketPoured:FireServer(workspace.Scripted.CheckpointParts["1"].Drain.Scripted.ProximityPosition.ProximityPrompt)
                task.wait(delays.BucketPoured)
                
                -- Fire Tokens Take
                local TokensTake = ReplicatedStorage.VerdantRemotes["VDT_Tokens.Take"]
                TokensTake:FireServer(workspace.Scripted.CheckpointParts["1"].Drain.Scripted.ProximityPosition.ProximityPrompt)
                task.wait(delays.TokensTake)
            else
                task.wait(0.5)
            end
        end
    end)
end

Tab:Select()
