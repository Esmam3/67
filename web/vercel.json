{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/gen-lua-sources.mjs && vite build --base=/",
  "outputDirectory": "dist",
  "functions": {
    "api/obfuscate.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
